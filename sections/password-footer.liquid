

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div
  class="password-footer color-custom-{{ section.id }}"
  data-testid="password-footer"
>
  <nav class="pwd-fnav" aria-label="Footer">
    <ul>
      <li class="pwd-fnav__mailing">
        <button
          type="button"
          class="pwd-fnav__toggle"
          aria-expanded="false"
          aria-controls="pwd-mailing-drop"
        >
          Mailing
        </button>
        <div id="pwd-mailing-drop" class="pwd-fnav__drop" hidden>
          {%- form 'customer', class: 'pwd-fnav__form' -%}
            {%- if form.posted_successfully? -%}
              <p class="pwd-fnav__msg">You're on the list.</p>
            {%- else -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input
                type="email"
                name="contact[email]"
                class="pwd-fnav__email"
                placeholder="EMAIL"
                autocomplete="email"
                aria-label="Email"
                required
              >
              <button type="submit" class="pwd-fnav__submit">Join</button>
            {%- endif -%}
          {%- endform -%}
        </div>
        {%- if form.errors -%}
          <p class="pwd-fnav__msg pwd-fnav__msg--err">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      </li>
    </ul>
  </nav>
</div>

<script>
  (function () {
    var t = document.querySelector('.pwd-fnav__toggle');
    if (!t || t.__pwdWired) return;
    t.__pwdWired = true;
    var d = document.getElementById('pwd-mailing-drop');

    function set(open) {
      t.setAttribute('aria-expanded', String(open));
      if (d) d.hidden = !open;
    }

    t.addEventListener('click', function () {
      set(t.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('.pwd-fnav__mailing')) set(false);
    });

    if (location.search.indexOf('customer_posted') > -1 || document.querySelector('.pwd-fnav__msg')) {
      set(true);
    }
  })();
</script>

{% stylesheet %}
  .pwd-fnav ul {
    list-style: none;
    margin: 0 0 var(--gap-sm, 12px) 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-2xl, 24px);
  }

  .pwd-fnav a,
  .pwd-fnav .pwd-fnav__toggle {
    display: inline-block;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-accent--family, inherit);
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.72));
    text-decoration: none;
  }

  .pwd-fnav a:hover,
  .pwd-fnav .pwd-fnav__toggle:hover {
    color: var(--color-foreground);
  }

  .pwd-fnav__mailing {
    position: relative;
  }

  /* opens upward, not downward: this toggle lives in the page footer,
     pinned to the very bottom of the viewport with no scroll room below
     it, so a downward drop was running off the bottom edge of the
     screen. */
  .pwd-fnav__drop {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: calc(100% + 5px);
    z-index: 20;
    display: flex;
    align-items: stretch;
    width: max-content;
    height: 22px;
    background: var(--color-background);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.28);
  }

  /* after a submit, the only thing left inside is .pwd-fnav__msg -- which is
     itself position:absolute (so it can render as its own bordered box a
     little further down), so it no longer contributes to this row's
     width/height. Left alone, the row still draws its own fixed 22px-tall
     border around nothing, which collapses to a thin stray vertical line
     hanging between "MAILING" and the message box below it. Drop this
     row's own box entirely once it's just holding the message. */
  .pwd-fnav__drop:has(.pwd-fnav__msg) {
    height: auto;
    border: 0;
    background: none;
  }

  .pwd-fnav__drop[hidden] {
    display: none !important;
  }

  /* the {% form %} tag always wraps its contents in a real <form> element --
     that form, not the input/button themselves, is .pwd-fnav__drop's actual
     flex child. Left as a plain block, the input and button inside it just
     sit as ordinary inline-block boxes, vertically aligned to their own
     text baseline instead of stretched -- which left a gap of empty
     background above the button (its baseline sits lower than the input's,
     so the box above it doesn't reach the container's top edge). Making
     the form itself the flex row fixes both children the same way. */
  .pwd-fnav__form {
    display: flex;
    align-items: stretch;
    height: 100%;
  }

  .pwd-fnav__email {
    flex: 0 0 auto;
    width: 104px;
    min-width: 0;
    height: 100%;
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-accent--family, inherit);
    font-size: 0.56rem;
    letter-spacing: 0.04em;
    padding: 0 6px;
  }

  .pwd-fnav__email::placeholder {
    color: rgb(var(--color-foreground-rgb) / 0.45);
  }

  .pwd-fnav__email:focus {
    outline: 0;
  }

  .pwd-fnav__submit {
    flex: 0 0 auto;
    height: 100%;
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    border-radius: 0;
    background: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-accent--family, inherit);
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0 7px;
    margin: 0;
    cursor: pointer;
  }

  .pwd-fnav__submit:hover {
    opacity: 0.85;
  }

  .pwd-fnav__msg {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: calc(100% + 5px);
    width: 190px;
    margin: 0;
    padding: 5px 7px;
    background: var(--color-background);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.28);
    font-family: var(--font-accent--family, inherit);
    font-size: 0.52rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.72));
    text-align: center;
  }

  .pwd-fnav__msg--err {
    color: #c0392b;
  }

  .password-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-sm);
    padding-block: var(--padding-xl);
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer_password",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    }
  ]
}
{% endschema %}
