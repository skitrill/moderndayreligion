{%- doc -%}
  THE MODERN TIMES -- MODARE's publication. One issue per page: a masthead
  (publisher / title / tagline / volume strip) over an editorial grid that
  every block places itself on.

  Grid: 12 columns on desktop (4 editorial columns of 3), 6 on tablet, 2 on
  phones. Each block picks its desktop width (Span); tablet width follows
  from it, and phones choose full or half width. Blocks flow in order, so a
  composition is just block order + widths: a two-thirds lead story spanning
  two rows next to two one-third blocks, a full-width manifesto, a five/seven
  split, and so on.

  Rules: every block can own a rule above it and/or a column rule on its
  left; each line belongs to exactly one block, so rows never double up.
  On phones a column rule turns into the row's top rule unless the block
  sits beside another half-width block.

  Block types (reusable for every future volume): Story (lead / feature /
  standard / brief), Photograph (standard, small archival, or a full-bleed
  interruption between grid sections), Two-image spread (heights matched,
  original ratios kept), Quote (inset pull quote or full manifesto), Note
  (side note or numbered index), Section divider, Colophon.

  Photography: a picked image always wins; with none picked, a block can
  show one of the five placeholder photos in assets/ (see
  snippets/mdr-mt-image.liquid). Original aspect ratios by default.
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign fb_ratios = '1.2005|0.7493|1.2005|1.4993|1.4006' | split: '|'
-%}

{%- comment -%} A literal newline, for `| split: newline` (no built-in newline global). {%- endcomment -%}
{%- capture newline %}
{% endcapture -%}


<section id="mdr-mt-{{ section.id }}" class="mdr-mtimes mdr-mt">
  <div class="mdr-mt-masthead">
    <div class="mdr-mt-masthead__top">
      {%- if s.publisher != blank -%}
        <p class="mdr-mt-masthead__publisher">{{ s.publisher }}</p>
      {%- endif -%}
      {%- if s.edition != blank -%}
        <p class="mdr-mt-masthead__edition">{{ s.edition }}</p>
      {%- endif -%}
    </div>
    {%- if s.title != blank -%}
      <h1 class="mdr-mt-masthead__title">{{ s.title }}</h1>
    {%- endif -%}
    {%- if s.tagline != blank -%}
      <p class="mdr-mt-masthead__tagline">{{ s.tagline }}</p>
    {%- endif -%}
    {%- if s.volume != blank or s.year != blank -%}
      <div class="mdr-mt-masthead__meta">
        {%- if s.volume != blank -%}<span>{{ s.volume }}</span>{%- endif -%}
        {%- if s.publisher != blank -%}<span>{{ s.publisher }}</span>{%- endif -%}
        {%- if s.year != blank -%}<span>{{ s.year }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="mdr-mt-grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign d = b.span | default: '12' | plus: 0
        case d
          when 12
            assign t = 6
          when 9, 8
            assign t = 4
          when 7, 6, 5
            assign t = 3
          else
            assign t = 2
        endcase
        assign r = b.rows | default: '1' | plus: 0
        assign m_half = false
        if b.mobile == 'half'
          assign m_half = true
        endif

        assign cls = 'mdr-mt-item mdr-mt-' | append: block.type
        if m_half
          assign cls = cls | append: ' mdr-mt-item--m-half'
        endif
        if block.type == 'story' or block.type == 'note' or block.type == 'quote'
          assign cls = cls | append: ' mdr-mt-item--text'
        endif
        if b.rule_top or block.type == 'divider'
          assign cls = cls | append: ' mdr-mt-rule-t'
        endif
        if b.rule_left
          assign cls = cls | append: ' mdr-mt-rule-l'
        endif

        assign px = d | times: 104
        assign tvw = t | times: 100 | divided_by: 6
        assign mvw = '100vw'
        if m_half
          assign mvw = '50vw'
        endif
        assign sizes = '(min-width: 990px) ' | append: px | append: 'px, (min-width: 600px) ' | append: tvw | append: 'vw, ' | append: mvw

        assign eager = false
        if forloop.index <= 2
          assign eager = true
        endif
        assign item_style = '--d: ' | append: d | append: '; --t: ' | append: t | append: '; --r: ' | append: r | append: ';'
      -%}

      {%- case block.type -%}
        {%- when 'story' -%}
          {%- capture story_img -%}
            {%- render 'mdr-mt-image',
              image: b.image,
              fallback: b.fallback,
              ratio: b.ratio,
              sizes: sizes,
              eager: eager,
              alt: b.caption
            -%}
          {%- endcapture -%}
          {%- capture story_fig -%}
            {%- if story_img != blank -%}
              <figure class="mdr-mt-fig">
                {{ story_img }}
                {%- if b.caption != blank or b.credit != blank -%}
                  <figcaption class="mdr-mt-cap">
                    {%- if b.caption != blank -%}<span class="mdr-mt-cap__text">{{ b.caption }}</span>{%- endif -%}
                    {%- if b.credit != blank -%}<span class="mdr-mt-cap__credit">{{ b.credit }}</span>{%- endif -%}
                  </figcaption>
                {%- endif -%}
              </figure>
            {%- endif -%}
          {%- endcapture -%}
          {%- liquid
            assign hed_tag = 'h3'
            if b.size == 'lead'
              assign hed_tag = 'h2'
            endif
            assign body_cls = 'mdr-mt-body mdr-mt-body--cols-' | append: b.columns
            if b.mobile_two_columns
              assign body_cls = body_cls | append: ' mdr-mt-body--m2'
            endif
          -%}
          <article class="{{ cls }} mdr-mt-story--{{ b.size }}" style="{{ item_style }}" {{ block.shopify_attributes }}>
            {%- if b.image_position == 'above' -%}{{ story_fig }}{%- endif -%}
            {%- if b.kicker != blank -%}<p class="mdr-mt-kicker">{{ b.kicker }}</p>{%- endif -%}
            {%- if b.headline != blank -%}
              <{{ hed_tag }} class="mdr-mt-hed mdr-mt-hed--{{ b.size }}">{{ b.headline }}</{{ hed_tag }}>
            {%- endif -%}
            {%- if b.deck != blank -%}<p class="mdr-mt-deck">{{ b.deck }}</p>{%- endif -%}
            {%- if b.byline != blank -%}<p class="mdr-mt-byline">{{ b.byline }}</p>{%- endif -%}
            {%- if b.image_position != 'above' -%}{{ story_fig }}{%- endif -%}
            {%- if b.body != blank -%}
              {%- assign paras = b.body | split: newline -%}
              <div class="{{ body_cls }}">
                {%- for line in paras -%}
                  {%- assign trimmed = line | strip -%}
                  {%- if trimmed != blank -%}<p>{{ trimmed }}</p>{%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </article>

        {%- when 'figure' -%}
          {%- if b.treatment == 'bleed' -%}
            {%- capture bleed_img -%}
              {%- render 'mdr-mt-image',
                image: b.image,
                fallback: b.fallback,
                ratio: b.ratio,
                sizes: '100vw',
                eager: eager,
                alt: b.caption
              -%}
            {%- endcapture -%}
            </div>
            <figure class="mdr-mt-bleed" {{ block.shopify_attributes }}>
              {{ bleed_img }}
              {%- if b.caption != blank or b.credit != blank -%}
                <figcaption class="mdr-mt-cap">
                  {%- if b.caption != blank -%}<span class="mdr-mt-cap__text">{{ b.caption }}</span>{%- endif -%}
                  {%- if b.credit != blank -%}<span class="mdr-mt-cap__credit">{{ b.credit }}</span>{%- endif -%}
                </figcaption>
              {%- endif -%}
            </figure>
            <div class="mdr-mt-grid">
          {%- else -%}
            <figure class="{{ cls }} mdr-mt-figure--{{ b.treatment }}" style="{{ item_style }}" {{ block.shopify_attributes }}>
              <div class="mdr-mt-fig">
                {%- render 'mdr-mt-image',
                  image: b.image,
                  fallback: b.fallback,
                  ratio: b.ratio,
                  sizes: sizes,
                  eager: eager,
                  alt: b.caption
                -%}
                {%- if b.caption != blank or b.credit != blank -%}
                  <figcaption class="mdr-mt-cap">
                    {%- if b.caption != blank -%}<span class="mdr-mt-cap__text">{{ b.caption }}</span>{%- endif -%}
                    {%- if b.credit != blank -%}<span class="mdr-mt-cap__credit">{{ b.credit }}</span>{%- endif -%}
                  </figcaption>
                {%- endif -%}
              </div>
            </figure>
          {%- endif -%}

        {%- when 'spread' -%}
          {%- liquid
            assign ar_a = 1
            if b.image_a != blank
              assign ar_a = b.image_a.aspect_ratio
            elsif b.fallback_a != 'none'
              assign ia = b.fallback_a | plus: 0 | minus: 1
              assign ar_a = fb_ratios[ia]
            endif
            assign ar_b = 1
            if b.image_b != blank
              assign ar_b = b.image_b.aspect_ratio
            elsif b.fallback_b != 'none'
              assign ib = b.fallback_b | plus: 0 | minus: 1
              assign ar_b = fb_ratios[ib]
            endif
            assign half_px = px | divided_by: 2
            assign half_tvw = tvw | divided_by: 2
            assign spread_sizes = '(min-width: 990px) ' | append: half_px | append: 'px, (min-width: 600px) ' | append: half_tvw | append: 'vw, 50vw'
          -%}
          <figure class="{{ cls }}" style="{{ item_style }}" {{ block.shopify_attributes }}>
            <div class="mdr-mt-spread__pair">
              <div style="--ar: {{ ar_a }};">
                {%- render 'mdr-mt-image', image: b.image_a, fallback: b.fallback_a, sizes: spread_sizes, eager: eager, alt: b.caption -%}
              </div>
              <div style="--ar: {{ ar_b }};">
                {%- render 'mdr-mt-image', image: b.image_b, fallback: b.fallback_b, sizes: spread_sizes, eager: eager, alt: b.caption -%}
              </div>
            </div>
            {%- if b.caption != blank or b.credit != blank -%}
              <figcaption class="mdr-mt-cap">
                {%- if b.caption != blank -%}<span class="mdr-mt-cap__text">{{ b.caption }}</span>{%- endif -%}
                {%- if b.credit != blank -%}<span class="mdr-mt-cap__credit">{{ b.credit }}</span>{%- endif -%}
              </figcaption>
            {%- endif -%}
          </figure>

        {%- when 'quote' -%}
          {%- assign quote_lines = b.lines | split: newline -%}
          {%- if b.style == 'manifesto' -%}
            <section class="{{ cls }} mdr-mt-manifesto" style="{{ item_style }}" {{ block.shopify_attributes }}>
              <div class="mdr-mt-manifesto__inner">
                {%- if b.label != blank -%}<p class="mdr-mt-manifesto__label">{{ b.label }}</p>{%- endif -%}
                <p class="mdr-mt-manifesto__statement">{{ b.statement }}</p>
                {%- if b.lines != blank -%}
                  <ol class="mdr-mt-manifesto__lines">
                    {%- for line in quote_lines -%}
                      {%- assign trimmed = line | strip -%}
                      {%- if trimmed != blank -%}<li>{{ trimmed }}</li>{%- endif -%}
                    {%- endfor -%}
                  </ol>
                {%- endif -%}
                {%- if b.attribution != blank -%}<p class="mdr-mt-manifesto__sign">{{ b.attribution }}</p>{%- endif -%}
              </div>
            </section>
          {%- else -%}
            <figure class="{{ cls }} mdr-mt-quote--inset" style="{{ item_style }}" {{ block.shopify_attributes }}>
              {%- if b.label != blank -%}<p class="mdr-mt-kicker">{{ b.label }}</p>{%- endif -%}
              <blockquote class="mdr-mt-quote__block">
                <p class="mdr-mt-quote__text">{{ b.statement }}</p>
                {%- for line in quote_lines -%}
                  {%- assign trimmed = line | strip -%}
                  {%- if trimmed != blank -%}<p class="mdr-mt-quote__line">{{ trimmed }}</p>{%- endif -%}
                {%- endfor -%}
              </blockquote>
              {%- if b.attribution != blank -%}<figcaption class="mdr-mt-quote__by">{{ b.attribution }}</figcaption>{%- endif -%}
            </figure>
          {%- endif -%}

        {%- when 'note' -%}
          {%- assign note_lines = b.content | split: newline -%}
          <aside class="{{ cls }} mdr-mt-note--{{ b.style }}" style="{{ item_style }}" {{ block.shopify_attributes }}>
            {%- if b.label != blank -%}<p class="mdr-mt-kicker">{{ b.label }}</p>{%- endif -%}
            {%- if b.style == 'index' -%}
              <ol class="mdr-mt-index">
                {%- for line in note_lines -%}
                  {%- assign trimmed = line | strip -%}
                  {%- if trimmed != blank -%}<li>{{ trimmed }}</li>{%- endif -%}
                {%- endfor -%}
              </ol>
            {%- else -%}
              <div class="mdr-mt-note__body">
                {%- for line in note_lines -%}
                  {%- assign trimmed = line | strip -%}
                  {%- if trimmed != blank -%}<p>{{ trimmed }}</p>{%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </aside>

        {%- when 'divider' -%}
          <div class="{{ cls }}" style="--d: 12; --t: 6; --r: 1;" role="separator" {{ block.shopify_attributes }}>
            {%- if b.label != blank -%}<span class="mdr-mt-divider__label">{{ b.label }}</span>{%- endif -%}
            {%- if b.meta != blank -%}<span class="mdr-mt-divider__meta">{{ b.meta }}</span>{%- endif -%}
          </div>

        {%- when 'colophon' -%}
          {%- assign colophon_lines = b.content | split: newline -%}
          <div class="{{ cls }}" role="contentinfo" style="--d: 12; --t: 6; --r: 1;" {{ block.shopify_attributes }}>
            {%- for line in colophon_lines -%}
              {%- assign trimmed = line | strip -%}
              {%- if trimmed != blank -%}<span>{{ trimmed }}</span>{%- endif -%}
            {%- endfor -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  /* ==========================================================================
     THE MODERN TIMES -- every rule here is scoped to .mdr-mt (this section
     only). Colours are the site's own tokens, in graphite steps rather
     than deep black (--mt-ink / --mt-text / --mt-gray). One typeface
     throughout: the site's licensed PGF Qualta -- display sizes for the
     title and headlines, the site's own smallest size (--mt-small, the
     WEBRACK grid's product-title size) for labels, issue data, bylines,
     credits and numbering.
     ========================================================================== */
  .mdr-mt {
    /* graphite, not deep black: three steps between the site's ink and its
       graphite -- headlines/title (--mt-ink), reading text (--mt-text),
       labels/captions/meta (--mt-gray, the site's own graphite) */
    --mt-ink: color-mix(in srgb, var(--mdr-ink, #202020), var(--mdr-graphite, #858581) 35%);
    --mt-text: color-mix(in srgb, var(--mdr-ink, #202020), var(--mdr-graphite, #858581) 65%);
    --mt-gray: var(--mdr-graphite, #858581);
    /* the site's smallest text size -- the WEBRACK grid's product titles */
    --mt-small: var(--mdr-fs-xs, 0.56rem);
    --mt-rule: var(--mdr-border, #dededa);
    --mt-sans: 'PGF Qualta', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --mt-pad: clamp(16px, 4.2vw, 48px);
    --mt-gutter: clamp(16px, 2.2vw, 24px);
    --mt-vpad: clamp(18px, 2.8vw, 30px);
    --mt-measure: min(100% - 2 * var(--mt-pad), 1280px);

    background: var(--mdr-paper, #f8f8f5);
    color: var(--mt-text);
    font-family: var(--mt-sans);
    font-weight: 400;
    letter-spacing: 0;
    padding-bottom: clamp(40px, 8vw, 96px);
    overflow-x: clip;
  }

  /* From 750px the site frames every page to the header's logo..cart span
     (main's own side padding, mdr-custom.css). Inside that frame the issue
     uses the full framed width; it only adds side padding of its own while
     the frame is still narrower than that padding would be (~750-860px). */
  @media (min-width: 750px) {
    .mdr-mt {
      --mt-pad: clamp(0px, calc((864px - 100vw) / 2), 32px);
    }
  }

  .mdr-mt *,
  .mdr-mt *::before,
  .mdr-mt *::after {
    box-sizing: border-box;
  }

  .mdr-mt p,
  .mdr-mt ol,
  .mdr-mt figure,
  .mdr-mt blockquote {
    margin: 0;
  }

  /* ---- Masthead ----------------------------------------------------------- */
  .mdr-mt-masthead {
    width: var(--mt-measure);
    margin-inline: auto;
    padding-top: clamp(22px, 4.5vw, 52px);
    container-type: inline-size;
  }

  .mdr-mt-masthead__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--mt-rule);
  }

  .mdr-mt .mdr-mt-masthead__publisher {
    font-size: var(--mdr-fs-sm, 0.62rem);
    line-height: 1;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--mt-gray);
  }

  .mdr-mt .mdr-mt-masthead__edition {
    font-family: var(--mt-sans);
    font-size: var(--mt-small);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mt-gray);
    text-align: right;
  }

  /* sized to the masthead's own width (cqi), so the title always runs the
     full measure on one line, phone to desktop */
  .mdr-mt .mdr-mt-masthead__title {
    margin: clamp(12px, 2.4cqi, 28px) 0 clamp(8px, 1.4cqi, 16px);
    font-family: var(--mt-sans);
    font-weight: 400;
    font-size: 2.2rem;
    font-size: min(10.7cqi, 9rem);
    line-height: 0.86;
    letter-spacing: -0.018em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--mt-ink);
  }

  .mdr-mt .mdr-mt-masthead__tagline {
    margin-bottom: clamp(14px, 2.6cqi, 28px);
    font-size: clamp(0.72rem, 2cqi, 0.96rem);
    line-height: 1.3;
    letter-spacing: 0.005em;
    color: var(--mt-gray);
  }

  .mdr-mt-masthead__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: 9px;
    border-block: 1px solid var(--mt-rule);
    font-family: var(--mt-sans);
    font-size: var(--mt-small);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mt-gray);
  }

  /* ---- Editorial grid ------------------------------------------------------
     2 / 6 / 12 columns. No row gap: blocks carry their own vertical padding
     and touch, so column rules and row rules meet cleanly. overflow-x: clip
     trims the rules' half-gutter reach exactly at the grid's outer edges. */
  .mdr-mt-grid {
    width: var(--mt-measure);
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--mt-gutter);
    overflow-x: clip;
  }

  .mdr-mt-item {
    position: relative;
    grid-column: span 2;
    min-width: 0;
    padding-block: var(--mt-vpad);
    container-type: inline-size;
  }

  .mdr-mt-item--m-half {
    grid-column: span 1;
  }

  /* too narrow for two text columns side by side -- recompose to full width */
  @media (max-width: 359px) {
    .mdr-mt-item--m-half.mdr-mt-item--text {
      grid-column: span 2;
    }
  }

  @media (min-width: 600px) {
    .mdr-mt-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .mdr-mt-item,
    .mdr-mt-item--m-half {
      grid-column: span var(--t, 6);
      grid-row: span var(--r, 1);
    }
  }

  @media (min-width: 990px) {
    .mdr-mt-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .mdr-mt-item,
    .mdr-mt-item--m-half {
      grid-column: span var(--d, 12);
    }
  }

  /* ---- Rules (the site's hairline, 1px --mdr-border) ---------------------- */
  .mdr-mt-rule-t::after,
  .mdr-mt-rule-l::before {
    content: '';
    position: absolute;
    background: var(--mt-rule);
    pointer-events: none;
  }

  .mdr-mt-rule-t::after {
    top: 0;
    height: 1px;
    left: calc(var(--mt-gutter) / -2);
    right: calc(var(--mt-gutter) / -2);
  }

  .mdr-mt-rule-l::before {
    top: 0;
    bottom: 0;
    width: 1px;
    left: calc(var(--mt-gutter) / -2);
  }

  /* phones: a full-width block's column rule becomes its top rule; a half-
     width block keeps its column rule (visible when it's the right-hand one)
     and also takes the row's top rule */
  @media (max-width: 599px) {
    .mdr-mt-rule-l::after {
      content: '';
      position: absolute;
      top: 0;
      height: 1px;
      left: calc(var(--mt-gutter) / -2);
      right: calc(var(--mt-gutter) / -2);
      background: var(--mt-rule);
      pointer-events: none;
    }

    .mdr-mt-rule-l:not(.mdr-mt-item--m-half)::before {
      display: none;
    }
  }

  @media (max-width: 359px) {
    .mdr-mt-rule-l.mdr-mt-item--m-half.mdr-mt-item--text::before {
      display: none;
    }
  }

  /* ---- Type ---------------------------------------------------------------- */
  /* Sentence case for the reading levels, this page only. The site sets
     every element uppercase (`body * { text-transform: uppercase
     !important }`, base.css + mdr-custom.css); masthead, section labels,
     metadata and the big headlines stay uppercase, the text you actually
     read opts out here. */
  .mdr-mt .mdr-mt-masthead__tagline,
  .mdr-mt .mdr-mt-hed--standard,
  .mdr-mt .mdr-mt-hed--brief,
  .mdr-mt .mdr-mt-deck,
  .mdr-mt .mdr-mt-body,
  .mdr-mt .mdr-mt-body *,
  .mdr-mt .mdr-mt-cap__text,
  .mdr-mt .mdr-mt-quote__text,
  .mdr-mt .mdr-mt-quote__line,
  .mdr-mt .mdr-mt-manifesto__lines li,
  .mdr-mt .mdr-mt-index li,
  .mdr-mt .mdr-mt-note__body p {
    text-transform: none !important;
  }

  .mdr-mt .mdr-mt-kicker {
    margin-bottom: 12px;
    font-family: var(--mt-sans);
    font-size: var(--mt-small);
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mt-gray);
  }

  .mdr-mt .mdr-mt-hed {
    margin: 0;
    font-family: var(--mt-sans);
    font-weight: 400;
    color: var(--mt-ink);
    text-wrap: balance;
    overflow-wrap: normal;
    word-break: normal;
  }

  .mdr-mt .mdr-mt-hed--lead {
    font-size: 1.8rem;
    font-size: clamp(1.7rem, 8.4cqi, 3.9rem);
    line-height: 0.94;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .mdr-mt .mdr-mt-hed--feature {
    font-size: 1.4rem;
    font-size: clamp(1.35rem, 6.2cqi, 2.4rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .mdr-mt .mdr-mt-hed--standard {
    font-size: 1.1rem;
    font-size: clamp(1.08rem, 5.4cqi, 1.5rem);
    line-height: 1.12;
    letter-spacing: -0.004em;
  }

  .mdr-mt .mdr-mt-hed--brief {
    font-size: 1rem;
    font-size: clamp(0.95rem, 5cqi, 1.15rem);
    line-height: 1.2;
  }

  .mdr-mt .mdr-mt-deck {
    margin-top: 0.7em;
    font-size: 0.8rem;
    font-size: clamp(0.76rem, 3.4cqi, 0.92rem);
    line-height: 1.36;
    letter-spacing: 0.002em;
    text-wrap: pretty;
    color: var(--mt-gray);
  }

  .mdr-mt .mdr-mt-byline {
    margin-top: 1.1em;
    font-family: var(--mt-sans);
    font-size: var(--mt-small);
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mt-gray);
  }

  .mdr-mt .mdr-mt-body {
    margin-top: 1.1em;
    font-size: var(--mdr-fs-md, 0.72rem);
    line-height: 1.6;
    letter-spacing: 0.006em;
    text-wrap: pretty;
    overflow-wrap: break-word;
    hyphens: manual;
    color: var(--mt-text);
  }

  .mdr-mt-story > .mdr-mt-body:first-child {
    margin-top: 0;
  }

  .mdr-mt .mdr-mt-body p + p {
    margin-top: 0.75em;
  }

  @media (min-width: 990px) {
    .mdr-mt .mdr-mt-body {
      font-size: 0.76rem;
    }
  }

  @container (min-width: 480px) {
    .mdr-mt .mdr-mt-body--cols-2,
    .mdr-mt .mdr-mt-body--cols-3 {
      columns: 2;
      column-gap: var(--mt-gutter);
      column-rule: 1px solid var(--mt-rule);
    }
  }

  @container (min-width: 760px) {
    .mdr-mt .mdr-mt-body--cols-3 {
      columns: 3;
    }
  }

  /* short passages only: two narrow columns on a phone-width block */
  @container (min-width: 330px) and (max-width: 479px) {
    .mdr-mt .mdr-mt-body--m2 {
      columns: 2;
      column-gap: 16px;
      column-rule: 1px solid var(--mt-rule);
      font-size: 0.68rem;
    }
  }

  /* ---- Photographs ---------------------------------------------------------- */
  .mdr-mt .mdr-mt-fig {
    margin-block: 1.1em;
  }

  .mdr-mt .mdr-mt-fig:first-child,
  .mdr-mt-figure .mdr-mt-fig {
    margin-top: 0;
  }

  .mdr-mt-figure .mdr-mt-fig {
    margin-bottom: 0;
  }

  .mdr-mt .mdr-mt-img {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
    border: 0;
    border-radius: 0;
    background: var(--mdr-selected, #ecece7);
  }

  .mdr-mt .mdr-mt-img--landscape {
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .mdr-mt .mdr-mt-img--portrait {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .mdr-mt .mdr-mt-img--square {
    aspect-ratio: 1;
    object-fit: cover;
  }

  .mdr-mt-figure--archival .mdr-mt-fig {
    max-width: 82%;
  }

  .mdr-mt-cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 14px;
    margin-top: 8px;
  }

  .mdr-mt .mdr-mt-cap__text {
    font-size: var(--mdr-fs-sm, 0.62rem);
    line-height: 1.4;
    letter-spacing: 0.005em;
    color: var(--mt-gray);
  }

  .mdr-mt .mdr-mt-cap__credit {
    font-family: var(--mt-sans);
    font-size: var(--mt-small);
    line-height: 1.4;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mt-gray);
  }

  /* two photos at one shared height, each at its own original ratio:
     widths are proportional to the ratios, so nothing is cropped */
  .mdr-mt-spread__pair {
    display: flex;
    align-items: flex-start;
    gap: calc(var(--mt-gutter) / 2);
  }

  .mdr-mt-spread__pair > div {
    flex: var(--ar, 1) 1 0%;
    min-width: 0;
  }

  /* full-bleed interruption between two grid sections */
  .mdr-mt-bleed {
    margin: 0;
    padding-block: var(--mt-vpad);
  }

  .mdr-mt-bleed .mdr-mt-cap {
    width: var(--mt-measure);
    margin-inline: auto;
  }

  @media (min-width: 750px) {
    .mdr-mt .mdr-mt-bleed .mdr-mt-img {
      max-height: 86vh;
      object-fit: cover;
      object-position: 50% 42%;
    }
  }

  /* ---- Quotes ---------------------------------------------------------------- */
  .mdr-mt .mdr-mt-quote__text {
    font-size: 1.05rem;
    font-size: clamp(1rem, 7.2cqi, 1.5rem);
    line-height: 1.16;
    letter-spacing: -0.005em;
    text-wrap: balance;
    color: var(--mt-ink);
  }

  .mdr-mt .mdr-mt-quote__line {
    margin-top: 0.8em;
    font-size: var(--mdr-fs-md, 0.72rem);
    line-height: 1.45;
    color: var(--mt-gray);
  }

  .mdr-mt .mdr-mt-quote__by {
    margin-top: 1em;
    font-family: var(--mt-sans);
    font-size: var(--mt-small);
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mt-gray);
  }

  /* manifesto: a full-width interruption -- label / statement / the lines
     that carry it, set as a numbered sequence */
  .mdr-mt-manifesto {
    padding-block: calc(var(--mt-vpad) * 1.5);
  }

  .mdr-mt-manifesto__inner {
    display: grid;
    gap: 14px;
  }

  .mdr-mt .mdr-mt-manifesto__label,
  .mdr-mt .mdr-mt-manifesto__sign {
    font-family: var(--mt-sans);
    font-size: var(--mt-small);
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mt-gray);
  }

  .mdr-mt .mdr-mt-manifesto__sign {
    color: var(--mt-gray);
  }

  .mdr-mt .mdr-mt-manifesto__statement {
    font-size: 2rem;
    font-size: clamp(1.9rem, 10cqi, 5.4rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--mt-ink);
  }

  .mdr-mt-manifesto__lines {
    list-style: none;
    padding: 0;
    counter-reset: mdr-mt-line;
    display: grid;
    gap: 10px;
  }

  .mdr-mt .mdr-mt-manifesto__lines li {
    counter-increment: mdr-mt-line;
    display: grid;
    grid-template-columns: 2.4em minmax(0, 1fr);
    gap: 8px;
    font-size: 0.74rem;
    line-height: 1.46;
    color: var(--mt-text);
  }

  .mdr-mt-manifesto__lines li::before {
    content: counter(mdr-mt-line, decimal-leading-zero);
    padding-top: 0.3em;
    font-family: var(--mt-sans);
    font-size: var(--mt-small);
    letter-spacing: 0.04em;
    color: var(--mt-gray);
  }

  @container (min-width: 700px) {
    .mdr-mt-manifesto__inner {
      grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
      grid-template-rows: auto 1fr;
      column-gap: var(--mt-gutter);
      row-gap: 0;
    }

    .mdr-mt-manifesto__label {
      grid-column: 1;
      grid-row: 1;
    }

    .mdr-mt-manifesto__sign {
      grid-column: 1;
      grid-row: 2;
      align-self: end;
    }

    .mdr-mt .mdr-mt-manifesto__statement {
      grid-column: 2;
      grid-row: 1 / span 2;
      font-size: clamp(2.2rem, 6.2cqi, 5.4rem);
    }

    .mdr-mt-manifesto__lines {
      position: relative;
      grid-column: 3;
      grid-row: 1 / span 2;
      align-self: end;
    }

    .mdr-mt-manifesto__lines::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(var(--mt-gutter) / -2);
      width: 1px;
      background: var(--mt-rule);
    }
  }

  /* ---- Notes / index ----------------------------------------------------------- */
  .mdr-mt .mdr-mt-note__body p {
    font-size: var(--mdr-fs-md, 0.72rem);
    line-height: 1.5;
    color: var(--mt-text);
  }

  .mdr-mt .mdr-mt-note__body p + p {
    margin-top: 0.5em;
  }

  .mdr-mt-index {
    list-style: none;
    padding: 0;
    counter-reset: mdr-mt-index;
  }

  .mdr-mt .mdr-mt-index li {
    counter-increment: mdr-mt-index;
    display: grid;
    grid-template-columns: 2.2em minmax(0, 1fr);
    gap: 6px;
    padding-block: 8px;
    font-size: 0.74rem;
    line-height: 1.3;
    color: var(--mt-text);
  }

  .mdr-mt-index li:first-child {
    padding-top: 0;
  }

  .mdr-mt-index li + li {
    border-top: 1px solid var(--mt-rule);
  }

  .mdr-mt-index li::before {
    content: counter(mdr-mt-index, decimal-leading-zero);
    padding-top: 0.25em;
    font-family: var(--mt-sans);
    font-size: var(--mt-small);
    letter-spacing: 0.04em;
    color: var(--mt-gray);
  }

  /* ---- Section divider / colophon -------------------------------------------------- */
  .mdr-mt-divider {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-block: 11px;
  }

  .mdr-mt-divider__label,
  .mdr-mt-divider__meta {
    font-family: var(--mt-sans);
    font-size: var(--mt-small);
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mt-gray);
  }

  .mdr-mt-divider__meta {
    color: var(--mt-gray);
    text-align: right;
  }

  .mdr-mt-colophon {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 22px;
  }

  .mdr-mt-colophon span {
    font-family: var(--mt-sans);
    font-size: var(--mt-small);
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mt-gray);
  }

  .mdr-mt-colophon span:first-child {
    flex-basis: 100%;
    font-family: var(--mt-sans);
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--mt-ink);
  }
{% endstylesheet %}

