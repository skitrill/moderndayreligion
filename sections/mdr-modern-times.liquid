{%- doc -%}
  THE MODERN TIMES -- an editorial/manifesto page. Structured after a
  magazine-style lookbook (large intro statement, alternating full-bleed
  and two-up documentary photography, occasional bold pull-quotes), but
  in the site's own palette (cream, the shared --mdr-primary blue, the
  same hairline dividers the product grid uses) rather than the black
  background the visual reference used.

  Content lives entirely in blocks (Text / Pull Quote / Image), editable
  in the theme editor -- nothing here is hardcoded copy. Image blocks
  with no image selected fall back to tiling the store's own product
  photography (same fallback mdr-lookbook.liquid uses), so the page never
  looks broken before real editorial photography is uploaded.
{%- enddoc -%}

{%- liquid
  assign s = section.settings
-%}

<section
  id="mdr-modern-times-{{ section.id }}"
  class="mdr-mtimes"
>
  <header class="mdr-mtimes__intro">
    {%- if s.eyebrow != blank -%}
      <p class="mdr-mtimes__eyebrow">{{ s.eyebrow }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h1 class="mdr-mtimes__heading">{{ s.heading }}</h1>
    {%- endif -%}
    {%- if s.tagline != blank -%}
      <p class="mdr-mtimes__tagline">{{ s.tagline }}</p>
    {%- endif -%}
  </header>

  <div class="mdr-mtimes__rule" aria-hidden="true"></div>

  <div class="mdr-mtimes__stream">
    {%- assign fallback_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'text' -%}
          {%- assign lines = block.settings.content | split: newline -%}
          <div class="mdr-mtimes__text" {{ block.shopify_attributes }}>
            {%- for line in lines -%}
              {%- assign trimmed = line | strip -%}
              {%- if trimmed != blank -%}
                <p>{{ trimmed }}</p>
              {%- endif -%}
            {%- endfor -%}
          </div>

        {%- when 'quote' -%}
          <p class="mdr-mtimes__quote" {{ block.shopify_attributes }}>{{ block.settings.content }}</p>

        {%- when 'signature' -%}
          {%- assign sig_lines = block.settings.content | split: newline -%}
          <div class="mdr-mtimes__signature" {{ block.shopify_attributes }}>
            {%- for line in sig_lines -%}
              {%- assign trimmed = line | strip -%}
              {%- if trimmed != blank -%}
                <span>{{ trimmed }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>

        {%- when 'image' -%}
          {%- liquid
            assign img_sizes = '94vw'
            if block.settings.layout == 'half'
              assign img_sizes = '(max-width: 749px) 94vw, 46vw'
            endif
          -%}
          {%- capture tile -%}
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1400, 1600',
                  sizes: img_sizes,
                  class: 'mdr-mtimes__img'
              }}
            {%- else -%}
              {%- liquid
                assign fallback_product = null
                assign products = collections.all.products
                assign fallback_count = products.size
                if fallback_count > 0
                  assign fallback_pick = fallback_index | modulo: fallback_count
                  assign fallback_product = products[fallback_pick]
                endif
                assign fallback_index = fallback_index | plus: 1
              -%}
              {%- if fallback_product and fallback_product.featured_media -%}
                {{
                  fallback_product.featured_media.preview_image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1400, 1600',
                    sizes: img_sizes,
                    class: 'mdr-mtimes__img'
                }}
              {%- endif -%}
            {%- endif -%}
          {%- endcapture -%}
          <figure
            class="mdr-mtimes__figure mdr-mtimes__figure--{{ block.settings.layout }}"
            {{ block.shopify_attributes }}
          >
            {{ tile }}
            {%- if block.settings.caption != blank -%}
              <figcaption class="mdr-mtimes__caption">{{ block.settings.caption }}</figcaption>
            {%- endif -%}
          </figure>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .mdr-mtimes {
    background: #f6f3e7;
    padding-block: clamp(28px, 6vw, 64px) clamp(40px, 8vw, 88px);
  }

  .mdr-mtimes__intro {
    max-width: 620px;
    margin-inline: auto;
    padding-inline: 20px;
    text-align: center;
  }

  .mdr-mtimes__eyebrow {
    margin: 0 0 6px;
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mdr-primary, #040061);
    opacity: 0.72;
  }

  .mdr-mtimes__heading {
    margin: 0 0 10px;
    font-size: clamp(1.5rem, 6vw, 2.4rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--mdr-primary, #040061);
  }

  .mdr-mtimes__tagline {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--mdr-text-gray, rgba(0, 0, 0, 0.5));
  }

  /* same hairline weight/colour as the product grid's own divider lines */
  .mdr-mtimes__rule {
    width: min(120px, 30vw);
    height: 1px;
    margin: clamp(20px, 4vw, 32px) auto;
    background: rgba(var(--mdr-primary-rgb, 4, 0, 97), 0.3);
  }

  .mdr-mtimes__stream {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(20px, 4vw, 32px);
  }

  .mdr-mtimes__text {
    max-width: 560px;
    width: 100%;
    padding-inline: 20px;
    text-align: center;
  }

  .mdr-mtimes__text p {
    margin: 0;
    font-size: 0.7rem;
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: var(--mdr-text-gray, rgba(0, 0, 0, 0.5));
  }

  .mdr-mtimes__text p + p {
    margin-top: 10px;
  }

  /* large editorial statement line -- "PROGRESSION IS RITUAL." etc */
  .mdr-mtimes__quote {
    max-width: 720px;
    width: 100%;
    margin: 0;
    padding-inline: 20px;
    text-align: center;
    font-size: clamp(1.1rem, 4.2vw, 1.7rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--mdr-primary, #040061);
  }

  .mdr-mtimes__signature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding-block-start: 8px;
  }

  .mdr-mtimes__signature span {
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mdr-text-gray, rgba(0, 0, 0, 0.5));
  }

  .mdr-mtimes__signature span:first-child {
    color: var(--mdr-primary, #040061);
  }

  /* ---- Editorial image spreads -------------------------------------- */
  .mdr-mtimes__figure {
    margin: 0;
    width: 100%;
  }

  .mdr-mtimes__figure--full {
    max-width: 900px;
  }

  .mdr-mtimes__figure--half {
    max-width: 900px;
  }

  /* a "half" figure pairs with the very next "half" figure into one
     two-up spread, same rhythm as the reference gallery -- CSS-only,
     no JS grouping needed: two flex children with basis just under 50%
     wrap onto the same row and share it. */
  .mdr-mtimes__stream:has(.mdr-mtimes__figure--half) {
    flex-wrap: wrap;
    flex-direction: row;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .mdr-mtimes__figure--half {
      flex: 1 1 calc(50% - 10px);
      max-width: calc(450px);
    }
  }

  .mdr-mtimes__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #efe9d8;
    border: 1px solid rgba(var(--mdr-primary-rgb, 4, 0, 97), 0.14);
    box-sizing: border-box;
  }

  .mdr-mtimes__figure--full .mdr-mtimes__img {
    aspect-ratio: 16 / 9;
  }

  .mdr-mtimes__caption {
    margin-top: 6px;
    font-size: 0.56rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-align: center;
    color: var(--mdr-text-gray, rgba(0, 0, 0, 0.5));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MDR Modern Times",
  "tag": "section",
  "class": "mdr-modern-times-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MODARE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Modern Times"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Progression, culture & the world we live in."
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "textarea",
          "id": "content",
          "label": "Paragraph(s)",
          "info": "One paragraph per line."
        }
      ]
    },
    {
      "type": "quote",
      "name": "Pull Quote",
      "settings": [
        {
          "type": "text",
          "id": "content",
          "label": "Line"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave blank to show product photography as a placeholder."
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            { "value": "full", "label": "Full width" },
            { "value": "half", "label": "Half (pairs with the next half image)" }
          ],
          "default": "full"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        }
      ]
    },
    {
      "type": "signature",
      "name": "Signature block",
      "settings": [
        {
          "type": "textarea",
          "id": "content",
          "label": "Lines",
          "info": "One line per row."
        }
      ]
    }
  ],
  "max_blocks": 60,
  "presets": [
    {
      "name": "MDR Modern Times",
      "blocks": []
    }
  ]
}
{% endschema %}
