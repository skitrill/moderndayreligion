{%- doc -%}
  MDR Lookbook -- a tight, uniform image grid centred in the page on every
  viewport. Drop images into the "Image" blocks in the theme editor; with no
  blocks it falls back to tiling the store's product imagery so the layout is
  always visible.
{%- enddoc -%}

{%- liquid
  assign s = section.settings

  case s.image_ratio
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '1 / 1'
  endcase

  assign image_blocks = section.blocks | where: 'type', 'image'
  assign has_images = false
  for b in image_blocks
    if b.settings.image != blank
      assign has_images = true
      break
    endif
  endfor
-%}

<section
  id="mdr-lookbook-{{ section.id }}"
  class="mdr-lookbook mdr-lookbook--hover-{{ s.hover_effect }}{% if s.center_vertically %} mdr-lookbook--center{% endif %}"
  style="
    --mdr-lb-cols: {{ s.desktop_columns }};
    --mdr-lb-cols-m: {{ s.mobile_columns }};
    --mdr-lb-gap: {{ s.gap }}px;
    --mdr-lb-maxw: {{ s.grid_max_width }}px;
    --mdr-lb-ratio: {{ ratio }};
    --mdr-lb-bg: {{ s.background_color | default: '#000000' }};
  "
>
  {%- if s.heading != blank -%}
    <h1 class="mdr-lookbook__heading">{{ s.heading }}</h1>
  {%- endif -%}

  <div class="mdr-lookbook__grid">
    {%- if has_images -%}
      {%- assign i = 0 -%}
      {%- for b in image_blocks -%}
        {%- if b.settings.image == blank -%}{%- continue -%}{%- endif -%}
        {%- capture tile -%}
          {{
            b.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '200, 300, 400, 600, 800, 1000, 1400',
              sizes: '(max-width: 749px) 46vw, 320px',
              class: 'mdr-lookbook__img'
          }}
        {%- endcapture -%}
        <div
          class="mdr-lookbook__item"
          style="--i: {{ i }}"
          data-full="{{ b.settings.image | image_url: width: 1600 }}"
          {{ b.shopify_attributes }}
        >
          {%- if b.settings.link != blank -%}
            <a class="mdr-lookbook__link" href="{{ b.settings.link }}">{{ tile }}</a>
          {%- else -%}
            {{ tile }}
          {%- endif -%}
        </div>
        {%- assign i = i | plus: 1 -%}
      {%- endfor -%}
    {%- else -%}
      {%- assign max_tiles = 64 -%}
      {%- assign shown = 0 -%}
      {%- for pass in (1..40) -%}
        {%- assign media_index = pass | minus: 1 | modulo: 4 -%}
        {%- for product in collections.all.products -%}
          {%- if shown >= max_tiles -%}{%- break -%}{%- endif -%}
          {%- assign media = product.media[media_index] -%}
          {%- if media == blank -%}{%- assign media = product.featured_media -%}{%- endif -%}
          {%- if media == blank or media.preview_image == blank -%}{%- continue -%}{%- endif -%}
          <div
            class="mdr-lookbook__item"
            style="--i: {{ shown }}"
            data-full="{{ media.preview_image | image_url: width: 1400 }}"
          >
            {{
              media.preview_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '120, 160, 220, 300, 400, 600, 800',
                sizes: '(max-width: 749px) 13vw, 90px',
                class: 'mdr-lookbook__img'
            }}
          </div>
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var SECTION_ID = {{ section.id | json }};

    function build(root) {
      if (!root || root.__mdrLbViewer) return;
      root.__mdrLbViewer = true;

      var tiles = Array.prototype.slice.call(root.querySelectorAll('.mdr-lookbook__item'));
      if (!tiles.length) return;
      var grid = root.querySelector('.mdr-lookbook__grid');

      var items = tiles.map(function (t) {
        var img = t.querySelector('img');
        return {
          tile: t,
          full: t.getAttribute('data-full') || (img && (img.currentSrc || img.src)) || '',
          alt: (img && img.alt) || ''
        };
      });

      var viewer = document.querySelector('.mdr-lb-viewer');
      if (!viewer) {
        viewer = document.createElement('div');
        viewer.className = 'mdr-lb-viewer';
        viewer.hidden = true;
        viewer.innerHTML =
          '<div class="mdr-lb-viewer__backdrop"></div>' +
          '<figure class="mdr-lb-viewer__figure"><img class="mdr-lb-viewer__img" alt=""></figure>';
        document.body.appendChild(viewer);
      }
      var figure = viewer.querySelector('.mdr-lb-viewer__figure');
      var vImg = viewer.querySelector('.mdr-lb-viewer__img');
      var backdrop = viewer.querySelector('.mdr-lb-viewer__backdrop');

      var idx = -1;
      var isOpen = false;

      /* ~50% of the whole grid layout + 15%, clamped to the viewport, centred. */
      function sizeFigure() {
        var r = grid.getBoundingClientRect();
        var base = Math.min(r.width, r.height) * 0.575;
        var cap = Math.min(window.innerWidth, window.innerHeight) * 0.9;
        var size = Math.max(276, Math.min(base, cap));
        figure.style.width = size + 'px';
        figure.style.height = size + 'px';
      }

      function mark(i) {
        items.forEach(function (it, k) {
          it.tile.classList.toggle('is-selected', k === i);
        });
      }

      function show(i, dir) {
        i = (i + items.length) % items.length;
        idx = i;
        mark(i);
        vImg.classList.remove('mdr-lb-in-up', 'mdr-lb-in-down');
        void vImg.offsetWidth;
        vImg.src = items[i].full;
        vImg.alt = items[i].alt;
        if (dir === 1) vImg.classList.add('mdr-lb-in-up');
        else if (dir === -1) vImg.classList.add('mdr-lb-in-down');
      }

      function openAt(i) {
        sizeFigure();
        viewer.hidden = false;
        document.documentElement.classList.add('mdr-lb-lock');
        requestAnimationFrame(function () { viewer.classList.add('is-open'); });
        isOpen = true;
        show(i, 0);
      }

      function close() {
        isOpen = false;
        viewer.classList.remove('is-open');
        document.documentElement.classList.remove('mdr-lb-lock');
        items.forEach(function (it) { it.tile.classList.remove('is-selected'); });
        setTimeout(function () { if (!isOpen) viewer.hidden = true; }, 260);
      }

      function next() { show(idx + 1, 1); }
      function prev() { show(idx - 1, -1); }

      tiles.forEach(function (t, i) {
        t.addEventListener('click', function (e) {
          e.preventDefault();
          openAt(i);
        });
      });

      viewer.addEventListener('click', function (e) {
        if (e.target === viewer || e.target === backdrop) close();
      });

      /* desktop: vertical wheel steps through images */
      var wheelLock = false;
      viewer.addEventListener('wheel', function (e) {
        if (!isOpen) return;
        e.preventDefault();
        if (wheelLock || Math.abs(e.deltaY) < 6) return;
        wheelLock = true;
        (e.deltaY > 0 ? next : prev)();
        setTimeout(function () { wheelLock = false; }, 240);
      }, { passive: false });

      document.addEventListener('keydown', function (e) {
        if (!isOpen) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowDown') { e.preventDefault(); next(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); prev(); }
      });

      /* touch: vertical swipe only (up = next, down = prev).
         The frame stays put -- we only read the gesture on touchend. */
      var sy = 0, sx = 0, dragging = false;
      viewer.addEventListener('touchstart', function (e) {
        if (!isOpen) return;
        var t = e.touches[0];
        sy = t.clientY; sx = t.clientX; dragging = true;
      }, { passive: true });
      viewer.addEventListener('touchend', function (e) {
        if (!dragging) return;
        dragging = false;
        var t = (e.changedTouches && e.changedTouches[0]) || null;
        if (!t) return;
        var dy = t.clientY - sy;
        var dx = t.clientX - sx;
        if (Math.abs(dy) > 44 && Math.abs(dy) > Math.abs(dx)) {
          (dy < 0 ? next : prev)();
        }
      }, { passive: true });

      window.addEventListener('resize', function () { if (isOpen) sizeFigure(); }, { passive: true });
    }

    function boot() { build(document.getElementById('mdr-lookbook-' + SECTION_ID)); }

    if (document.readyState !== 'loading') boot();
    else document.addEventListener('DOMContentLoaded', boot);

    document.addEventListener('shopify:section:load', function (e) {
      var r = (e.target && e.target.querySelector('#mdr-lookbook-' + SECTION_ID)) ||
        document.getElementById('mdr-lookbook-' + SECTION_ID);
      if (r) { r.__mdrLbViewer = false; build(r); }
    });
  })();
</script>

{% stylesheet %}
  .mdr-lookbook {
    background: var(--mdr-lb-bg, #000);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(16px, 5vw, 56px) clamp(10px, 4vw, 40px);
  }

  .mdr-lookbook--center {
    min-height: calc(100svh - var(--header-height, 60px));
    justify-content: center;
  }

  /* Match the rest of the site (Anonymous Pro, e.g. the footer "© 2026" line):
     same size, same tracking -- no wide letter-spacing. */
  .mdr-lookbook__heading {
    margin: 0 0 clamp(10px, 2.4vw, 20px);
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-align: center;
    color: rgba(240, 238, 230, 0.6);
  }

  .mdr-lookbook__grid {
    display: grid;
    grid-template-columns: repeat(var(--mdr-lb-cols-m, 2), 1fr);
    gap: var(--mdr-lb-gap, 4px);
    width: min(var(--mdr-lb-maxw, 880px), 100%);
    margin-inline: auto;
  }

  @media (min-width: 750px) {
    .mdr-lookbook__grid {
      grid-template-columns: repeat(var(--mdr-lb-cols, 3), 1fr);
    }
  }

  .mdr-lookbook__item,
  .mdr-lookbook__link {
    display: block;
    position: relative;
    overflow: hidden;
  }

  .mdr-lookbook__item {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* slim brown ring on the tapped tile, just before it pops open */
  .mdr-lookbook__item.is-selected {
    outline: 1px solid #8a5a2f;
    outline-offset: 1px;
    z-index: 2;
  }

  .mdr-lookbook__item img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: var(--mdr-lb-ratio, 1 / 1);
    object-fit: cover;
    background: #0a0a0a;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.45s ease, opacity 0.6s ease;
  }

  .mdr-lookbook--hover-zoom .mdr-lookbook__item:hover img {
    transform: scale(1.045);
  }

  .mdr-lookbook--hover-reveal .mdr-lookbook__item img {
    filter: grayscale(1) contrast(1.04);
  }

  .mdr-lookbook--hover-reveal .mdr-lookbook__item:hover img {
    filter: grayscale(0) contrast(1);
  }

  @media (hover: none) {
    .mdr-lookbook--hover-reveal .mdr-lookbook__item img {
      filter: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mdr-lookbook__item {
      animation: mdr-lookbook-in 0.5s both;
      animation-delay: calc(min(var(--i, 0), 32) * 16ms);
    }
  }

  @keyframes mdr-lookbook-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ==== Expanded viewer (tap a tile -> pops to ~50% of the grid) ========== */
  :root.mdr-lb-lock {
    overflow: hidden;
  }

  .mdr-lb-viewer {
    position: fixed;
    inset: 0;
    z-index: 2147482000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vmin;
    opacity: 0;
    pointer-events: none;
    touch-action: none;
    transition: opacity 0.2s ease;
  }

  .mdr-lb-viewer.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .mdr-lb-viewer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.86);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }

  .mdr-lb-viewer__figure {
    position: relative;
    margin: 0;
    padding: 0;
    max-width: 94vw;
    max-height: 92vh;
    background: #000;
    border: 0;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55);
    overflow: hidden;
    transform: scale(0.72);
    transition: transform 0.34s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mdr-lb-viewer.is-open .mdr-lb-viewer__figure {
    transform: scale(1);
  }

  .mdr-lb-viewer__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }

  .mdr-lb-in-up {
    animation: mdr-lb-slide-up 0.24s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .mdr-lb-in-down {
    animation: mdr-lb-slide-down 0.24s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes mdr-lb-slide-up {
    from { opacity: 0; transform: translateY(26px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes mdr-lb-slide-down {
    from { opacity: 0; transform: translateY(-26px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mdr-lb-viewer,
    .mdr-lb-viewer__figure {
      transition: none;
    }
    .mdr-lb-in-up,
    .mdr-lb-in-down {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MDR Lookbook",
  "tag": "section",
  "class": "mdr-lookbook-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lookbook",
      "info": "Leave blank to hide."
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_max_width",
      "label": "Grid max width",
      "min": 320,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "center_vertically",
      "label": "Centre in viewport",
      "default": true
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover effect",
      "options": [
        { "value": "zoom", "label": "Zoom" },
        { "value": "reveal", "label": "Greyscale to colour" },
        { "value": "none", "label": "None" }
      ],
      "default": "zoom"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "MDR Lookbook",
      "blocks": []
    }
  ]
}
{% endschema %}
