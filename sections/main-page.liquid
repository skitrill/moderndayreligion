

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{%- comment -%}
  The Modern Times used to render its content straight from here, before
  the page's own theme template pointed at a dedicated section (sections/
  mdr-modern-times.liquid, templates/page.the-modern-times.json) with a
  real block-based structure (Text/Quote/Image/Signature/Entry header)
  instead of hardcoded copy. That template still includes THIS section
  too (as its "main" entry, with no blocks configured) -- this special
  case rendering the old hardcoded snippet ALONGSIDE the new section was
  live on the page at the same time, was the actual cause of "the body
  text collapsing into a character-wide column": snippets/mdr-modern-
  times-content.liquid's own <style> tag (unscoped, sharing the exact
  same class names as the new section) was cascading onto both instances,
  while the SECTION's own block-rendering bug (an undefined `newline`
  variable, fixed there) produced 130+ single-character <p> tags that
  visually broke the page long before a reader would ever scroll far
  enough to reach the old snippet's own separate, correctly-formatted
  copy sitting ~30,000px further down. Removed outright, not just hidden:
  the section is now the one and only source of this page's content.
{%- endcomment -%}
<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section page-width-content{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
