{%- doc -%}
  Lock screen logo -- the homepage landing screen's logo (sections/
  mdr-landing.liquid): the same asset, and the same .mdr-landing__logo
  class, so assets/mdr-custom.css sizes and tints it identically. Not the
  native "logo" theme block (which reads settings.logo, an uploaded image
  the store may not actually have set to this mark). Used from
  templates/password.json.
{%- enddoc -%}

<div class="mdr-lock-logo mdr-landing__logo">
  <img
    src="{{ 'mdr-logo.svg' | asset_url }}"
    alt="{{ 'accessibility.home_logo_alt' | t: store_name: shop.name }}"
    width="1244.82"
    height="121.83"
    loading="eager"
  >
</div>

{% schema %}
{
  "name": "MDR Logo (lock screen)",
  "tag": null
}
{% endschema %}
