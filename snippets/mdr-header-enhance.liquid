          continue;
        }
        bar.style.marginTop = ((err.offsetHeight / zoomFactor) + 8) + 'px';
      }
    }

    function watch() {
      if (!window.MutationObserver) return;
      var bars = D.querySelectorAll('.product-form-buttons, .product-form__buttons');
      for (var i = 0; i < bars.length; i++) {
        if (bars[i].__mdrFormErrorWatched) continue;
        bars[i].__mdrFormErrorWatched = true;
        new MutationObserver(sync).observe(bars[i], {
          attributes: true,
          attributeFilter: ['class'],
          subtree: true,
          childList: true,
          characterData: true
        });
      }
    }

    if (D.readyState !== 'loading') { sync(); watch(); }
    D.addEventListener('DOMContentLoaded', function () { sync(); watch(); });
    window.addEventListener('load', function () { sync(); watch(); });
    window.addEventListener('resize', sync, { passive: true });

    if (window.MutationObserver) {
      var m2 = D.querySelector('main') || D.body;
      new MutationObserver(watch).observe(m2, { childList: true, subtree: true });
    }
  })();

  /* Homepage grid load-in is a single, plain CSS animation now (one slide-
     up for the whole grid, not a per-card staggered cascade) -- see
     mdr-custom.css. No JS needed: a CSS animation on the grid element
     just plays on its own first paint. */

  /* =====================================================================
     WEBRACK grid full-bleed edge-to-edge fix -- .mdr-scrollfade
     (mdr-custom.css) needs overflow-x: hidden for the swipe animation,
     which clips a plain vw-based full-bleed trick under some viewport/
     zoom combinations. getBoundingClientRect reports true rendered
     coordinates regardless, so this measures the real gap on either side
     and corrects it directly as an inline style. Previously also had to
     divide by the page's own CSS-zoom factor (a [+/- page] size toggle
     that used to live on this page, since removed) -- zoomFactor is now
     always 1, kept only so this still behaves correctly if body ever
     carries a legitimate CSS zoom again for some other reason. */
  (function () {
    if (window.__mdrScrollfadeBleed) return;
    window.__mdrScrollfadeBleed = true;
    var D = document;

    function fixScrollfadeBleed() {
      var el = D.querySelector("[id$='__product_list_fa6P9H'] .mdr-scrollfade");
      if (!el) return;
      /* Desktop now deliberately insets the grid inside a large page
         border (mdr-custom.css, main { padding-inline: 30% }) instead of
         running it edge-to-edge -- this full-bleed correction is a
         mobile-only fix (the WEBRACK swipe animation's clipping issue is
         a narrow-viewport concern), so it has to bail out above that
         breakpoint or it just measures the new deliberate gap and
         cancels it back out with a negative margin, exactly like the
         clipping bug it was written to fix. */
      if (window.innerWidth >= 750) {
        el.style.marginLeft = '';
        el.style.marginRight = '';
        el.style.width = '';
        return;
      }
      var zoomFactor = parseFloat(D.body.style.zoom) || 1;
      el.style.marginLeft = '';
      el.style.marginRight = '';
      el.style.width = '';
      var rect = el.getBoundingClientRect();
      var leftGap = rect.left;
      var rightGap = D.documentElement.clientWidth - rect.right;
      if (leftGap <= 0 && rightGap <= 0) return;
      el.style.width = ((rect.width + leftGap + rightGap) / zoomFactor) + 'px';
      el.style.marginLeft = (-leftGap / zoomFactor) + 'px';
      el.style.marginRight = (-rightGap / zoomFactor) + 'px';
    }

    if (D.readyState !== 'loading') fixScrollfadeBleed();
    D.addEventListener('DOMContentLoaded', fixScrollfadeBleed);
    window.addEventListener('load', fixScrollfadeBleed);
    window.addEventListener('resize', fixScrollfadeBleed, { passive: true });
  })();

  /* =====================================================================
     Cart delete-icon colour -- a genuine rendering quirk, not a CSS
     specificity problem: the icon's <path stroke="currentColor"> resolves
     against a colour Chromium supplies for SVG children of a native
     <button> that inherits color-scheme: dark (set globally on body,
     intentionally, for Safari's own overscroll chrome) -- and that
     resolution turns out to be locked in against the STATIC stylesheet
     cascade specifically; the exact same `color` declaration applied as a
     live style MUTATION instead (not a parsed stylesheet rule) reliably
     fixes it, confirmed directly: setting color on the button, or on its
     <svg>, both visibly changed THEIR OWN computed color and did nothing
     for the icon; setting it on the <path> itself via a stylesheet rule
     also did nothing; only setting it on the <path> via a live JS style
     mutation actually repaints the stroke. mdr-custom.css still carries
     the equivalent static rule for any browser that doesn't have this
     quirk -- this is the runtime fix for the ones that do.
     Cart rows re-render in place (quantity edits, item removal) rather
     than a full page reload, so a MutationObserver re-applies this to any
     row swapped in later, not just whatever was present at first load --
     watching document.body (not .cart-items itself): confirmed live that
     a remove-item AJAX update replaces .cart-items wholesale with a new
     element, not just its children, which silently orphans an observer
     that was attached to the OLD reference (it keeps watching a detached
     node no longer connected to anything, and never fires again) -- the
     icon went back to invisible after the very first removal in testing.
     body is never itself replaced, so this survives any number of cart
     updates; subtree:true still catches the swap wherever it happens
     underneath it. */
  (function () {
    if (window.__mdrCartRemoveColor) return;
    window.__mdrCartRemoveColor = true;
    var D = document;

    function fix() {
      var paths = D.querySelectorAll('.cart-items__remove path');
      for (var i = 0; i < paths.length; i++) {
        paths[i].style.setProperty('color', 'var(--mdr-text-gray, #858581)', 'important');
      }
    }

    fix();
    D.addEventListener('DOMContentLoaded', fix);
    window.addEventListener('load', fix);

    if (window.MutationObserver) {
      new MutationObserver(fix).observe(D.body, { childList: true, subtree: true });
    }
  })();

  /* The page-adaptive overscroll/edge-colour system that used to live
     here (reading the header/footer's own background and pushing it live
     into --mdr-edge-top/--mdr-edge-bottom/--mdr-edge-color as you
     scrolled, so the rubber-band glow and safe-area strips tinted red or
     cream depending on the page) has been removed on purpose: multiple
     colour systems (this JS, plus the primary-colour CSS variable,
     mdr-custom.css) fighting over the same properties was exactly the
     inconsistency being complained about. Those three custom properties
     are now fixed, static, colourless values set once in mdr-custom.css
     (:root) -- identical on every page and at both edges, nothing left
     here to detect or switch on scroll. */
</script>
