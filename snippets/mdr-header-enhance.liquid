{%- doc -%}
  MDR header / scroll enhancements (custom, non-Horizon).

  - [bottom]: a tiny text control under the cart in the header bar. Scrolls to the
    last product on the page with a snappy "windy" easing.
  - [top]: a tiny fixed control pinned to the bottom-right of the viewport that
    fades in on scroll. Scrolls back to the first product / top of the page.
    Built in JS and appended to <body> so it stays viewport-fixed.

  Styles live in assets/mdr-custom.css (loaded from <head>). This snippet is
  rendered once from the `actions` capture in sections/header.liquid.
{%- enddoc -%}

{%- comment -%} The [v] jump-to-bottom control under the cart has been removed. {%- endcomment -%}

{%- comment -%} Collection titles for the [ALL >] bar (read by __mdrAllBar). {%- endcomment -%}
<script type="application/json" id="mdr-allbar-data">
[
{%- assign _mdr_n = 0 -%}
{%- for collection in collections limit: 24 -%}
  {%- assign _h = collection.handle -%}
  {%- unless _h == 'all' or _h == 'frontpage' -%}
    {%- if _mdr_n > 0 -%},{%- endif -%}
    {"t": {{ collection.title | json }}, "u": {{ collection.url | json }}}
    {%- assign _mdr_n = _mdr_n | plus: 1 -%}
  {%- endunless -%}
{%- endfor -%}
]
</script>

<script>
  (function () {
    if (window.__mdrHeaderEnhance) return;
    window.__mdrHeaderEnhance = true;

    var D = document;
    var topBtn = null;
    var REDUCE = window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var glideRAF = null;
    var glideDetach = null;

    function scrollTop() {
      return window.scrollY || window.pageYOffset || D.documentElement.scrollTop || 0;
    }

    function maxScroll() {
      return Math.max(0, D.documentElement.scrollHeight - window.innerHeight);
    }

    /* Smooth + wavy: an ease-in-out S-curve with a gentle spring settle at the
       end -- fluid to watch, still lands quickly. */
    function easeWavy(p) {
      if (p >= 1) return 1;
      /* easeInOutCubic base -- soft start, soft stop */
      var base = p < 0.5
        ? 4 * p * p * p
        : 1 - Math.pow(-2 * p + 2, 3) / 2;
      /* one low, fast-decaying ripple over the travel -> the "wave" */
      var wave = Math.sin(p * Math.PI * 3) * 0.045 * (1 - p) * (1 - p);
      return base + wave;
    }

    /* Windy + snappy: eased travel you can see, bailing out the moment the
       user grabs the page back with a wheel / swipe / nav key. */
    function glideScroll(targetY, btn) {
      targetY = Math.max(0, Math.min(targetY, maxScroll()));
      var startY = scrollTop();
      var dist = targetY - startY;

      if (glideRAF) { cancelAnimationFrame(glideRAF); glideRAF = null; }
      if (glideDetach) glideDetach();

      if (REDUCE || Math.abs(dist) < 2) {
        window.scrollTo(0, targetY);
        zap(btn);
        return;
      }

      D.documentElement.style.scrollBehavior = 'auto';
      var dur = Math.max(560, Math.min(1150, 360 + Math.abs(dist) * 0.2));
      var t0 = null;
      var stopped = false;

      function detach() {
        window.removeEventListener('wheel', bail);
        window.removeEventListener('touchstart', bail);
        window.removeEventListener('keydown', onKey);
        glideDetach = null;
      }
      function bail() {
        stopped = true;
        if (glideRAF) { cancelAnimationFrame(glideRAF); glideRAF = null; }
        detach();
      }
      function onKey(e) {
        if (/^(Arrow|Page)/.test(e.key) || e.key === 'Home' ||
            e.key === 'End' || e.key === ' ') {
          bail();
        }
      }
      window.addEventListener('wheel', bail, { passive: true });
      window.addEventListener('touchstart', bail, { passive: true });
      window.addEventListener('keydown', onKey);
      glideDetach = detach;

      function step(now) {
        if (stopped) return;
        if (t0 === null) t0 = now;
        var p = Math.min(1, (now - t0) / dur);
        window.scrollTo(0, Math.round(startY + dist * easeWavy(p)));
        if (p < 1) {
          glideRAF = requestAnimationFrame(step);
        } else {
          glideRAF = null;
          detach();
          zap(btn);
        }
      }
      glideRAF = requestAnimationFrame(step);
    }

    function headerOffset() {
      var raw = getComputedStyle(D.body).getPropertyValue('--header-height').trim();
      var n = parseFloat(raw);
      return (isNaN(n) ? 60 : n) + 10;
    }

    function productCards() {
      return Array.prototype.slice.call(D.querySelectorAll('product-card, .product-card'));
    }

    function zap(el) {
      if (!el) return;
      el.classList.remove('mdr-zap');
      void el.offsetWidth;
      el.classList.add('mdr-zap');
    }

    function goTop() {
      var now = scrollTop();
      var first = productCards()[0];
      var y = first ? first.getBoundingClientRect().top + now - headerOffset() : 0;
      /* never jump downward -- fall back to the very top */
      if (y >= now - 2) y = 0;
      glideScroll(y, topBtn);
    }

    /* Build the fixed [top] control and pin it to <body> */
    function ensureTopButton() {
      if (topBtn && topBtn.isConnected && topBtn.parentNode === D.body) return;
      topBtn = D.querySelector('.mdr-scrolltop');
      if (!topBtn) {
        topBtn = D.createElement('button');
        topBtn.type = 'button';
        topBtn.className = 'mdr-scrolltop';
        topBtn.setAttribute('aria-label', 'Jump to top');
        topBtn.innerHTML =
          '<span class="mdr-bracket">[</span>' +
          '<svg class="mdr-arrow" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true" focusable="false">' +
          '<path d="M1 6.5 6 1.5l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>' +
          '</svg><span class="mdr-bracket">]</span>';
        topBtn.addEventListener('click', function (e) {
          e.preventDefault();
          goTop();
        });
      }
      if (topBtn.parentNode !== D.body) D.body.appendChild(topBtn);
    }

    function updateVisibility() {
      var y = scrollTop();
      var maxY = maxScroll();
      var atBottom = maxY > 40 && y >= maxY - 4;
      if (topBtn) topBtn.classList.toggle('mdr-visible', y > 80 || atBottom);
    }

    function init() {
      ensureTopButton();
      updateVisibility();
    }

    /* Catch scrolling regardless of which node emits the event */
    window.addEventListener('scroll', updateVisibility, { passive: true });
    D.addEventListener('scroll', updateVisibility, { passive: true, capture: true });
    window.addEventListener('resize', updateVisibility, { passive: true });

    if (D.readyState !== 'loading') init();
    D.addEventListener('DOMContentLoaded', init);
    window.addEventListener('load', init);

    /* Re-wire / re-pin after Horizon section hydration swaps header DOM */
    var hc = D.querySelector('#header-component');
    if (hc && window.MutationObserver) {
      new MutationObserver(init).observe(hc, { childList: true, subtree: true });
    }
  })();

  /* =====================================================================
     Homepage grid: a fixed 2-col (mobile) / 4-col (desktop) layout, always
     -- the old dense/zoom-toggle-by-tapping-the-logo feature is gone. This
     just keeps the "pad the grid with inert clones so it looks full"
     behaviour, since the store only has a few real products right now.
     ===================================================================== */
  (function () {
    if (window.__mdrGridPad) return;
    window.__mdrGridPad = true;

    var D = document;

    function featured() {
      return D.querySelector('[id$="__product_list_fa6P9H"]');
    }

    /* TEMP: only a few products -- clone the tiles so the grid looks full
       while we test. Clones are inert + tagged [data-mdr-clone]; delete
       this function + its calls when done. */
    function padFill() {
      var sec = featured();
      if (!sec) return;
      var grid = sec.querySelector('.resource-list--grid') || sec.querySelector('.resource-list');
      if (!grid) return;

      var clones = grid.querySelectorAll('[data-mdr-clone]');
      for (var c = clones.length - 1; c >= 0; c--) clones[c].remove();

      var originals = [];
      var kids = grid.children;
      for (var k = 0; k < kids.length; k++) {
        if (!kids[k].hasAttribute('data-mdr-clone')) originals.push(kids[k]);
      }
      if (!originals.length) return;

      var need = 24 - originals.length;
      if (need <= 0) return;

      var frag = D.createDocumentFragment();
      for (var i = 0; i < need; i++) {
        var node = originals[i % originals.length].cloneNode(true);
        node.setAttribute('data-mdr-clone', '');
        node.style.pointerEvents = 'none';
        var pc = node.querySelector('product-card');
        if (pc) {
          pc.removeAttribute('on:click');
          pc.removeAttribute('id');
        }
        var links = node.querySelectorAll('a');
        for (var l = 0; l < links.length; l++) links[l].removeAttribute('href');
        frag.appendChild(node);
      }
      grid.appendChild(frag);
    }

    function boot() { padFill(); }

    boot();
    if (D.readyState !== 'loading') boot();
    D.addEventListener('DOMContentLoaded', boot);
    window.addEventListener('load', boot);
  })();

  /* =====================================================================
     Header menu -> a compact "USER" dropdown under the caret.
     Everything but the account link is stripped (in CSS); here we rename
     it, drop the scroll-lock, and close it on an outside tap.
     ===================================================================== */
  (function () {
    if (window.__mdrHeaderMenu) return;
    window.__mdrHeaderMenu = true;
    var D = document;

    function tidy() {
      var det = D.getElementById('Details-menu-drawer-container');
      if (!det) return;
      det.removeAttribute('scroll-lock');

      var acct = det.querySelector('.menu-drawer__menu-item[href*="/account"], a[href*="/account"]');
      if (acct && acct.textContent.trim().toLowerCase() === 'account') {
        acct.textContent = 'User';
      }

      if (!det.__mdrWired) {
        det.__mdrWired = true;
        det.addEventListener('toggle', function () {
          if (!det.open) return;
          det.removeAttribute('scroll-lock');
          D.documentElement.style.overflow = '';
          D.body.style.overflow = '';
        });
        D.addEventListener('click', function (e) {
          if (det.open && !det.contains(e.target)) det.open = false;
        }, true);
      }
    }

    if (D.readyState !== 'loading') tidy();
    D.addEventListener('DOMContentLoaded', tidy);
    window.addEventListener('load', tidy);
    var hc = D.querySelector('#header-component');
    if (hc && window.MutationObserver) {
      new MutationObserver(tidy).observe(hc, { childList: true, subtree: true });
    }
  })();

  /* =====================================================================
     The old "ALL / TOPS / LOOKBOOK" strip above the grid is gone -- strip
     any stale copy the theme cached and never rebuild it.
     ===================================================================== */
  (function () {
    if (window.__mdrHomeNav) return;
    window.__mdrHomeNav = true;
    var D = document;
    function strip() {
      var n = D.querySelectorAll('.mdr-home-nav');
      for (var i = 0; i < n.length; i++) n[i].remove();
    }
    strip();
    D.addEventListener('DOMContentLoaded', strip);
    window.addEventListener('load', strip);
    var m = D.querySelector('main') || D.body;
    if (window.MutationObserver) {
      new MutationObserver(strip).observe(m, { childList: true });
    }
  })();

  /* =====================================================================
     WEBRACK » bar: a small collapsed pill in the header, right next to the
     logo. Tap it and it slides open into the list of collection titles;
     tap again -- or tap anywhere outside -- to collapse it.
     ===================================================================== */
  (function () {
    if (window.__mdrAllBar) return;
    window.__mdrAllBar = true;
    var D = document;

    function collections() {
      var el = D.getElementById('mdr-allbar-data');
      if (!el) return [];
      try { return JSON.parse(el.textContent) || []; } catch (e) { return []; }
    }

    function build() {
      if (D.querySelector('.mdr-allbar-wrap')) return;
      /* mount right under the site header so it shows on EVERY page, sitting
         under the logo (a full-width line aligned to the page gutter) */
      var header = D.querySelector('header.shopify-section-group-header-group') ||
        (D.querySelector('#header-component') &&
          D.querySelector('#header-component').closest('header')) ||
        D.querySelector('header');
      if (!header || !header.parentNode) return;

      var data = collections();
      var isHome = location.pathname === '/' || location.pathname === '';

      var wrap = D.createElement('div');
      wrap.className = 'mdr-allbar-wrap';

      var bar = D.createElement('div');
      bar.className = 'mdr-allbar' + (isHome ? '' : ' mdr-allbar--back');

      /* a clean double-chevron, not the raw "»" glyph -- flipped via CSS for
         the back-button state */
      var CHEV_SVG =
        '<svg viewBox="0 0 14 12" fill="none" stroke="currentColor" ' +
        'stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">' +
        '<path d="M1.5 2l4 4-4 4"/><path d="M7.5 2l4 4-4 4"/></svg>';

      var toggle = D.createElement('button');
      toggle.type = 'button';
      toggle.className = 'mdr-allbar__toggle';
      toggle.setAttribute('aria-expanded', 'false');
      toggle.innerHTML = isHome
        ? '<span class="mdr-allbar__label">Webrack</span>' +
          '<span class="mdr-allbar__chev" aria-hidden="true">' + CHEV_SVG + '</span>'
        : '<span class="mdr-allbar__chev mdr-allbar__chev--back" aria-hidden="true">' + CHEV_SVG + '</span>' +
          '<span class="mdr-allbar__label">Return</span>';

      var list = D.createElement('div');
      list.className = 'mdr-allbar__list';
      if (isHome) {
        var items = [{ t: 'All', u: '/collections/all' }].concat(data);
        for (var i = 0; i < items.length; i++) {
          if (!items[i] || !items[i].u) continue;
          var a = D.createElement('a');
          a.href = items[i].u;
          a.textContent = items[i].t;
          if (items[i].u !== '/' && location.pathname.indexOf(items[i].u) === 0) {
            a.setAttribute('aria-current', 'page');
          }
          list.appendChild(a);
        }
      }

      bar.appendChild(toggle);
      bar.appendChild(list);
      wrap.appendChild(bar);

      /* sit it directly below the header, on every page */
      header.parentNode.insertBefore(wrap, header.nextSibling);

      /* line its label up under the logo, at every breakpoint (the header
         centres its own content on desktop, so a fixed gutter won't do) */
      function alignLeft() {
        var logo = D.querySelector('#header-component a.header-logo') ||
          D.querySelector('a.header-logo');
        if (!logo) return;
        var x = Math.max(0, Math.round(logo.getBoundingClientRect().left));
        wrap.style.paddingInlineStart = x + 'px';
      }
      alignLeft();
      window.addEventListener('resize', alignLeft, { passive: true });
      window.addEventListener('load', alignLeft);

      /* A body-position:fixed page-lock here was expensive (forces a full
         reflow the instant WEBRACK opens -- the mobile lag/freeze) and
         locked the WHOLE page, not just this bar. Dropped entirely: the
         touchzone's own `touch-action: pan-x` (see CSS) already keeps a
         drag on the titles from also scrolling the page, for free, scoped
         to just that gesture -- no page-wide lock needed or wanted. */
      var chev = toggle.querySelector('.mdr-allbar__chev');
      function setOpen(on) {
        bar.classList.toggle('is-open', on);
        toggle.setAttribute('aria-expanded', on ? 'true' : 'false');
        if (chev) chev.innerHTML = on ? '|&lt;|' : CHEV_SVG;
      }
      window.__mdrAllbarOpen = function () { setOpen(true); };

      if (!isHome) {
        /* off the home page this bar IS the back button */
        toggle.setAttribute('aria-label', 'Back');
        toggle.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          if (typeof window.mdrGoBack === 'function') window.mdrGoBack();
          else if (history.length > 1) history.back();
          else location.href = '/';
        });
        return;
      }

      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        setOpen(!bar.classList.contains('is-open'));
      });
      D.addEventListener('click', function (e) {
        /* the drag-catcher is a sibling of the bar (so it can cover the
           whole wrap, escaping the bar's own clip) -- a tap on it fires a
           native click that bubbles here too, and it must NOT count as
           "outside" or every tap would open-then-immediately-close it */
        if (e.target.classList && e.target.classList.contains('mdr-allbar__touchzone')) return;
        if (!bar.contains(e.target)) setOpen(false);
      });

      /* ---------------------------------------------------------------
         Tapping a title in the drop-down never leaves the page: fetch
         that collection, slide the current cards out to the left, and
         slide the new ones in from the right -- in place, on "/".
         --------------------------------------------------------------- */
      var currentUrl = location.pathname + location.search;

      function markCurrent(url) {
        var links = list.querySelectorAll('a');
        for (var i = 0; i < links.length; i++) {
          var href = links[i].getAttribute('href');
          if (href === url) links[i].setAttribute('aria-current', 'page');
          else links[i].removeAttribute('aria-current');
        }
      }

      function findGrid(root) {
        return root.querySelector('.resource-list--grid') ||
          root.querySelector('.resource-list');
      }

      /* Collection pages use Horizon's stock grid (.product-grid > li.product-
         grid__item > product-card), NOT this section's own markup
         (.resource-list--grid > .resource-list__item). <product-card> is the
         one element both share, so pull that and re-wrap it in a fresh
         .resource-list__item -- the shape every rule on this page expects. */
      function extractCards(doc) {
        var containers = ['.resource-list--grid', '.product-grid', '.resource-list'];
        var scope = null;
        for (var i = 0; i < containers.length; i++) {
          scope = doc.querySelector(containers[i]);
          if (scope) break;
        }
        var cards = (scope || doc).querySelectorAll('product-card');
        return cards.length ? cards : null;
      }

      function switchCollection(url, fromPopstate) {
        if (window.__mdrSwitching) return;
        var sec = D.querySelector('[id$="__product_list_fa6P9H"]');
        var frame = sec && sec.querySelector('.mdr-scrollfade');
        var grid = sec && findGrid(sec);
        if (!frame || !grid) { location.href = url; return; }

        if (url === currentUrl) { setOpen(false); return; }

        window.__mdrSwitching = true;
        setOpen(false);

        fetch(url, { credentials: 'same-origin' })
          .then(function (res) {
            if (!res.ok) throw new Error('mdr: bad response');
            return res.text();
          })
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var newCards = extractCards(doc);
            if (!newCards || !newCards.length) throw new Error('mdr: no products found');

            var REDUCE = window.matchMedia &&
              window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var outMs = REDUCE ? 0 : 220;

            frame.classList.add('mdr-swiping-out');

            setTimeout(function () {
              grid.innerHTML = '';
              var frag = D.createDocumentFragment();
              for (var i = 0; i < newCards.length; i++) {
                var item = D.createElement('div');
                item.className = 'resource-list__item';
                item.appendChild(D.importNode(newCards[i], true));
                frag.appendChild(item);
              }
              grid.appendChild(frag);

              currentUrl = url;
              if (!fromPopstate) {
                try { history.pushState({ mdrAllbarUrl: url }, '', url); } catch (e) {}
              }
              markCurrent(url);

              frame.classList.remove('mdr-swiping-out');
              frame.classList.add('mdr-swiping-in');
              setTimeout(function () {
                frame.classList.remove('mdr-swiping-in');
                window.__mdrSwitching = false;
              }, REDUCE ? 0 : 340);
            }, outMs);
          })
          .catch(function () {
            window.__mdrSwitching = false;
            location.href = url;
          });
      }

      list.addEventListener('click', function (e) {
        var a = e.target.closest('a');
        if (!a) return;
        var href = a.getAttribute('href');
        if (!href) return;
        e.preventDefault();
        e.stopPropagation();
        switchCollection(href, false);
      });

      /* Invisible drag-catcher covering the WHOLE wrap (still strictly
         position:absolute inside it -- zero layout footprint, on any page).
         A drag anywhere in it scrolls the title list; a plain tap is
         forwarded to whatever real link/button actually sits underneath, so
         nothing's tap-ability is lost by being covered. */
      var touchzone = D.createElement('div');
      touchzone.className = 'mdr-allbar__touchzone';
      touchzone.setAttribute('aria-hidden', 'true');
      wrap.appendChild(touchzone);

      (function () {
        var THRESHOLD = 6;
        var dragging = false;
        var moved = false;
        var startX = 0;
        var startY = 0;
        var startScroll = 0;

        function point(e) {
          var t = (e.changedTouches && e.changedTouches.length) ? e.changedTouches[0]
            : (e.touches && e.touches.length) ? e.touches[0]
            : e;
          return { x: t.clientX, y: t.clientY };
        }
        function dragStart(e) {
          dragging = true;
          moved = false;
          var p = point(e);
          startX = p.x;
          startY = p.y;
          startScroll = list.scrollLeft;
        }
        function dragMove(e) {
          if (!dragging) return;
          var p = point(e);
          var dx = p.x - startX;
          if (!moved && (Math.abs(dx) > THRESHOLD || Math.abs(p.y - startY) > THRESHOLD)) {
            moved = true;
          }
          if (moved) list.scrollLeft = startScroll - dx;
        }
        function dragEnd(e) {
          if (!dragging) return;
          dragging = false;
          if (moved) return;
          /* a plain tap, not a drag -- pass it through to the real element */
          var p = point(e);
          touchzone.style.pointerEvents = 'none';
          var real = D.elementFromPoint(p.x, p.y);
          touchzone.style.pointerEvents = '';
          var target = real && real.closest ? real.closest('a, button') : null;
          if (target) target.click();
        }

        touchzone.addEventListener('touchstart', dragStart, { passive: true });
        touchzone.addEventListener('pointerdown', dragStart);
        window.addEventListener('touchmove', dragMove, { passive: true });
        window.addEventListener('pointermove', dragMove);
        window.addEventListener('touchend', dragEnd);
        window.addEventListener('pointerup', dragEnd);

        /* the zone now sits on top of the list, so forward desktop
           wheel/trackpad scroll to it too -- otherwise it'd stop dead */
        touchzone.addEventListener('wheel', function (e) {
          list.scrollLeft += Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        }, { passive: true });
      })();

      /* back/forward after an in-place switch: safest correct behaviour is
         a real reload of whatever URL is now in the bar */
      window.addEventListener('popstate', function () {
        if (window.__mdrSwitching) return;
        if (location.pathname + location.search !== currentUrl) location.reload();
      });
    }

    if (D.readyState !== 'loading') build();
    D.addEventListener('DOMContentLoaded', build);
    window.addEventListener('load', build);
    if (window.MutationObserver) {
      new MutationObserver(build).observe(D.body, { childList: true, subtree: true });
    }
  })();

  /* =====================================================================
     Wrap the ALL product grid so a dark-brown edge glow can sit on top of
     the cards (an inset shadow on the grid renders behind them).
     ===================================================================== */
  (function () {
    if (window.__mdrScrollFade) return;
    window.__mdrScrollFade = true;
    var D = document;

    function build() {
      var sec = D.querySelector('[id$="__product_list_fa6P9H"]');
      if (!sec) return;
      var grid = sec.querySelector('.resource-list--grid') ||
        sec.querySelector('.resource-list');
      if (!grid) return;
      if (grid.parentElement &&
          grid.parentElement.classList.contains('mdr-scrollfade')) return;
      var frame = D.createElement('div');
      frame.className = 'mdr-scrollfade';
      grid.parentElement.insertBefore(frame, grid);
      frame.appendChild(grid);
    }

    if (D.readyState !== 'loading') build();
    D.addEventListener('DOMContentLoaded', build);
    window.addEventListener('load', build);
    var m = D.querySelector('main') || D.body;
    if (window.MutationObserver) {
      new MutationObserver(build).observe(m, { childList: true, subtree: true });
    }
  })();

  /* =====================================================================
     Mobile page-zoom toggle -- [+ page] / [- page]. Sits at the bottom of
     the page, on the "Refund policy" line (not floating -- only visible
     once you scroll to the footer). Tapping zooms the whole page by 20%
     (persists while browsing); tap again to go back.
     ===================================================================== */
  (function () {
    if (window.__mdrZoom) return;
    window.__mdrZoom = true;
    var D = document;
    var Z = 1.2;

    function stored() {
      try { return sessionStorage.getItem('mdrZoom') === '1'; } catch (e) { return false; }
    }

    var btn = D.createElement('button');
    btn.className = 'mdr-zoom';
    btn.type = 'button';
    btn.setAttribute('aria-label', 'Zoom the page');
    btn.innerHTML =
      '<span class="mdr-bracket">[</span>' +
      '<span class="mdr-zoom__sign">+</span>' +
      '<span class="mdr-zoom__pg" aria-hidden="true"><i></i><i></i><i></i><i></i></span>' +
      '<span class="mdr-bracket">]</span>';

    function refundLine() {
      var links = D.querySelectorAll('footer a, .footer-utilities a, .footer a');
      for (var i = 0; i < links.length; i++) {
        if (/refund\s*policy/i.test(links[i].textContent)) return links[i];
      }
      return null;
    }

    function place() {
      var line = refundLine();
      var host = btn.parentElement;
      if (!line || !host) return;
      var hr = host.getBoundingClientRect();
      var lr = line.getBoundingClientRect();
      btn.style.top =
        Math.round(lr.top - hr.top + lr.height / 2 - btn.offsetHeight / 2) + 'px';
    }

    function apply(on) {
      try { D.body.style.zoom = on ? Z : ''; } catch (e) {}
      btn.classList.toggle('is-zoomed', on);
      var s = btn.querySelector('.mdr-zoom__sign');
      if (s) s.textContent = on ? '−' : '+';
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      try { sessionStorage.setItem('mdrZoom', on ? '1' : '0'); } catch (e) {}
      requestAnimationFrame(place);
    }

    btn.addEventListener('click', function () { apply(!stored()); });

    function mount() {
      var line = refundLine();
      var host =
        (line && (line.closest('.utilities') || line.closest('.section--page-width'))) ||
        D.querySelector('footer');
      if (!host) return;
      if (btn.parentElement !== host) {
        host.style.position = 'relative';
        btn.style.position = 'absolute';
        btn.style.right = '8px';
        host.appendChild(btn);
      }
      apply(stored());
      place();
    }

    if (D.readyState !== 'loading') mount();
    D.addEventListener('DOMContentLoaded', mount);
    window.addEventListener('load', mount);
    window.addEventListener('resize', place, { passive: true });
    window.addEventListener('scroll', place, { passive: true });
  })();
</script>
