        /* quick/"zappy" -- was 220ms out, 340ms in; a snappier flick
           reads faster and more responsive than a smooth glide */
        var outMs = REDUCE ? 0 : 110;

        /* the old grid starts leaving on the tap itself, not once the new
           one has downloaded -- the network wait now overlaps the swipe-out
           instead of sitting in front of it as a dead pause */
        var outStart = Date.now();
        frame.classList.add('mdr-swiping-out');

        fetchHtml(url)
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var newCards = extractCards(doc);
            var empty = newCards ? null : emptyState(doc);
            if (!newCards && !empty) throw new Error('mdr: no products found');

            setTimeout(function () {
              grid.innerHTML = '';
              var frag = D.createDocumentFragment();
              if (empty) {
                frag.appendChild(D.importNode(empty, true));
              } else {
                for (var i = 0; i < newCards.length; i++) {
                  var item = D.createElement('div');
                  item.className = 'resource-list__item';
                  item.appendChild(D.importNode(newCards[i], true));
                  frag.appendChild(item);
                }
              }
              grid.appendChild(frag);
              /* the full list comes back with its placeholder tiles, as on a
                 fresh page load (categories stay real products only) */
              if (!empty && url.split('?')[0] === allUrl && window.__mdrGridPadFill) window.__mdrGridPadFill();
              if (window.__mdrGridFillRow) window.__mdrGridFillRow();

              currentUrl = url;
              if (!fromPopstate) {
                try { history.pushState({ mdrAllbarUrl: url }, '', url); } catch (e) {}
              }
              markCurrent(url);

              frame.classList.remove('mdr-swiping-out');
              frame.classList.add('mdr-swiping-in');
              setTimeout(function () {
                frame.classList.remove('mdr-swiping-in');
                window.__mdrSwitching = false;
              }, REDUCE ? 0 : 200);
            }, Math.max(0, outMs - (Date.now() - outStart)));
          })
          .catch(function () {
            window.__mdrSwitching = false;
            location.href = url;
          });
      }

      list.addEventListener('click', function (e) {
        var a = e.target.closest('a');
        if (!a) return;
        var href = a.getAttribute('href');
        if (!href) return;
        e.preventDefault();
        e.stopPropagation();
        switchCollection(href, false);
      });

      /* Invisible drag-catcher covering the wrap so a drag anywhere in it
         (background, list items) scrolls the title list; taps that land on
         a real link inside the list still forward through via elementFromPoint
         below. The TOGGLE is the one exception: it's excluded from the zone
         entirely (see positionTouchzone) rather than relying on that
         passthrough for it too. .mdr-allbar__toggle's own z-index:3 looks
         like it should already put it above this z-index:2 zone, but
         z-index only competes among siblings within the SAME stacking
         context -- toggle's is bar's (.mdr-allbar, z-index:1), and bar
         itself is BELOW this zone (a sibling at z-index:2), so the toggle
         was never actually reachable directly no matter its own z-index.
         Taps on it were going through the same elementFromPoint+.click()
         passthrough as everything else -- exactly the indirection the
         "sometimes reloads / general unresponsiveness" fix elsewhere in
         this file was meant to avoid, and the likely cause of that same
         symptom coming back for the open/close tap specifically. */
      var touchzone = D.createElement('div');
      touchzone.className = 'mdr-allbar__touchzone';
      touchzone.setAttribute('aria-hidden', 'true');
      wrap.appendChild(touchzone);

      /* starts right after the toggle (not at a fixed toggle-width offset,
         which assumed the toggle sits at the wrap's own left edge -- on
         desktop the wrap carries frame padding in front of it) */
      function positionTouchzone() {
        touchzone.style.left = (toggle.getBoundingClientRect().right - wrap.getBoundingClientRect().left) + 'px';
      }
      positionTouchzone();
      window.addEventListener('resize', positionTouchzone, { passive: true });
      window.addEventListener('load', positionTouchzone);

      (function () {
        var THRESHOLD = 6;
        var dragging = false;
        var moved = false;
        var startX = 0;
        var startY = 0;
        var startScroll = 0;
        /* momentum: dragging used to set scrollLeft 1:1 with the finger
           and then just stop dead the instant it lifted -- the "hard
           scroll". Tracking recent velocity and gliding it out with
           decay on release makes a flick actually carry on, fast and
           seamless, the way native momentum scrolling feels. */
        var momentumRAF = null;
        var lastX = 0;
        var lastT = 0;
        var velocity = 0;

        function stopMomentum() {
          if (momentumRAF) { cancelAnimationFrame(momentumRAF); momentumRAF = null; }
        }

        /* ---- Detents ------------------------------------------------------
           Every title has one resting point: its left edge on the list's own
           start edge (where ALL sits when the rack opens) -- one rule for
           every title, whatever its length, the viewport or the device.
           While a finger/trackpad/mouse is moving the rack it follows 1:1;
           on release the gesture's position + velocity choose the title and
           settle() carries the rack onto it. This engine is the only thing
           that ever sets the list's position (no CSS scroll-snap, which
           fought the loop's own wrapping). Positions are measured once and
           cached -- again only after a resize or once fonts load. */
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        var snaps = null;
        /* how far a release speed carries: grows faster than the speed
           itself, so a gentle swipe goes to the next title while a hard
           flick runs across several (px, for v in px/ms) */
        function carry(v) {
          var a = Math.abs(v);
          /* never more than one full turn of the rack (every title passes
             once) -- a hard fling shouldn't spin the loop round and round */
          var most = loopWidth > 0 ? loopWidth : Math.max(0, list.scrollWidth - list.clientWidth);
          return (v < 0 ? -1 : 1) * Math.min(150 * a + 40 * a * a, most);
        }
        var DIRECTIONAL = 0.12; /* px/ms: a release faster than this is "going somewhere" */

        function measureSnaps() {
          var links = list.querySelectorAll('a');
          var n = loopWidth > 0 && realCount ? realCount : links.length;
          var lr = list.getBoundingClientRect();
          var origin = list.scrollLeft - lr.left - list.clientLeft;
          var out = [];
          for (var i = 0; i < n && i < links.length; i++) {
            out.push(links[i].getBoundingClientRect().left + origin);
          }
          snaps = out;
        }
        window.addEventListener('resize', function () { snaps = null; }, { passive: true });
        if (D.fonts && D.fonts.ready) D.fonts.ready.then(function () { snaps = null; });

        /* every resting point between a and b (a <= b), in unwrapped
           coordinates -- the loop repeats them every loopWidth */
        function detentsBetween(a, b) {
          if (!snaps) measureSnaps();
          var out = [];
          if (loopWidth > 0) {
            for (var m = Math.floor(a / loopWidth) - 1; m <= Math.floor(b / loopWidth) + 1; m++) {
              for (var i = 0; i < snaps.length; i++) out.push(snaps[i] + m * loopWidth);
            }
          } else {
            var max = Math.max(0, list.scrollWidth - list.clientWidth);
            for (var j = 0; j < snaps.length; j++) if (snaps[j] < max - 1) out.push(snaps[j]);
            out.push(max);
          }
          return out.sort(function (x, y) { return x - y; });
        }

        /* v: px/ms in the scroll direction (+ = further along the list) */
        function pickDetent(pos, v, intent) {
          var projected = pos + carry(v);
          var all = detentsBetween(Math.min(pos, projected), Math.max(pos, projected));
          var best = all[0];
          for (var i = 1; i < all.length; i++) {
            if (Math.abs(all[i] - projected) < Math.abs(best - projected)) best = all[i];
          }
          /* a deliberate swipe always lands at least one title on, in its
             own direction -- never slides back to where it started */
          if (intent && v > 0 && best <= pos + 1) {
            for (var a = 0; a < all.length; a++) if (all[a] > pos + 1) { best = all[a]; break; }
          } else if (intent && v < 0 && best >= pos - 1) {
            for (var b = all.length - 1; b >= 0; b--) if (all[b] < pos - 1) { best = all[b]; break; }
          }
          return best;
        }

        function setListPos(p) {
          if (loopWidth > 0) p = ((p % loopWidth) + loopWidth) % loopWidth;
          list.scrollLeft = p;
        }

        /* One short curve from the release to the detent: it leaves at the
           gesture's own speed (no jolt when the finger lifts) and arrives at
           exactly zero speed on the resting point -- a quick glide, then a
           firm, precise stop. Speed is capped so it can never run past the
           title and come back: no bounce, no overshoot. Reduced motion: it
           simply lands. */
        function settle(from, to, v0) {
          stopMomentum();
          var dist = to - from;
          if (Math.abs(dist) < 0.5 || reduceMotion.matches) { setListPos(to); atRest(to); return; }
          var v = v0 * dist > 0 ? v0 : 0;
          var T = Math.abs(v) > 0.05 ? 2 * Math.abs(dist) / Math.abs(v) : 170 + Math.sqrt(Math.abs(dist)) * 9;
          T = Math.max(160, Math.min(620, T));
          if (Math.abs(v) * T > 2.6 * Math.abs(dist)) v = (v > 0 ? 1 : -1) * 2.6 * Math.abs(dist) / T;
          var m0 = v * T;
          var t0 = null;
          function frame(ts) {
            if (t0 === null) t0 = ts;
            var t = Math.min(1, (ts - t0) / T);
            var t2 = t * t, t3 = t2 * t;
            /* cubic Hermite: start at `from` with speed v, end at `to` at rest */
            setListPos((2 * t3 - 3 * t2 + 1) * from + (t3 - 2 * t2 + t) * m0 + (3 * t2 - 2 * t3) * to);
            if (t < 1) momentumRAF = requestAnimationFrame(frame);
            else { momentumRAF = null; atRest(to); }
          }
          momentumRAF = requestAnimationFrame(frame);
        }

        /* the rack has come to rest on a title: start loading that
           collection, so tapping it switches without a wait */
        function atRest(pos) {
          if (!snaps) return;
          var at = loopWidth > 0 ? ((pos % loopWidth) + loopWidth) % loopWidth : pos;
          var links = list.querySelectorAll('a');
          for (var i = 0; i < snaps.length && i < links.length; i++) {
            if (Math.abs(snaps[i] - at) < 1) {
              var href = links[i].getAttribute('href');
              if (href && href !== currentUrl) fetchHtml(href);
              return;
            }
          }
        }

        function settleFrom(v, intent) {
          if (!bar.classList.contains('is-open')) return;
          var pos = list.scrollLeft;
          settle(pos, pickDetent(pos, v, intent), v);
        }

