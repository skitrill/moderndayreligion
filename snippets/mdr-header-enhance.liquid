{%- doc -%}
  MDR header / scroll enhancements (custom, non-Horizon).

  - [bottom]: a tiny text control under the cart in the header bar. Scrolls to the
    last product on the page with a snappy "windy" easing.
  - [top]: a tiny fixed control pinned to the bottom-right of the viewport that
    fades in on scroll. Scrolls back to the first product / top of the page.
    Built in JS and appended to <body> so it stays viewport-fixed.

  Styles live in assets/mdr-custom.css (loaded from <head>). This snippet is
  rendered once from the `actions` capture in sections/header.liquid.
{%- enddoc -%}

<div class="mdr-jump-wrap" data-mdr-jump>
  <a
    href="#"
    class="mdr-jump mdr-jump--bottom"
    role="button"
    aria-label="Jump to bottom"
  >
    <span class="mdr-bracket">[</span>
    <svg class="mdr-arrow" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true" focusable="false">
      <path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="mdr-bracket">]</span>
  </a>
</div>

<script>
  (function () {
    if (window.__mdrHeaderEnhance) return;
    window.__mdrHeaderEnhance = true;

    var D = document;
    var botBtn = null;
    var topBtn = null;
    var REDUCE = window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var glideRAF = null;
    var glideDetach = null;

    function scrollTop() {
      return window.scrollY || window.pageYOffset || D.documentElement.scrollTop || 0;
    }

    function maxScroll() {
      return Math.max(0, D.documentElement.scrollHeight - window.innerHeight);
    }

    /* Fast launch, long soft glide to a stop (yeezy-style momentum). */
    function easeOutExpo(p) {
      return p >= 1 ? 1 : 1 - Math.pow(2, -10 * p);
    }

    /* Windy + snappy: eased travel you can see, bailing out the moment the
       user grabs the page back with a wheel / swipe / nav key. */
    function glideScroll(targetY, btn) {
      targetY = Math.max(0, Math.min(targetY, maxScroll()));
      var startY = scrollTop();
      var dist = targetY - startY;

      if (glideRAF) { cancelAnimationFrame(glideRAF); glideRAF = null; }
      if (glideDetach) glideDetach();

      if (REDUCE || Math.abs(dist) < 2) {
        window.scrollTo(0, targetY);
        zap(btn);
        return;
      }

      D.documentElement.style.scrollBehavior = 'auto';
      var dur = Math.max(430, Math.min(880, 300 + Math.abs(dist) * 0.16));
      var t0 = null;
      var stopped = false;

      function detach() {
        window.removeEventListener('wheel', bail);
        window.removeEventListener('touchstart', bail);
        window.removeEventListener('keydown', onKey);
        glideDetach = null;
      }
      function bail() {
        stopped = true;
        if (glideRAF) { cancelAnimationFrame(glideRAF); glideRAF = null; }
        detach();
      }
      function onKey(e) {
        if (/^(Arrow|Page)/.test(e.key) || e.key === 'Home' ||
            e.key === 'End' || e.key === ' ') {
          bail();
        }
      }
      window.addEventListener('wheel', bail, { passive: true });
      window.addEventListener('touchstart', bail, { passive: true });
      window.addEventListener('keydown', onKey);
      glideDetach = detach;

      function step(now) {
        if (stopped) return;
        if (t0 === null) t0 = now;
        var p = Math.min(1, (now - t0) / dur);
        window.scrollTo(0, Math.round(startY + dist * easeOutExpo(p)));
        if (p < 1) {
          glideRAF = requestAnimationFrame(step);
        } else {
          glideRAF = null;
          detach();
          zap(btn);
        }
      }
      glideRAF = requestAnimationFrame(step);
    }

    function headerOffset() {
      var raw = getComputedStyle(D.body).getPropertyValue('--header-height').trim();
      var n = parseFloat(raw);
      return (isNaN(n) ? 60 : n) + 10;
    }

    function productCards() {
      return Array.prototype.slice.call(D.querySelectorAll('product-card, .product-card'));
    }

    function zap(el) {
      if (!el) return;
      el.classList.remove('mdr-zap');
      void el.offsetWidth;
      el.classList.add('mdr-zap');
    }

    function goTop() {
      var now = scrollTop();
      var first = productCards()[0];
      var y = first ? first.getBoundingClientRect().top + now - headerOffset() : 0;
      /* never jump downward -- fall back to the very top */
      if (y >= now - 2) y = 0;
      glideScroll(y, topBtn);
    }

    function goBottom() {
      var now = scrollTop();
      var cards = productCards();
      var last = cards[cards.length - 1];
      var y = last
        ? last.getBoundingClientRect().bottom + now - window.innerHeight + 24
        : maxScroll();
      /* never jump upward -- fall back to the page bottom */
      if (y <= now + 2) y = maxScroll();
      glideScroll(y, botBtn);
    }

    /* Build the fixed [top] control and pin it to <body> */
    function ensureTopButton() {
      if (topBtn && topBtn.isConnected && topBtn.parentNode === D.body) return;
      topBtn = D.querySelector('.mdr-scrolltop');
      if (!topBtn) {
        topBtn = D.createElement('button');
        topBtn.type = 'button';
        topBtn.className = 'mdr-scrolltop';
        topBtn.setAttribute('aria-label', 'Jump to top');
        topBtn.innerHTML =
          '<span class="mdr-bracket">[</span>' +
          '<svg class="mdr-arrow" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true" focusable="false">' +
          '<path d="M1 6.5 6 1.5l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>' +
          '</svg><span class="mdr-bracket">]</span>';
        topBtn.addEventListener('click', function (e) {
          e.preventDefault();
          goTop();
        });
      }
      if (topBtn.parentNode !== D.body) D.body.appendChild(topBtn);
    }

    function updateVisibility() {
      var y = scrollTop();
      var maxY = maxScroll();
      var atBottom = maxY > 40 && y >= maxY - 4;
      if (topBtn) topBtn.classList.toggle('mdr-visible', y > 80 || atBottom);
      /* only dim [v] when there is real scroll room AND we're near the end */
      if (botBtn) botBtn.classList.toggle('mdr-off', maxY > 260 && y > maxY - 140);
    }

    function wireBottom() {
      var wrap = D.querySelector('[data-mdr-jump]');
      if (!wrap) return;
      botBtn = wrap.querySelector('.mdr-jump--bottom');
      if (botBtn && !botBtn.__mdrWired) {
        botBtn.__mdrWired = true;
        botBtn.addEventListener('click', function (e) {
          e.preventDefault();
          goBottom();
        });
      }
    }

    /* Line the [v] control's right edge up with the CART link, whatever the
       viewport / page gutter is. */
    function syncCartEdge() {
      var cart =
        D.querySelector('.header__cart-link') ||
        D.querySelector('.header__column--right .action__cart') ||
        D.querySelector('.header__column--right a[href*="/cart"]');
      if (!cart) return;
      var right = cart.getBoundingClientRect().right;
      var fromEdge = Math.max(0, Math.round(D.documentElement.clientWidth - right));
      D.documentElement.style.setProperty('--mdr-cart-right', fromEdge + 'px');
    }

    function init() {
      ensureTopButton();
      wireBottom();
      syncCartEdge();
      updateVisibility();
    }

    /* Catch scrolling regardless of which node emits the event */
    window.addEventListener('scroll', updateVisibility, { passive: true });
    D.addEventListener('scroll', updateVisibility, { passive: true, capture: true });
    window.addEventListener('resize', function () {
      syncCartEdge();
      updateVisibility();
    }, { passive: true });

    if (D.readyState !== 'loading') init();
    D.addEventListener('DOMContentLoaded', init);
    window.addEventListener('load', init);

    /* Re-wire / re-pin after Horizon section hydration swaps header DOM */
    var hc = D.querySelector('#header-component');
    if (hc && window.MutationObserver) {
      new MutationObserver(init).observe(hc, { childList: true, subtree: true });
    }
  })();
</script>
