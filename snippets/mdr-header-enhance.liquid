{%- doc -%}
  MDR header / scroll enhancements (custom, non-Horizon).

  - [bottom]: a tiny text control under the cart in the header bar. Scrolls to the
    last product on the page with a snappy "windy" easing.
  - [top]: a tiny fixed control pinned to the bottom-right of the viewport that
    fades in on scroll. Scrolls back to the first product / top of the page.
    Built in JS and appended to <body> so it stays viewport-fixed.

  Styles live in assets/mdr-custom.css (loaded from <head>). This snippet is
  rendered once from the `actions` capture in sections/header.liquid.
{%- enddoc -%}

<div class="mdr-jump-wrap" data-mdr-jump>
  <a
    href="#"
    class="mdr-jump mdr-jump--bottom"
    role="button"
    aria-label="Jump to bottom"
  >
    <span class="mdr-bracket">[</span>
    <svg class="mdr-arrow" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true" focusable="false">
      <path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="mdr-bracket">]</span>
  </a>
</div>

{%- comment -%} Collection titles for the [ALL >] bar (read by __mdrAllBar). {%- endcomment -%}
<script type="application/json" id="mdr-allbar-data">
[
{%- assign _mdr_n = 0 -%}
{%- for collection in collections limit: 24 -%}
  {%- assign _h = collection.handle -%}
  {%- unless _h == 'all' or _h == 'frontpage' or collection.all_products_count == 0 -%}
    {%- if _mdr_n > 0 -%},{%- endif -%}
    {"t": {{ collection.title | json }}, "u": {{ collection.url | json }}}
    {%- assign _mdr_n = _mdr_n | plus: 1 -%}
  {%- endunless -%}
{%- endfor -%}
]
</script>

<script>
  (function () {
    if (window.__mdrHeaderEnhance) return;
    window.__mdrHeaderEnhance = true;

    var D = document;
    var botBtn = null;
    var topBtn = null;
    var REDUCE = window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var glideRAF = null;
    var glideDetach = null;

    function scrollTop() {
      return window.scrollY || window.pageYOffset || D.documentElement.scrollTop || 0;
    }

    function maxScroll() {
      return Math.max(0, D.documentElement.scrollHeight - window.innerHeight);
    }

    /* Fast launch, long soft glide to a stop (yeezy-style momentum). */
    function easeOutExpo(p) {
      return p >= 1 ? 1 : 1 - Math.pow(2, -10 * p);
    }

    /* Windy + snappy: eased travel you can see, bailing out the moment the
       user grabs the page back with a wheel / swipe / nav key. */
    function glideScroll(targetY, btn) {
      targetY = Math.max(0, Math.min(targetY, maxScroll()));
      var startY = scrollTop();
      var dist = targetY - startY;

      if (glideRAF) { cancelAnimationFrame(glideRAF); glideRAF = null; }
      if (glideDetach) glideDetach();

      if (REDUCE || Math.abs(dist) < 2) {
        window.scrollTo(0, targetY);
        zap(btn);
        return;
      }

      D.documentElement.style.scrollBehavior = 'auto';
      var dur = Math.max(430, Math.min(880, 300 + Math.abs(dist) * 0.16));
      var t0 = null;
      var stopped = false;

      function detach() {
        window.removeEventListener('wheel', bail);
        window.removeEventListener('touchstart', bail);
        window.removeEventListener('keydown', onKey);
        glideDetach = null;
      }
      function bail() {
        stopped = true;
        if (glideRAF) { cancelAnimationFrame(glideRAF); glideRAF = null; }
        detach();
      }
      function onKey(e) {
        if (/^(Arrow|Page)/.test(e.key) || e.key === 'Home' ||
            e.key === 'End' || e.key === ' ') {
          bail();
        }
      }
      window.addEventListener('wheel', bail, { passive: true });
      window.addEventListener('touchstart', bail, { passive: true });
      window.addEventListener('keydown', onKey);
      glideDetach = detach;

      function step(now) {
        if (stopped) return;
        if (t0 === null) t0 = now;
        var p = Math.min(1, (now - t0) / dur);
        window.scrollTo(0, Math.round(startY + dist * easeOutExpo(p)));
        if (p < 1) {
          glideRAF = requestAnimationFrame(step);
        } else {
          glideRAF = null;
          detach();
          zap(btn);
        }
      }
      glideRAF = requestAnimationFrame(step);
    }

    function headerOffset() {
      var raw = getComputedStyle(D.body).getPropertyValue('--header-height').trim();
      var n = parseFloat(raw);
      return (isNaN(n) ? 60 : n) + 10;
    }

    function productCards() {
      return Array.prototype.slice.call(D.querySelectorAll('product-card, .product-card'));
    }

    function zap(el) {
      if (!el) return;
      el.classList.remove('mdr-zap');
      void el.offsetWidth;
      el.classList.add('mdr-zap');
    }

    function goTop() {
      var now = scrollTop();
      var first = productCards()[0];
      var y = first ? first.getBoundingClientRect().top + now - headerOffset() : 0;
      /* never jump downward -- fall back to the very top */
      if (y >= now - 2) y = 0;
      glideScroll(y, topBtn);
    }

    function goBottom() {
      var now = scrollTop();
      var cards = productCards();
      var last = cards[cards.length - 1];
      var y = last
        ? last.getBoundingClientRect().bottom + now - window.innerHeight + 24
        : maxScroll();
      /* never jump upward -- fall back to the page bottom */
      if (y <= now + 2) y = maxScroll();
      glideScroll(y, botBtn);
    }

    /* Build the fixed [top] control and pin it to <body> */
    function ensureTopButton() {
      if (topBtn && topBtn.isConnected && topBtn.parentNode === D.body) return;
      topBtn = D.querySelector('.mdr-scrolltop');
      if (!topBtn) {
        topBtn = D.createElement('button');
        topBtn.type = 'button';
        topBtn.className = 'mdr-scrolltop';
        topBtn.setAttribute('aria-label', 'Jump to top');
        topBtn.innerHTML =
          '<span class="mdr-bracket">[</span>' +
          '<svg class="mdr-arrow" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true" focusable="false">' +
          '<path d="M1 6.5 6 1.5l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>' +
          '</svg><span class="mdr-bracket">]</span>';
        topBtn.addEventListener('click', function (e) {
          e.preventDefault();
          goTop();
        });
      }
      if (topBtn.parentNode !== D.body) D.body.appendChild(topBtn);
    }

    function updateVisibility() {
      var y = scrollTop();
      var maxY = maxScroll();
      var atBottom = maxY > 40 && y >= maxY - 4;
      if (topBtn) topBtn.classList.toggle('mdr-visible', y > 80 || atBottom);
      /* only dim [v] when there is real scroll room AND we're near the end */
      if (botBtn) botBtn.classList.toggle('mdr-off', maxY > 260 && y > maxY - 140);
    }

    function wireBottom() {
      var wrap = D.querySelector('[data-mdr-jump]');
      if (!wrap) return;
      botBtn = wrap.querySelector('.mdr-jump--bottom');
      if (botBtn && !botBtn.__mdrWired) {
        botBtn.__mdrWired = true;
        botBtn.addEventListener('click', function (e) {
          e.preventDefault();
          goBottom();
        });
      }
    }

    /* Line the [v] control's right edge up with the CART link, whatever the
       viewport / page gutter is. */
    function syncCartEdge() {
      var cart =
        D.querySelector('.header__cart-link') ||
        D.querySelector('.header__column--right .action__cart') ||
        D.querySelector('.header__column--right a[href*="/cart"]');
      if (!cart) return;
      var right = cart.getBoundingClientRect().right;
      var fromEdge = Math.max(0, Math.round(D.documentElement.clientWidth - right));
      D.documentElement.style.setProperty('--mdr-cart-right', fromEdge + 'px');
    }

    function init() {
      ensureTopButton();
      wireBottom();
      syncCartEdge();
      updateVisibility();
    }

    /* Catch scrolling regardless of which node emits the event */
    window.addEventListener('scroll', updateVisibility, { passive: true });
    D.addEventListener('scroll', updateVisibility, { passive: true, capture: true });
    window.addEventListener('resize', function () {
      syncCartEdge();
      updateVisibility();
    }, { passive: true });

    if (D.readyState !== 'loading') init();
    D.addEventListener('DOMContentLoaded', init);
    window.addEventListener('load', init);

    /* Re-wire / re-pin after Horizon section hydration swaps header DOM */
    var hc = D.querySelector('#header-component');
    if (hc && window.MutationObserver) {
      new MutationObserver(init).observe(hc, { childList: true, subtree: true });
    }
  })();

  /* =====================================================================
     Homepage featured grid: dense 8x8 (reached ONLY by tapping the logo)
     <-> "zoom" view of 2 cols on mobile / 4 on desktop (default; also what
     a tap anywhere on the dense layout returns you to). The HOME link --
     or anything else -- never brings the 8x8 back.
     ===================================================================== */
  (function () {
    if (window.__mdrFeaturedGrid) return;
    window.__mdrFeaturedGrid = true;

    var D = document;
    var root = D.documentElement;
    var KEY = 'mdrFeaturedView'; /* 'grid8' | 'zoom' */

    function read() {
      try { return sessionStorage.getItem(KEY) === 'grid8' ? 'grid8' : 'zoom'; }
      catch (e) { return 'zoom'; }
    }
    function write(v) {
      try { sessionStorage.setItem(KEY, v); } catch (e) {}
    }
    function apply(v, animate) {
      root.setAttribute('data-featured', v);
      if (animate) {
        root.classList.remove('mdr-featured-anim');
        void root.offsetWidth;
        root.classList.add('mdr-featured-anim');
        setTimeout(function () { root.classList.remove('mdr-featured-anim'); }, 400);
      }
    }
    function setView(v, animate) {
      write(v);
      apply(v, animate);
      padFill(v);
    }

    /* reflect stored state as early as possible */
    apply(read(), false);

    function featured() {
      return D.querySelector('[id$="__product_list_fa6P9H"]');
    }

    /* TEMP: only 3 products -- clone the tiles so the 8x8 (and the zoom
       view) look full while we test. Clones are inert + tagged
       [data-mdr-clone]; delete this block + its 2 calls when done. */
    function padFill(mode) {
      var sec = featured();
      if (!sec) return;
      var grid = sec.querySelector('.resource-list--grid') || sec.querySelector('.resource-list');
      if (!grid) return;

      var clones = grid.querySelectorAll('[data-mdr-clone]');
      for (var c = clones.length - 1; c >= 0; c--) clones[c].remove();

      var originals = [];
      var kids = grid.children;
      for (var k = 0; k < kids.length; k++) {
        if (!kids[k].hasAttribute('data-mdr-clone')) originals.push(kids[k]);
      }
      if (!originals.length) return;

      var target = mode === 'grid8' ? 64 : 24;
      var need = target - originals.length;
      if (need <= 0) return;

      var frag = D.createDocumentFragment();
      for (var i = 0; i < need; i++) {
        var node = originals[i % originals.length].cloneNode(true);
        node.setAttribute('data-mdr-clone', '');
        node.style.pointerEvents = 'none';
        var pc = node.querySelector('product-card');
        if (pc) {
          pc.removeAttribute('on:click');
          pc.removeAttribute('id');
        }
        var links = node.querySelectorAll('a');
        for (var l = 0; l < links.length; l++) links[l].removeAttribute('href');
        frag.appendChild(node);
      }
      grid.appendChild(frag);
    }

    /* Tap anywhere on the dense layout -> zoom out to 2/4. Only active while
       dense; in "zoom" view, card taps navigate to the product as normal.
       The WEBRACK bar counts too: a tap on it while dense zooms out (its
       drop-down toggle only runs in the zoomed-in view). */
    D.addEventListener('click', function (e) {
      if (read() !== 'grid8') return;
      var sec = featured();
      if (!sec || !sec.contains(e.target)) return;
      e.preventDefault();
      e.stopPropagation();
      setView('zoom', true);
      /* a tap on the WEBRACK bar zooms out AND opens its drop-down */
      if (e.target.closest && e.target.closest('.mdr-allbar-wrap') &&
          typeof window.__mdrAllbarOpen === 'function') {
        window.__mdrAllbarOpen();
      }
    }, true);

    /* The logo is the ONLY control that brings back the dense 8x8. */
    function wireLogo() {
      var logo = D.querySelector('a.header-logo');
      if (!logo || logo.__mdrFeaturedWired) return;
      logo.__mdrFeaturedWired = true;
      logo.addEventListener('click', function (e) {
        var onHome = location.pathname === '/' || location.pathname === '';
        write('grid8');
        if (onHome) {
          e.preventDefault();
          e.stopPropagation();
          apply('grid8', true);
          window.scrollTo(0, 0);
        }
        /* off-home: allow navigation to "/"; it will load in dense mode */
      }, true);
    }

    function boot() {
      wireLogo();
      padFill(read());
    }

    boot();
    if (D.readyState !== 'loading') boot();
    D.addEventListener('DOMContentLoaded', boot);
    window.addEventListener('load', boot);
    if (window.MutationObserver) {
      new MutationObserver(wireLogo).observe(
        D.querySelector('#header-component') || D.body,
        { childList: true, subtree: true }
      );
    }
  })();

  /* =====================================================================
     Header menu -> a compact "USER" dropdown under the caret.
     Everything but the account link is stripped (in CSS); here we rename
     it, drop the scroll-lock, and close it on an outside tap.
     ===================================================================== */
  (function () {
    if (window.__mdrHeaderMenu) return;
    window.__mdrHeaderMenu = true;
    var D = document;

    function tidy() {
      var det = D.getElementById('Details-menu-drawer-container');
      if (!det) return;
      det.removeAttribute('scroll-lock');

      var acct = det.querySelector('.menu-drawer__menu-item[href*="/account"], a[href*="/account"]');
      if (acct && acct.textContent.trim().toLowerCase() === 'account') {
        acct.textContent = 'User';
      }

      if (!det.__mdrWired) {
        det.__mdrWired = true;
        det.addEventListener('toggle', function () {
          if (!det.open) return;
          det.removeAttribute('scroll-lock');
          D.documentElement.style.overflow = '';
          D.body.style.overflow = '';
        });
        D.addEventListener('click', function (e) {
          if (det.open && !det.contains(e.target)) det.open = false;
        }, true);
      }
    }

    if (D.readyState !== 'loading') tidy();
    D.addEventListener('DOMContentLoaded', tidy);
    window.addEventListener('load', tidy);
    var hc = D.querySelector('#header-component');
    if (hc && window.MutationObserver) {
      new MutationObserver(tidy).observe(hc, { childList: true, subtree: true });
    }
  })();

  /* =====================================================================
     Home ("ALL") gets its own layout: a red navbar above the grid.
     ===================================================================== */
  (function () {
    if (window.__mdrHomeNav) return;
    window.__mdrHomeNav = true;
    var D = document;

    var LINKS = [
      ['All', '/'],
      ['Tops', '/collections/tops-t-shirts'],
      ['Lookbook', '/pages/lookbook']
    ];

    function build() {
      var main = D.querySelector('main[data-template="index"]');
      if (!main || D.querySelector('.mdr-home-nav')) return;

      var nav = D.createElement('nav');
      nav.className = 'mdr-home-nav';
      nav.setAttribute('aria-label', 'Shop');
      for (var i = 0; i < LINKS.length; i++) {
        var a = D.createElement('a');
        a.href = LINKS[i][1];
        a.textContent = LINKS[i][0];
        if (
          (LINKS[i][1] === '/' && (location.pathname === '/' || location.pathname === '')) ||
          (LINKS[i][1] !== '/' && location.pathname.indexOf(LINKS[i][1]) === 0)
        ) {
          a.setAttribute('aria-current', 'page');
        }
        nav.appendChild(a);
      }
      main.insertBefore(nav, main.firstChild);
    }

    if (D.readyState !== 'loading') build();
    D.addEventListener('DOMContentLoaded', build);
    window.addEventListener('load', build);
    var m = D.querySelector('main') || D.body;
    if (window.MutationObserver) {
      new MutationObserver(build).observe(m, { childList: true });
    }
  })();

  /* =====================================================================
     [ALL >] bar: a collapsed red pill above the grid. Tap it and it slides
     open to the right, revealing the collection titles. Tap again -- or
     tap anywhere outside -- to collapse it back to [ALL >].
     ===================================================================== */
  (function () {
    if (window.__mdrAllBar) return;
    window.__mdrAllBar = true;
    var D = document;

    function collections() {
      var el = D.getElementById('mdr-allbar-data');
      if (!el) return [];
      try { return JSON.parse(el.textContent) || []; } catch (e) { return []; }
    }

    function build() {
      var main = D.querySelector('main[data-template="index"]');
      if (!main) return;
      var sec = D.querySelector('[id$="__product_list_fa6P9H"]');
      if (!sec || !sec.parentNode || D.querySelector('.mdr-allbar-wrap')) return;

      var data = collections();

      var wrap = D.createElement('div');
      wrap.className = 'mdr-allbar-wrap';

      var bar = D.createElement('div');
      bar.className = 'mdr-allbar';

      var toggle = D.createElement('button');
      toggle.type = 'button';
      toggle.className = 'mdr-allbar__toggle';
      toggle.setAttribute('aria-expanded', 'false');
      toggle.innerHTML =
        '<span class="mdr-allbar__label">Webrack</span>' +
        '<span class="mdr-allbar__chev" aria-hidden="true">»</span>';

      var list = D.createElement('div');
      list.className = 'mdr-allbar__list';
      var items = [{ t: 'All', u: '/collections/all' }].concat(data);
      for (var i = 0; i < items.length; i++) {
        if (!items[i] || !items[i].u) continue;
        var a = D.createElement('a');
        a.href = items[i].u;
        a.textContent = items[i].t;
        if (items[i].u !== '/' && location.pathname.indexOf(items[i].u) === 0) {
          a.setAttribute('aria-current', 'page');
        }
        list.appendChild(a);
      }

      bar.appendChild(toggle);
      bar.appendChild(list);
      wrap.appendChild(bar);

      /* drop the bar into the exact slot of the "ALL" section title
         (the heading text itself is hidden in CSS) */
      var header = sec.querySelector('.section-resource-list__header');
      if (header) {
        header.insertBefore(wrap, header.firstChild);
      } else {
        sec.parentNode.insertBefore(wrap, sec);
      }

      /* Anchor the bar to the grid box ONCE, using the zoomed-in (default)
         view as the single reference. We deliberately never re-measure for
         the dense view or mid-animation -- that is what made the bar jump
         around on every toggle. It only re-aligns on viewport resize. */
      function align() {
        if (D.documentElement.getAttribute('data-featured') === 'grid8') return;
        if (D.documentElement.classList.contains('mdr-featured-anim')) return;
        var grid = sec.querySelector('.resource-list--grid') ||
          sec.querySelector('.resource-list');
        if (!grid || getComputedStyle(grid).transform !== 'none') return;
        var gr = grid.getBoundingClientRect();
        var pr = wrap.parentNode.getBoundingClientRect();
        if (!gr.width) return;
        wrap.style.width = Math.round(gr.width) + 'px';
        wrap.style.maxWidth = 'none';
        wrap.style.marginLeft = Math.round(gr.left - pr.left) + 'px';
        wrap.style.marginRight = '0';
      }
      align();
      window.addEventListener('load', align);
      window.addEventListener('resize', align, { passive: true });

      var chev = toggle.querySelector('.mdr-allbar__chev');
      function setOpen(on) {
        bar.classList.toggle('is-open', on);
        toggle.setAttribute('aria-expanded', on ? 'true' : 'false');
        if (chev) chev.textContent = on ? '|<|' : '»';
      }
      /* let the dense-view tap handler open the drop-down after it zooms out */
      window.__mdrAllbarOpen = function () { setOpen(true); };

      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        setOpen(!bar.classList.contains('is-open'));
      });
      D.addEventListener('click', function (e) {
        if (!bar.contains(e.target)) setOpen(false);
      });
    }

    if (D.readyState !== 'loading') build();
    D.addEventListener('DOMContentLoaded', build);
    window.addEventListener('load', build);
    var m = D.querySelector('main') || D.body;
    if (window.MutationObserver) {
      new MutationObserver(build).observe(m, { childList: true });
    }
  })();

  /* =====================================================================
     Mobile page-zoom toggle -- [+ page] / [- page]. Sits at the bottom of
     the page, on the "Refund policy" line (not floating -- only visible
     once you scroll to the footer). Tapping zooms the whole page by 20%
     (persists while browsing); tap again to go back.
     ===================================================================== */
  (function () {
    if (window.__mdrZoom) return;
    window.__mdrZoom = true;
    var D = document;
    var Z = 1.2;

    function stored() {
      try { return sessionStorage.getItem('mdrZoom') === '1'; } catch (e) { return false; }
    }

    var btn = D.createElement('button');
    btn.className = 'mdr-zoom';
    btn.type = 'button';
    btn.setAttribute('aria-label', 'Zoom the page');
    btn.innerHTML =
      '<span class="mdr-bracket">[</span>' +
      '<span class="mdr-zoom__sign">+</span>' +
      '<span class="mdr-zoom__pg" aria-hidden="true"><i></i><i></i><i></i><i></i></span>' +
      '<span class="mdr-bracket">]</span>';

    function refundLine() {
      var links = D.querySelectorAll('footer a, .footer-utilities a, .footer a');
      for (var i = 0; i < links.length; i++) {
        if (/refund\s*policy/i.test(links[i].textContent)) return links[i];
      }
      return null;
    }

    function place() {
      var line = refundLine();
      var host = btn.parentElement;
      if (!line || !host) return;
      var hr = host.getBoundingClientRect();
      var lr = line.getBoundingClientRect();
      /* line the button's optical centre onto the text baseline of the line.
         It's position:absolute in the footer, so it only comes into view
         when you reach the bottom of the page (or immediately, on a short
         page) -- it never floats over content. */
      btn.style.top =
        Math.round(lr.top - hr.top + lr.height / 2 - btn.offsetHeight / 2) + 'px';
    }

    function apply(on) {
      try { D.body.style.zoom = on ? Z : ''; } catch (e) {}
      btn.classList.toggle('is-zoomed', on);
      var s = btn.querySelector('.mdr-zoom__sign');
      if (s) s.textContent = on ? '−' : '+';
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      try { sessionStorage.setItem('mdrZoom', on ? '1' : '0'); } catch (e) {}
      requestAnimationFrame(place);
    }

    btn.addEventListener('click', function () { apply(!stored()); });

    function mount() {
      var line = refundLine();
      var host =
        (line && (line.closest('.utilities') || line.closest('.section--page-width'))) ||
        D.querySelector('footer');
      if (!host) return;
      if (btn.parentElement !== host) {
        host.style.position = 'relative';
        btn.style.position = 'absolute';
        btn.style.right = '8px';
        host.appendChild(btn);
      }
      apply(stored());
      place();
    }

    if (D.readyState !== 'loading') mount();
    D.addEventListener('DOMContentLoaded', mount);
    window.addEventListener('load', mount);
    window.addEventListener('resize', place, { passive: true });
    window.addEventListener('scroll', place, { passive: true });
  })();
</script>
