      if (!isHome) {
        /* off the home page this bar IS the back button */
        toggle.setAttribute('aria-label', 'Back');
        toggle.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          /* RETURN never "opens" anything -- .mdr-allbar-wrap--zap here is
             a one-shot flourish, not a persistent state toggle: play the
             same zip transition (mdr-custom.css), reversed direction by
             construction (buildLinePath's RETURN path starts at the
             LABEL end, WEBRACK's starts at the OUTER end -- see that
             function's own comment), then actually navigate once there's
             been enough time to SEE the zip start, not zero. A plain,
             un-delayed history.back() would swap the page out the same
             tick the class gets added -- the browser never gets a chance
             to paint a single animated frame before the transition target
             page starts loading. 60ms: enough for the zip's first
             frames to visibly start, without holding the navigation
             itself back -- the previous page comes from the browser's
             cache (see mdrGoBack, layout/theme.liquid), so the rest of
             the zip plays out while it's already coming back. */
          wrap.classList.add('mdr-allbar-wrap--zap');
          setTimeout(function () {
            if (typeof window.mdrGoBack === 'function') window.mdrGoBack();
            else if (history.length > 1) history.back();
            else location.href = '/';
          }, 60);
        });
        return;
      }

      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        setOpen(!bar.classList.contains('is-open'));
      });
      D.addEventListener('click', function (e) {
        /* the drag-catcher is a sibling of the bar (so it can cover the
           whole wrap, escaping the bar's own clip) -- a tap on it fires a
           native click that bubbles here too, and it must NOT count as
           "outside" or every tap would open-then-immediately-close it */
        if (e.target.classList && e.target.classList.contains('mdr-allbar__touchzone')) return;
        if (bar.contains(e.target)) return;
        /* tapping a real link elsewhere on the page while WEBRACK is open
           (a product card, a footer link) navigates away immediately --
           the normal animated collapse never gets time to actually play
           before the page unloads, so it was landing mid-animation right
           as the page's own view-transition snapshot gets taken, which
           read as a stutter/lag "bug" during the transition out. Nothing
           to animate toward if the page is leaving anyway -- close
           instantly instead of racing the navigation. */
        var navLink = e.target.closest && e.target.closest('a[href]');
        if (navLink) {
          /* moved from `bar` to `wrap`: .mdr-allbar__line now lives as a
             sibling of `bar`, not inside it, so a class added only to
             `bar` never reached it via the existing ".mdr-allbar--instant
             *" descendant selector -- the line would still animate its
             zip-closed transition while the page was already navigating
             away, the exact stutter this instant-close path exists to
             prevent. Adding it to `wrap` instead reaches both. */
          wrap.classList.add('mdr-allbar--instant');
          setOpen(false);
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              wrap.classList.remove('mdr-allbar--instant');
            });
          });
          return;
        }
        setOpen(false);
      });

      /* ---------------------------------------------------------------
         Tapping a title in the drop-down never leaves the page: fetch
         that collection, slide the current cards out to the left, and
         slide the new ones in from the right -- in place, on "/".
         --------------------------------------------------------------- */
      var currentUrl = location.pathname + location.search;

      /* Shared by the tap itself and the finger-down prefetch below, so a
         fetch started on touch-down is the same one the tap then awaits. */
      var htmlCache = {};
      function fetchHtml(url) {
        var hit = htmlCache[url];
        if (hit && Date.now() - hit.t < 120000) return hit.p;
        var p = fetch(url, { credentials: 'same-origin' }).then(function (res) {
          if (!res.ok) throw new Error('mdr: bad response');
          return res.text();
        });
        htmlCache[url] = { p: p, t: Date.now() };
        p.catch(function () { delete htmlCache[url]; });
        return p;
      }

      /* PC: fetch every category the moment the pointer reaches the WEBRACK
         row (or WEBRACK opens), so a category tap swaps from memory instead
         of waiting on the network. Phones keep loading on finger-down only. */
      var warmedAll = false;
      var canWarmAll = !!(window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches);
      function warmAll() {
        if (warmedAll || !canWarmAll) return;
        warmedAll = true;
        var links = list.querySelectorAll('a[href]');
        for (var i = 0; i < links.length; i++) {
          var href = links[i].getAttribute('href');
          if (href && href !== currentUrl) fetchHtml(href);
        }
      }
      if (canWarmAll) wrap.addEventListener('pointerenter', warmAll, { once: true });
      window.__mdrWarmAllCategories = warmAll;

      function markCurrent(url) {
        currentMark = url;
        var links = list.querySelectorAll('a');
        for (var i = 0; i < links.length; i++) {
