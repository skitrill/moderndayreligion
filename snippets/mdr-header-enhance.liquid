          if (scope) break;
        }
        var cards = (scope || doc).querySelectorAll('product-card');
        return cards.length ? cards : null;
      }

      /* A genuinely empty collection (0 products) renders neither a grid nor
         a single product-card -- Horizon's own "No products found." block
         is the only thing on the page. That used to look identical to a
         real fetch/parse failure and fell back to a full reload, which is
         the "reloads" bug: tapping Pants & Shorts or Accessories (both
         still empty) always hard-navigated instead of swapping in place. */
      function emptyState(doc) {
        return doc.querySelector('.main-collection-grid__empty');
      }

      function switchCollection(url, fromPopstate) {
        if (window.__mdrSwitching) return;
        var sec = D.querySelector('[id$="__product_list_fa6P9H"]');
        var frame = sec && sec.querySelector('.mdr-scrollfade');
        var grid = sec && findGrid(sec);
        if (!frame || !grid) { location.href = url; return; }

        if (url === currentUrl) return;

        window.__mdrSwitching = true;
        /* stays open and the tapped title highlights right away (instead
           of closing the instant it's tapped) -- the grid swaps in place
           behind it, so the pill you just picked is still visibly "on"
           while its products land */
        markCurrent(url);

