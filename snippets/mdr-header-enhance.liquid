          if (gestureAxis) return gestureAxis;
          gestureSumX += Math.abs(d.x);
          gestureSumY += Math.abs(d.y);
          if (Math.max(gestureSumX, gestureSumY) >= 4) {
            /* on the open rack, only a clearly vertical gesture is the page's */
            var yRatio = bar.classList.contains('is-open') ? VERTICAL_RATIO : 1;
            gestureAxis = gestureSumY > gestureSumX * yRatio ? 'y' : 'x';
          }
          return gestureAxis; /* null while still undecided */
        }

        /* wrap the target BEFORE assigning it: the browser clamps a negative
           scrollLeft to 0 on assignment, so checking "< 0" afterwards never
           fired and scrolling backwards stopped dead at the start instead
           of looping round */
        function scrollListBy(dx) {
          if (!dx || !bar.classList.contains('is-open')) return;
          var next = list.scrollLeft + dx;
          if (loopWidth > 0) next = ((next % loopWidth) + loopWidth) % loopWidth;
          list.scrollLeft = next;
        }

        /* A trackpad swipe is one gesture made of many small deltas (plus,
           on a Mac, a momentum tail); a mouse wheel is a few notches. The
           rack follows them 1:1 and is settled ONCE per gesture: when the
           stream goes quiet (70ms), or -- after a real flick -- as soon as
           its momentum is clearly dying, at which point the rest of that
           tail is swallowed so the settle isn't fought. A fresh push takes
           back over at once. */
        var wv = 0;          /* smoothed wheel speed, px/ms */
        var wLastT = 0;
        var wPeak = 0;       /* largest delta in this gesture */
        var wStartT = 0;
        var wTravel = 0;
        var wDir = 0;
        var wTimer = null;
        var wTaken = false;  /* settled early; swallowing this gesture's tail */
        var wTakenLast = 0;
        var wTakenAbs = 0;

        function wheelSettle(v, intent) {
          clearTimeout(wTimer);
          wTimer = null;
          settleFrom(v, intent);
        }

        /* a mouse-wheel click (a line-mode delta, or a big lone delta that
           starts a gesture -- trackpad gestures always begin with small
           ones) steps exactly one title; quick clicks add up */
        var wStepTo = null;
        function nearFrame(x, ref) {
          if (!(loopWidth > 0)) return x;
          while (x - ref > loopWidth / 2) x -= loopWidth;
          while (ref - x > loopWidth / 2) x += loopWidth;
          return x;
        }

        function wheelFollow(dx, ts, lineMode) {
          var abs = Math.abs(dx);
          var notch = lineMode || (abs >= 50 && (ts - wLastT > 160 || wStepTo !== null));
          if (notch && dx) {
            var from = list.scrollLeft;
            var base = wStepTo !== null && momentumRAF ? nearFrame(wStepTo, from) : from;
            wStepTo = pickDetent(base, (dx > 0 ? 1 : -1) * 0.001, true);
            wLastT = ts;
            wTaken = false;
            clearTimeout(wTimer);
            settle(from, wStepTo, 0);
            return;
          }
          wStepTo = null;
          if (wTaken) {
            var fresh = ts - wTakenLast > 160 || abs > Math.max(6, wTakenAbs * 1.6);
            wTakenLast = ts;
            wTakenAbs = abs;
            if (!fresh) return;
            wTaken = false;
          }
          if (ts - wLastT > 160) { wPeak = 0; wStartT = ts; wTravel = 0; wv = 0; }
          stopMomentum();
          scrollListBy(dx);
          var dt = ts - wLastT;
          wv = dt > 0 && dt < 100 ? wv * 0.6 + (dx / dt) * 0.4 : dx / 16;
          wLastT = ts;
          wPeak = Math.max(wPeak, abs);
          wTravel += dx;
          if (dx) wDir = dx > 0 ? 1 : -1;
          clearTimeout(wTimer);
          /* a real flick whose momentum is fading: take over now */
          if (wPeak >= 20 && ts - wStartT > 80 && abs < wPeak * 0.35 && abs < 8) {
            wTaken = true;
            wTakenLast = ts;
            wTakenAbs = abs;
            wheelSettle(wv, true);
            return;
          }
          /* otherwise settle once the stream stops -- the direction of a
             deliberate move is kept, a tiny drift just settles to nearest */
          wTimer = setTimeout(function () {
            wheelSettle(Math.abs(wTravel) > 12 ? wDir * 0.2 : 0, Math.abs(wTravel) > 12);
          }, 70);
        }

        /* the whole row (WEBRACK label included, not only the list area):
           sideways scrolls the open list 1:1 with the fingers and is always
           cancelled, so it can never become Back/Forward; vertical is left
           to the page. The first few pixels of a gesture, before its
           direction is known, are held and handed to whichever side wins. */
        wrap.addEventListener('wheel', function (e) {
          var d = wheelDelta(e);
          var axis = wheelAxis(e, d);
          if (axis === null) {
            e.preventDefault();
            pendingX += d.x;
            pendingY += d.y;
            return;
          }
          if (axis === 'y') {
            if (pendingY) window.scrollBy({ top: pendingY, behavior: 'instant' });
            pendingX = 0;
            pendingY = 0;
            return;
          }
          e.preventDefault();
          wheelFollow(d.x + pendingX, e.timeStamp || performance.now(), e.deltaMode === 1);
          pendingX = 0;
          pendingY = 0;
        }, { passive: false });

        /* keyboard: with a title focused, Left/Right step one resting point */
        list.addEventListener('keydown', function (e) {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          if (!bar.classList.contains('is-open')) return;
          e.preventDefault();
          var pos = list.scrollLeft;
          var dir = e.key === 'ArrowRight' ? 1 : -1;
          var to = pickDetent(pos, dir * 0.001, true);
          settle(pos, to, 0);
          /* focus the title that will rest there (the first set's copy of it) */
          var at = loopWidth > 0 ? ((to % loopWidth) + loopWidth) % loopWidth : to;
          var links = list.querySelectorAll('a');
          for (var i = 0; i < snaps.length && i < links.length; i++) {
            if (Math.abs(snaps[i] - at) < 1) { links[i].focus({ preventScroll: true }); break; }
          }
        });

        /* While WEBRACK is open on PC, a sideways trackpad swipe anywhere else
           on the page has nothing to scroll -- cancel it so it can't page the
           browser back/forward out from under the open list. Vertical is
           never touched. */
        if (window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
          window.addEventListener('wheel', function (e) {
            if (!bar.classList.contains('is-open')) return;
            if (e.target instanceof Node && wrap.contains(e.target)) return;
            var d = wheelDelta(e);
            var axis = wheelAxis(e, d) || (Math.abs(d.x) > Math.abs(d.y) ? 'x' : 'y');
            if (axis !== 'x') return;
            e.preventDefault();
          }, { passive: false });
        }
      })();

      /* back/forward after an in-place switch: safest correct behaviour is
         a real reload of whatever URL is now in the bar */
      window.addEventListener('popstate', function () {
        if (window.__mdrSwitching) return;
        /* entries created by the in-page product navigation are restored by
           that script (mdr-instant-nav), not by a reload */
        if (history.state && history.state.mdrSwap) return;
        if (location.pathname + location.search !== currentUrl) location.reload();
      });

      /* Leaving the page open a long time (backgrounding the tab, switching
         apps mid-tap) can freeze it into the browser's back/forward cache
         with a fetch still in flight -- that fetch's .then/.catch never
         gets to run to clear window.__mdrSwitching, so it comes back from
         bfcache stuck permanently true and every tap on a title silently
         no-ops forever after (switchCollection's very first line bails
         whenever it's set). pageshow's persisted flag is exactly "restored
         from bfcache, not a fresh load" -- clear it there, and resync
         currentUrl too in case the freeze landed mid-switch. This is the
         "open/close messes up after sitting on a page a while" bug. */
      window.addEventListener('pageshow', function (e) {
        if (!e.persisted) return;
        window.__mdrSwitching = false;
        currentUrl = location.pathname + location.search;
      });
    }

    /* for the in-page navigation (mdr-instant-nav) to build the right row
       -- WEBRACK or RETURN -- for the page it has just swapped in */
    window.__mdrAllbarBuild = build;

    if (D.readyState !== 'loading') build();
    D.addEventListener('DOMContentLoaded', build);
    window.addEventListener('load', build);
    /* Only re-check the header's own section (not the whole document body --
       that fired build()'s early-return check on EVERY mutation anywhere on
       the page: every swipe-animation class toggle, cart-drawer open, quantity
       change, product-grid swap... a constant, needless tax on every tap,
       which is very likely what read as general WEBRACK "lag". The wrap is
       inserted as a sibling of <header>, so watching header's own parent
       section is exactly as correct and vastly cheaper. */
    if (window.MutationObserver) {
      var watchRoot = (D.querySelector('header.shopify-section-group-header-group') ||
        D.querySelector('header'));
      watchRoot = (watchRoot && watchRoot.parentNode) || D.body;
      /* Not `build` directly -- a mutation inside watchRoot (the header's
         own settling, right after this script tag runs) can fire while the
         parser is still mid-document, well before <main> and its grid
         section exist yet. build()'s own "already built" guard then locks
         in whatever isHome that premature run computed (false, since the
         grid didn't exist yet) forever -- this was making every page
         permanently show RETURN, home page included. Gating on readyState
         here, same as the other two trigger sites below, keeps every first
         real build() call until the document (and therefore the grid, if
         this page has one) is actually fully parsed. */
      new MutationObserver(function () {
        if (D.readyState !== 'loading') build();
      }).observe(watchRoot, { childList: true, subtree: true });
    }
  })();

  /* =====================================================================
     Wrap the ALL product grid so a dark-brown edge glow can sit on top of
     the cards (an inset shadow on the grid renders behind them).
     ===================================================================== */
  (function () {
    if (window.__mdrScrollFade) return;
    window.__mdrScrollFade = true;
    var D = document;

    function build() {
      var sec = D.querySelector('[id$="__product_list_fa6P9H"]');
      if (!sec) return;
      var grid = sec.querySelector('.resource-list--grid') ||
        sec.querySelector('.resource-list');
      if (!grid) return;
      if (grid.parentElement &&
          grid.parentElement.classList.contains('mdr-scrollfade')) return;
      var frame = D.createElement('div');
      frame.className = 'mdr-scrollfade';
      grid.parentElement.insertBefore(frame, grid);
      frame.appendChild(grid);
    }

    if (D.readyState !== 'loading') build();
    D.addEventListener('DOMContentLoaded', build);
    window.addEventListener('load', build);
    var m = D.querySelector('main') || D.body;
    if (window.MutationObserver) {
      new MutationObserver(build).observe(m, { childList: true, subtree: true });
    }
  })();

  /* =====================================================================
     "More payment options" -- stretched to the FULL width of the unified
     quantity/ADD TO CART/Buy-with-Shop bar, not just the Buy-with-Shop
     column it lives in. CSS alone can't do this: the link sits several
     levels inside .shopify-payment-button (a `position:relative` ancestor
     needed for its own colour-overlay ::before/::after), so an
     absolutely-positioned child of it is confined to ITS width, not the
     whole bar's -- a plain `width:100%` or negative margin can't reach
     past that ancestor boundary. Measuring both rects directly and
     setting left/width in real pixels sidesteps it. The Shop Pay wallet
     button is a lazy-loaded web component, so this can't just run once
     at load -- a MutationObserver on its container catches the link
     whenever that component actually finishes rendering it in.
     ===================================================================== */
  (function () {
    if (window.__mdrMoreOptions) return;
    window.__mdrMoreOptions = true;
    var D = document;

    function sync() {
      var GAP_ABOVE = 8;
      var GAP_BELOW = 16;
      /* CSS zoom (the page's default [+/- page] mode, body.style.zoom)
         scales EVERY CSS px unit in its scope, and getBoundingClientRect /
         offsetHeight both report already-zoomed (visual) pixel values.
         Feeding one of those numbers straight into an inline style like
         `left: Npx` sets an AUTHORED value inside that same zoomed
         context, which the browser then zooms AGAIN on render -- e.g. at
         zoom 1.1, a measured 335px bar was coming out styled as
         `width:335px` but rendering at 335*1.1 = 368px, visibly wider
         than the real bar (and mis-positioned to match). Dividing every
         zoomed measurement by the zoom factor before writing it back
         cancels that out -- the browser's own re-zoom lands it back on
         the real value. Only needed for MEASURED numbers, not the GAP_*
         constants above -- those are meant to scale with zoom like any
         other authored px value on the page. */
      var zoomFactor = parseFloat(D.body.style.zoom) || 1;
      var bars = D.querySelectorAll('.product-form-buttons, .product-form__buttons');
      for (var i = 0; i < bars.length; i++) {
        var bar = bars[i];
        var link = bar.querySelector('.shopify-payment-button__more-options, [class*="more-options"]');
        if (!link) continue;
        var anchor = link.offsetParent;
        if (!anchor) continue;
        var barRect = bar.getBoundingClientRect();
        var anchorRect = anchor.getBoundingClientRect();
        link.style.position = 'absolute';
        link.style.top = 'calc(100% + ' + GAP_ABOVE + 'px)';
        link.style.left = ((barRect.left - anchorRect.left) / zoomFactor) + 'px';
        link.style.width = (barRect.width / zoomFactor) + 'px';
        /* position:absolute takes the link out of normal document flow,
           so nothing after it in the page reserves room for it -- the
           next thing in flow (the footer, once "Recommended" was removed
           below this) rendered right where the BAR's own flow ends,
           overlapping/crowding the link hanging below. margin-bottom on
           the bar itself pushes that flow down by exactly the link's own
           height plus both gaps, closing that overlap and leaving real
           breathing room on both sides of the link. */
        bar.style.marginBottom = (GAP_ABOVE + (link.offsetHeight / zoomFactor) + GAP_BELOW) + 'px';
      }
    }

    /* attaches an observer to any bar found that doesn't have one yet --
       called from sync() itself too, not just at startup, so a bar that
       doesn't exist until later (or whose Buy-with-Shop wallet component
       hasn't rendered its content yet) still gets covered whenever it
       finally shows up */
    function watch() {
      if (!window.MutationObserver) return;
      var bars = D.querySelectorAll('.product-form-buttons, .product-form__buttons');
      for (var i = 0; i < bars.length; i++) {
        if (bars[i].__mdrMoreOptionsWatched) continue;
        bars[i].__mdrMoreOptionsWatched = true;
        new MutationObserver(sync).observe(bars[i], { childList: true, subtree: true });
      }
    }

    if (D.readyState !== 'loading') { sync(); watch(); }
    D.addEventListener('DOMContentLoaded', function () { sync(); watch(); });
    window.addEventListener('load', function () { sync(); watch(); });
    window.addEventListener('resize', sync, { passive: true });

    if (window.MutationObserver) {
      var m = D.querySelector('main') || D.body;
      new MutationObserver(watch).observe(m, { childList: true, subtree: true });
    }
  })();

  /* =====================================================================
     Quantity/limit error text (.product-form-text__error, e.g. "This item
     has a maximum of X, Y already in your cart") floats above the button
     bar via absolute positioning (see mdr-custom.css) rather than
     sharing the bar's own flex row -- reserves nothing in flow by
     itself, so margin-top on the bar makes real room for it whenever it
     actually shows, using the same "measure it, reserve the space"
     approach as the more-payment-options fix above.
     ===================================================================== */
  (function () {
    if (window.__mdrFormError) return;
    window.__mdrFormError = true;
    var D = document;

    function sync() {
      /* same zoom double-scaling concern as the more-payment-options fix
         above: offsetHeight is already a zoomed (visual) measurement, and
         writing it straight into an inline style inside that same zoomed
         context would get it re-scaled a second time on render. */
      var zoomFactor = parseFloat(D.body.style.zoom) || 1;
      var errors = D.querySelectorAll('.product-form-buttons .product-form-text__error, .product-form__buttons .product-form-text__error');
      for (var i = 0; i < errors.length; i++) {
        var err = errors[i];
        var bar = err.closest('.product-form-buttons, .product-form__buttons');
        if (!bar) continue;
        if (err.classList.contains('hidden') || !err.textContent.trim()) {
          bar.style.marginTop = '';
          continue;
        }
        bar.style.marginTop = ((err.offsetHeight / zoomFactor) + 8) + 'px';
      }
    }

    function watch() {
      if (!window.MutationObserver) return;
      var bars = D.querySelectorAll('.product-form-buttons, .product-form__buttons');
      for (var i = 0; i < bars.length; i++) {
        if (bars[i].__mdrFormErrorWatched) continue;
        bars[i].__mdrFormErrorWatched = true;
        new MutationObserver(sync).observe(bars[i], {
          attributes: true,
          attributeFilter: ['class'],
          subtree: true,
          childList: true,
          characterData: true
        });
      }
    }

    if (D.readyState !== 'loading') { sync(); watch(); }
    D.addEventListener('DOMContentLoaded', function () { sync(); watch(); });
    window.addEventListener('load', function () { sync(); watch(); });
    window.addEventListener('resize', sync, { passive: true });

    if (window.MutationObserver) {
      var m2 = D.querySelector('main') || D.body;
      new MutationObserver(watch).observe(m2, { childList: true, subtree: true });
    }
  })();

  /* Homepage grid load-in is a single, plain CSS animation now (one slide-
     up for the whole grid, not a per-card staggered cascade) -- see
     mdr-custom.css. No JS needed: a CSS animation on the grid element
     just plays on its own first paint. */

  /* =====================================================================
     WEBRACK grid full-bleed edge-to-edge fix -- .mdr-scrollfade
     (mdr-custom.css) needs overflow-x: hidden for the swipe animation,
     which clips a plain vw-based full-bleed trick under some viewport/
     zoom combinations. getBoundingClientRect reports true rendered
     coordinates regardless, so this measures the real gap on either side
     and corrects it directly as an inline style. Previously also had to
     divide by the page's own CSS-zoom factor (a [+/- page] size toggle
     that used to live on this page, since removed) -- zoomFactor is now
     always 1, kept only so this still behaves correctly if body ever
     carries a legitimate CSS zoom again for some other reason. */
  (function () {
    if (window.__mdrScrollfadeBleed) return;
    window.__mdrScrollfadeBleed = true;
    var D = document;

    function fixScrollfadeBleed() {
      var el = D.querySelector("[id$='__product_list_fa6P9H'] .mdr-scrollfade");
      if (!el) return;
      /* Desktop now deliberately insets the grid inside a large page
         border (mdr-custom.css, main { padding-inline: 30% }) instead of
         running it edge-to-edge -- this full-bleed correction is a
         mobile-only fix (the WEBRACK swipe animation's clipping issue is
         a narrow-viewport concern), so it has to bail out above that
         breakpoint or it just measures the new deliberate gap and
         cancels it back out with a negative margin, exactly like the
         clipping bug it was written to fix. */
      if (window.innerWidth >= 750) {
        el.style.marginLeft = '';
        el.style.marginRight = '';
        el.style.width = '';
        return;
      }
      var zoomFactor = parseFloat(D.body.style.zoom) || 1;
      el.style.marginLeft = '';
      el.style.marginRight = '';
      el.style.width = '';
      var rect = el.getBoundingClientRect();
      var leftGap = rect.left;
      var rightGap = D.documentElement.clientWidth - rect.right;
      if (leftGap <= 0 && rightGap <= 0) return;
      el.style.width = ((rect.width + leftGap + rightGap) / zoomFactor) + 'px';
      el.style.marginLeft = (-leftGap / zoomFactor) + 'px';
      el.style.marginRight = (-rightGap / zoomFactor) + 'px';
    }

    if (D.readyState !== 'loading') fixScrollfadeBleed();
    D.addEventListener('DOMContentLoaded', fixScrollfadeBleed);
    window.addEventListener('load', fixScrollfadeBleed);
    window.addEventListener('resize', fixScrollfadeBleed, { passive: true });
  })();

  /* =====================================================================
     Cart delete-icon colour -- a genuine rendering quirk, not a CSS
     specificity problem: the icon's <path stroke="currentColor"> resolves
     against a colour Chromium supplies for SVG children of a native
     <button> that inherits color-scheme: dark (set globally on body,
     intentionally, for Safari's own overscroll chrome) -- and that
     resolution turns out to be locked in against the STATIC stylesheet
     cascade specifically; the exact same `color` declaration applied as a
     live style MUTATION instead (not a parsed stylesheet rule) reliably
     fixes it, confirmed directly: setting color on the button, or on its
     <svg>, both visibly changed THEIR OWN computed color and did nothing
     for the icon; setting it on the <path> itself via a stylesheet rule
     also did nothing; only setting it on the <path> via a live JS style
     mutation actually repaints the stroke. mdr-custom.css still carries
     the equivalent static rule for any browser that doesn't have this
     quirk -- this is the runtime fix for the ones that do.
     Cart rows re-render in place (quantity edits, item removal) rather
     than a full page reload, so a MutationObserver re-applies this to any
     row swapped in later, not just whatever was present at first load --
     watching document.body (not .cart-items itself): confirmed live that
     a remove-item AJAX update replaces .cart-items wholesale with a new
     element, not just its children, which silently orphans an observer
     that was attached to the OLD reference (it keeps watching a detached
     node no longer connected to anything, and never fires again) -- the
     icon went back to invisible after the very first removal in testing.
     body is never itself replaced, so this survives any number of cart
     updates; subtree:true still catches the swap wherever it happens
     underneath it. */
  (function () {
    if (window.__mdrCartRemoveColor) return;
    window.__mdrCartRemoveColor = true;
    var D = document;

    function fix() {
      var paths = D.querySelectorAll('.cart-items__remove path');
      for (var i = 0; i < paths.length; i++) {
        paths[i].style.setProperty('color', 'var(--mdr-text-gray, #858581)', 'important');
      }
    }

    fix();
    D.addEventListener('DOMContentLoaded', fix);
    window.addEventListener('load', fix);

    if (window.MutationObserver) {
      new MutationObserver(fix).observe(D.body, { childList: true, subtree: true });
    }
  })();

  /* The page-adaptive overscroll/edge-colour system that used to live
     here (reading the header/footer's own background and pushing it live
     into --mdr-edge-top/--mdr-edge-bottom/--mdr-edge-color as you
     scrolled, so the rubber-band glow and safe-area strips tinted red or
     cream depending on the page) has been removed on purpose: multiple
     colour systems (this JS, plus the primary-colour CSS variable,
     mdr-custom.css) fighting over the same properties was exactly the
     inconsistency being complained about. Those three custom properties
     are now fixed, static, colourless values set once in mdr-custom.css
     (:root) -- identical on every page and at both edges, nothing left
     here to detect or switch on scroll. */
</script>
