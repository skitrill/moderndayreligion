{%- doc -%}
  MDR header / scroll enhancements (custom, non-Horizon).

  - [bottom]: a tiny text control under the cart in the header bar. Scrolls to the
    last product on the page with a snappy "windy" easing.
  - [top]: a tiny fixed control pinned to the bottom-right of the viewport that
    fades in on scroll. Scrolls back to the first product / top of the page.
    Built in JS and appended to <body> so it stays viewport-fixed.

  Styles live in assets/mdr-custom.css (loaded from <head>). This snippet is
  rendered once from the `actions` capture in sections/header.liquid.
{%- enddoc -%}

{%- comment -%} The [v] jump-to-bottom control under the cart has been removed. {%- endcomment -%}

{%- comment -%} Collection titles for the [ALL >] bar (read by __mdrAllBar). {%- endcomment -%}
<script type="application/json" id="mdr-allbar-data">
[
{%- assign _mdr_n = 0 -%}
{%- for collection in collections limit: 24 -%}
  {%- assign _h = collection.handle -%}
  {%- unless _h == 'all' or _h == 'frontpage' -%}
    {%- if _mdr_n > 0 -%},{%- endif -%}
    {"t": {{ collection.title | json }}, "u": {{ collection.url | json }}}
    {%- assign _mdr_n = _mdr_n | plus: 1 -%}
  {%- endunless -%}
{%- endfor -%}
]
</script>

<script>
  (function () {
    if (window.__mdrHeaderEnhance) return;
    window.__mdrHeaderEnhance = true;

    var D = document;
    var topBtn = null;
    var REDUCE = window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var glideRAF = null;
    var glideDetach = null;

    function scrollTop() {
      return window.scrollY || window.pageYOffset || D.documentElement.scrollTop || 0;
    }

    function maxScroll() {
      return Math.max(0, D.documentElement.scrollHeight - window.innerHeight);
    }

    /* Smooth + wavy: an ease-in-out S-curve with a gentle spring settle at the
       end -- fluid to watch, still lands quickly. */
    function easeWavy(p) {
      if (p >= 1) return 1;
      /* easeInOutCubic base -- soft start, soft stop */
      var base = p < 0.5
        ? 4 * p * p * p
        : 1 - Math.pow(-2 * p + 2, 3) / 2;
      /* one low, fast-decaying ripple over the travel -> the "wave" */
      var wave = Math.sin(p * Math.PI * 3) * 0.045 * (1 - p) * (1 - p);
      return base + wave;
    }

    /* Windy + snappy: eased travel you can see, bailing out the moment the
       user grabs the page back with a wheel / swipe / nav key. */
    function glideScroll(targetY, btn) {
      targetY = Math.max(0, Math.min(targetY, maxScroll()));
      var startY = scrollTop();
      var dist = targetY - startY;

      if (glideRAF) { cancelAnimationFrame(glideRAF); glideRAF = null; }
      if (glideDetach) glideDetach();

      if (REDUCE || Math.abs(dist) < 2) {
        window.scrollTo(0, targetY);
        zap(btn);
        return;
      }

      D.documentElement.style.scrollBehavior = 'auto';
      var dur = Math.max(560, Math.min(1150, 360 + Math.abs(dist) * 0.2));
      var t0 = null;
      var stopped = false;

      function detach() {
        window.removeEventListener('wheel', bail);
        window.removeEventListener('touchstart', bail);
        window.removeEventListener('keydown', onKey);
        glideDetach = null;
      }
      function bail() {
        stopped = true;
        if (glideRAF) { cancelAnimationFrame(glideRAF); glideRAF = null; }
        detach();
      }
      function onKey(e) {
        if (/^(Arrow|Page)/.test(e.key) || e.key === 'Home' ||
            e.key === 'End' || e.key === ' ') {
          bail();
        }
      }
      window.addEventListener('wheel', bail, { passive: true });
      window.addEventListener('touchstart', bail, { passive: true });
      window.addEventListener('keydown', onKey);
      glideDetach = detach;

      function step(now) {
        if (stopped) return;
        if (t0 === null) t0 = now;
        var p = Math.min(1, (now - t0) / dur);
        window.scrollTo(0, Math.round(startY + dist * easeWavy(p)));
        if (p < 1) {
          glideRAF = requestAnimationFrame(step);
        } else {
          glideRAF = null;
          detach();
          zap(btn);
        }
      }
      glideRAF = requestAnimationFrame(step);
    }

    function headerOffset() {
      var raw = getComputedStyle(D.body).getPropertyValue('--header-height').trim();
      var n = parseFloat(raw);
      return (isNaN(n) ? 60 : n) + 10;
    }

    function productCards() {
      return Array.prototype.slice.call(D.querySelectorAll('product-card, .product-card'));
    }

    function zap(el) {
      if (!el) return;
      el.classList.remove('mdr-zap');
      void el.offsetWidth;
      el.classList.add('mdr-zap');
    }

    function goTop() {
      var now = scrollTop();
      var first = productCards()[0];
      var y = first ? first.getBoundingClientRect().top + now - headerOffset() : 0;
      /* never jump downward -- fall back to the very top */
      if (y >= now - 2) y = 0;
      glideScroll(y, topBtn);
    }

    /* Build the fixed [top] control and pin it to <body> */
    function ensureTopButton() {
      if (topBtn && topBtn.isConnected && topBtn.parentNode === D.body) return;
      topBtn = D.querySelector('.mdr-scrolltop');
      if (!topBtn) {
        topBtn = D.createElement('button');
        topBtn.type = 'button';
        topBtn.className = 'mdr-scrolltop';
        topBtn.setAttribute('aria-label', 'Jump to top');
        topBtn.innerHTML =
          '<span class="mdr-bracket">[</span>' +
          '<svg class="mdr-arrow" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true" focusable="false">' +
          '<path d="M1 6.5 6 1.5l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>' +
          '</svg><span class="mdr-bracket">]</span>';
        topBtn.addEventListener('click', function (e) {
          e.preventDefault();
          goTop();
        });
      }
      if (topBtn.parentNode !== D.body) D.body.appendChild(topBtn);
    }

    function updateVisibility() {
      var y = scrollTop();
      var maxY = maxScroll();
      var atBottom = maxY > 40 && y >= maxY - 4;
      if (topBtn) topBtn.classList.toggle('mdr-visible', y > 80 || atBottom);
    }

    function init() {
      ensureTopButton();
      updateVisibility();
    }

    /* Catch scrolling regardless of which node emits the event */
    window.addEventListener('scroll', updateVisibility, { passive: true });
    D.addEventListener('scroll', updateVisibility, { passive: true, capture: true });
    window.addEventListener('resize', updateVisibility, { passive: true });

    if (D.readyState !== 'loading') init();
    D.addEventListener('DOMContentLoaded', init);
    window.addEventListener('load', init);

    /* Re-wire / re-pin after Horizon section hydration swaps header DOM */
    var hc = D.querySelector('#header-component');
    if (hc && window.MutationObserver) {
      new MutationObserver(init).observe(hc, { childList: true, subtree: true });
    }
  })();

  /* =====================================================================
     Header / WEBRACK glass state: flat black (no tint, no blur) by
     default -- matching <meta name="theme-color"> exactly so it blends
     into the iPhone status bar with zero seam -- and only switches to
     the translucent blurred glass look once the page has actually
     scrolled. Toggles one class (.mdr-scrolled on <html>); the CSS swap
     itself lives in mdr-custom.css as --mdr-glass-tint/--mdr-glass-blur,
     so header and WEBRACK change together, not two separate switches.
     ===================================================================== */
  (function () {
    if (window.__mdrScrollGlass) return;
    window.__mdrScrollGlass = true;
    var D = document;
    var html = D.documentElement;
    var on = null;

    function sync() {
      var y = window.scrollY || window.pageYOffset || D.documentElement.scrollTop || 0;
      var should = y > 0;
      if (should !== on) {
        html.classList.toggle('mdr-scrolled', should);
        on = should;
      }
    }

    sync();
    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('load', sync);
  })();

  /* =====================================================================
     Homepage grid: a fixed 2-col (mobile) / 4-col (desktop) layout, always
     -- the old dense/zoom-toggle-by-tapping-the-logo feature is gone. This
     just keeps the "pad the grid with inert clones so it looks full"
     behaviour, since the store only has a few real products right now.
     ===================================================================== */
  (function () {
    if (window.__mdrGridPad) return;
    window.__mdrGridPad = true;

    var D = document;

    function featured() {
      return D.querySelector('[id$="__product_list_fa6P9H"]');
    }

    /* TEMP: only a few products -- clone the tiles so the grid looks full
       while we test. Clones are inert + tagged [data-mdr-clone]; delete
       this function + its calls when done.
       Desktop (>=750px) opts out entirely: with only 4 real products,
       padding to 24 meant every row of the wide 4-column desktop grid
       was just the same 4 products repeating on a loop as you scrolled
       down the page -- much more obvious there than on mobile's narrower
       2-column layout, and reads as a bug rather than "a full grid". */
    function padFill() {
      var sec = featured();
      if (!sec) return;
      var grid = sec.querySelector('.resource-list--grid') || sec.querySelector('.resource-list');
      if (!grid) return;

      var clones = grid.querySelectorAll('[data-mdr-clone]');
      for (var c = clones.length - 1; c >= 0; c--) clones[c].remove();

      if (window.innerWidth >= 750) return;

      var originals = [];
      var kids = grid.children;
      for (var k = 0; k < kids.length; k++) {
        if (!kids[k].hasAttribute('data-mdr-clone')) originals.push(kids[k]);
      }
      if (!originals.length) return;

      var need = 24 - originals.length;
      if (need <= 0) return;

      var frag = D.createDocumentFragment();
      for (var i = 0; i < need; i++) {
        var node = originals[i % originals.length].cloneNode(true);
        node.setAttribute('data-mdr-clone', '');
        node.style.pointerEvents = 'none';
        var pc = node.querySelector('product-card');
        if (pc) {
          pc.removeAttribute('on:click');
          pc.removeAttribute('id');
        }
        var links = node.querySelectorAll('a');
        for (var l = 0; l < links.length; l++) links[l].removeAttribute('href');
        frag.appendChild(node);
      }
      grid.appendChild(frag);
    }

    function boot() { padFill(); }

    boot();
    if (D.readyState !== 'loading') boot();
    D.addEventListener('DOMContentLoaded', boot);
    window.addEventListener('load', boot);
  })();

  /* =====================================================================
     The old "ALL / TOPS / LOOKBOOK" strip above the grid is gone -- strip
     any stale copy the theme cached and never rebuild it.
     ===================================================================== */
  (function () {
    if (window.__mdrHomeNav) return;
    window.__mdrHomeNav = true;
    var D = document;
    function strip() {
      var n = D.querySelectorAll('.mdr-home-nav');
      for (var i = 0; i < n.length; i++) n[i].remove();
    }
    strip();
    D.addEventListener('DOMContentLoaded', strip);
    window.addEventListener('load', strip);
    var m = D.querySelector('main') || D.body;
    if (window.MutationObserver) {
      new MutationObserver(strip).observe(m, { childList: true });
    }
  })();

  /* =====================================================================
     WEBRACK » bar: a small collapsed pill in the header, right next to the
     logo. Tap it and it slides open into the list of collection titles;
     tap again -- or tap anywhere outside -- to collapse it.
     ===================================================================== */
  (function () {
    if (window.__mdrAllBar) return;
    window.__mdrAllBar = true;
    var D = document;

    function collections() {
      var el = D.getElementById('mdr-allbar-data');
      if (!el) return [];
      try { return JSON.parse(el.textContent) || []; } catch (e) { return []; }
    }

    function build() {
      if (D.querySelector('.mdr-allbar-wrap')) return;
      /* mount right under the site header so it shows on EVERY page, sitting
         under the logo (a full-width line aligned to the page gutter) */
      var header = D.querySelector('header.shopify-section-group-header-group') ||
        (D.querySelector('#header-component') &&
          D.querySelector('#header-component').closest('header')) ||
        D.querySelector('header');
      if (!header || !header.parentNode) return;

      var data = collections();
      /* "Home" here means the product grid page, not "/" -- "/" is now the
         no-header landing screen (sections/mdr-landing.liquid), so it never
         reaches this code at all. The grid is wherever
         [id$='__product_list_fa6P9H'] actually renders (templates/
         collection.json, the "All" collection) -- checking for that
         directly is also more robust than a hardcoded path if that ever
         moves again. */
      var isHome = !!D.querySelector("[id$='__product_list_fa6P9H']");

      var wrap = D.createElement('div');
      wrap.className = 'mdr-allbar-wrap';

      var bar = D.createElement('div');
      bar.className = 'mdr-allbar' + (isHome ? '' : ' mdr-allbar--back');

      var toggle = D.createElement('button');
      toggle.type = 'button';
      toggle.className = 'mdr-allbar__toggle';
      toggle.setAttribute('aria-expanded', 'false');
      /* No separate chevron element at all any more -- "remove the
         existing chevron icons completely... do not use text characters
         such as >>, <<, ›, <, SVG icon libraries, or a separate chevron
         element." Just the word itself; the arrow is drawn as part of
         .mdr-allbar__line below, sharing one continuous stroke with the
         connecting rule instead of sitting beside it as its own icon. */
      toggle.innerHTML = isHome
        ? '<span class="mdr-allbar__label">Webrack</span>'
        : '<span class="mdr-allbar__label">Return</span>';

      var list = D.createElement('div');
      list.className = 'mdr-allbar__list';
      /* endless scroll: once past one full set's width, silently snap back
         by that same width -- pixel-identical, so it reads as the last
         title pulling the first one back into view rather than a jump.
         Declared here (build()'s own scope) so both the wheel handler and
         the drag handler below can read/adjust it via closure. */
      var loopWidth = 0;
      var realCount = 0;

      function appendCopy() {
        for (var j = 0; j < realItems.length; j++) {
          var b = D.createElement('a');
          b.href = realItems[j].u;
          b.textContent = realItems[j].t;
          b.setAttribute('aria-hidden', 'true');
          b.tabIndex = -1;
          list.appendChild(b);
        }
      }

      /* With only ONE duplicate (2 copies total), a short list on a wide
         viewport could reach its native max-scroll (scrollWidth -
         clientWidth) before ever reaching the wrap threshold (one set's
         width) -- the browser silently clamps scrollLeft there and it can
         never climb any further, "freezing" all scrolling (including
         momentum) well short of the loop point. Keep adding copies until
         there's comfortably more native scroll room than one set is wide,
         so the threshold is always reachable regardless of catalog size
         or viewport width. */
      function measureLoop() {
        if (realCount <= 1) { loopWidth = 0; return; }
        /* list.clientWidth reads as 0 here -- this runs while WEBRACK is
           still closed (flex:0 0 0), so it never reflects what the list's
           width will actually be once opened. wrap.clientWidth (the full
           bar's own row, always laid out regardless of open/closed) is a
           safe upper-bound stand-in: the list can never end up wider than
           the whole wrap once open, so sizing against it is a worst-case
           estimate that still guarantees enough copies. */
        var guard = 0;
        var copies = list.children.length / realCount;
        var maxPossibleWidth = wrap.clientWidth;
        while (list.scrollWidth - maxPossibleWidth < list.scrollWidth / copies && guard < 8) {
          appendCopy();
          copies = list.children.length / realCount;
          guard++;
        }
        loopWidth = list.scrollWidth / copies;
      }

      if (isHome) {
        /* points at "/" itself, not /collections/all -- with the logo no
           longer doubling as a home button on this page (see
           blocks/_header-logo.liquid), All is the way back to the true,
           unfiltered homepage grid after switching to another title
           in-place. The u!=='/' guard just below already excludes '/'
           from the auto aria-current match (every path starts with "/"),
           so this doesn't make it wrongly read as "current" everywhere. */
        var items = [{ t: 'All', u: '/' }].concat(data);
        var realItems = [];
        for (var i = 0; i < items.length; i++) {
          if (!items[i] || !items[i].u) continue;
          var a = D.createElement('a');
          a.href = items[i].u;
          a.textContent = items[i].t;
          if (items[i].u !== '/' && location.pathname.indexOf(items[i].u) === 0) {
            a.setAttribute('aria-current', 'page');
          }
          list.appendChild(a);
          realItems.push(items[i]);
        }
        realCount = realItems.length;
        /* one duplicate to start -- measureLoop below adds more if this
           viewport needs them */
        appendCopy();
        measureLoop();
        window.addEventListener('resize', measureLoop, { passive: true });
        window.addEventListener('load', measureLoop);
      }

      bar.appendChild(toggle);
      bar.appendChild(list);
      wrap.appendChild(bar);

      /* The line-as-icon redesign: WEBRACK/RETURN's arrow is no longer a
         separate glyph, SVG icon, or CSS-clipped shape sitting beside the
         connecting rule -- it's cut directly into the SAME stroke as the
         rule itself, one <path>, so there is no seam where "line" ends
         and "icon" begins to ever misalign in the first place. One <svg>
         per bar, appended as a sibling of the toggle/list (not inside
         them) so it can span the full row width independent of the
         button's own box. */
      var SVG_NS = 'http://www.w3.org/2000/svg';
      var lineSvg = D.createElementNS(SVG_NS, 'svg');
      lineSvg.setAttribute('class', 'mdr-allbar__line');
      lineSvg.setAttribute('aria-hidden', 'true');
      lineSvg.setAttribute('focusable', 'false');
      var linePath = D.createElementNS(SVG_NS, 'path');
      linePath.setAttribute('class', 'mdr-allbar__line-path');
      lineSvg.appendChild(linePath);
      wrap.appendChild(lineSvg);

      /* sit it directly below the header, on every page */
      header.parentNode.insertBefore(wrap, header.nextSibling);

      /* Builds the line+chevron as ONE path, drawn directly in the wrap's
         own real pixel coordinate space (svg width/height/viewBox all set
         to the wrap's exact measured size, no scaling transform anywhere)
         so the diagonal wings render at a true, undistorted angle at any
         viewport width -- "alignment cannot break at different viewport
         widths" ruled out an approach where a fixed viewBox gets stretched
         to fit, since non-uniform stretching would skew the diagonals
         differently per width.
         The path is two subpaths sharing one exact coordinate (the
         vertex): [one wing tip -> vertex -> the line's far end] as one
         unbroken 2-segment stroke (this covers the ENTIRE horizontal
         line, since the vertex is a literal midpoint of that same L
         command, not a separate piece measured afterward -- "the
         horizontal section must enter the exact mathematical center of
         the chevron point" and "zero gap between the chevron tip and
         line" are both true by construction), then a single moveto to
         draw the second wing (vertex -> the other wing tip). A perfect
         zero-lift trace isn't geometrically possible for a 3-way junction (the
         vertex has three strokes meeting at it -- horizontal, upper wing,
         lower wing -- which no single continuous line can visit without
         doubling back), but rendered pixels are identical either way:
         same stroke-width/colour/cap the whole way, both subpaths meeting
         at one exact shared point, so nothing visibly "joins" -- it reads
         as one continuous wire because, pixel for pixel, it is one.
         Desktop bails out (0-size svg, empty path): .mdr-allbar-wrap is
         width:max-content there (a compact pill beside the logo, see
         mdr-custom.css) -- no row-spanning line to draw, matching every
         earlier pass's own mobile-only scope for this same element. */
      function buildLinePath() {
        if (window.innerWidth >= 750) {
          lineSvg.setAttribute('width', 0);
          lineSvg.setAttribute('height', 0);
          linePath.setAttribute('d', '');
          return;
        }
        var label = toggle.querySelector('.mdr-allbar__label');
        if (!label) return;
        var wrapRect = wrap.getBoundingClientRect();
        var toggleRect = toggle.getBoundingClientRect();
        var labelRect = label.getBoundingClientRect();
        var w = wrapRect.width;
        var h = wrapRect.height;
        if (!w || !h) return;
        lineSvg.setAttribute('width', w);
        lineSvg.setAttribute('height', h);
        lineSvg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);

        /* toggle's own vertical center, not the label's -- .mdr-allbar__
           toggle is align-items:center, so this is exactly where the
           label visually sits regardless of its own line-height box. */
        var midY = (toggleRect.top + toggleRect.height / 2) - wrapRect.top;
        var gap = 7; // label-to-stroke gap, matches the old label/chevron rhythm
        var wingDx = 5; // subtle -- "very minimal, not a conventional thick arrow"
        var wingDy = 4;
        var edgeInset = 2; // keeps the vertex just short of the true row edge

        var d;
        if (isHome) {
          /* WEBRACK: reversed from the first version of this -- the
             chevron now sits immediately after the label, THEN the line
             runs on to the right edge ("WEBRACK >>────", not
             "WEBRACK────>>"). wingBackX is the chevron's own open/back
             side (right after the label); vertexX is its tip, one wingDx
             further right. The MAIN stroke is [upper wing tip -> vertex
             -> right edge] as one unbroken run -- the line doesn't just
             start "near" the vertex, it's the literal continuation of the
             same L command the vertex is defined by, so "zero gap between
             chevron tip and line" is true by construction. Path starts
             (t=0) at the label end and ends (t=len) at the right edge, on
             purpose: the open/close erase (CSS stroke-dashoffset) always
             clears from a path's own t=0 toward t=len, so starting at the
             label makes the wipe travel left -> right, chevron-first --
             "as though >> is pulling the line open". */
          var wingBackX = (labelRect.right - wrapRect.left) + gap;
          var vertexX = wingBackX + wingDx;
          var lineEndX = Math.max(vertexX, w - edgeInset);
          d = 'M ' + wingBackX + ' ' + (midY - wingDy) +
            ' L ' + vertexX + ' ' + midY +
            ' L ' + lineEndX + ' ' + midY +
            ' M ' + vertexX + ' ' + midY +
            ' L ' + wingBackX + ' ' + (midY + wingDy);
        } else {
          /* RETURN: mirrored -- chevron sits immediately BEFORE the label
             (label is right-aligned, so this is the label's own left
             edge), tip pointing left, line running on from the tip to the
             row's left edge ("────< RETURN"). Path again starts (t=0) at
             the label end, same as WEBRACK, so the erase direction is
             controlled by the SAME rule (always label -> outward) while
             the geometry itself points the opposite way -- the net result
             is a right -> left wipe here, mirroring WEBRACK's left ->
             right one, "motion travels right -> left when returning". */
          var wingBackX2 = (labelRect.left - wrapRect.left) - gap;
          var vertexX2 = wingBackX2 - wingDx;
          var lineStartX = Math.min(vertexX2, edgeInset);
          d = 'M ' + wingBackX2 + ' ' + (midY - wingDy) +
            ' L ' + vertexX2 + ' ' + midY +
            ' L ' + lineStartX + ' ' + midY +
            ' M ' + vertexX2 + ' ' + midY +
            ' L ' + wingBackX2 + ' ' + (midY + wingDy);
        }
        linePath.setAttribute('d', d);

        /* dash length only -- NOT dashoffset (that stays purely CSS-
           class-driven, see .mdr-allbar-wrap--zap / .is-open in
           mdr-custom.css) -- setting offset here as an inline style would
           permanently out-specificity those class rules and the open/
           close transition would never fire again. */
        var len = linePath.getTotalLength();
        wrap.style.setProperty('--mdr-line-len', len);
        linePath.style.strokeDasharray = len + ' ' + len;
      }

      buildLinePath();
      window.addEventListener('resize', buildLinePath, { passive: true });
      window.addEventListener('load', buildLinePath);

      /* line its label up under the logo, at every breakpoint (the header
         centres its own content on desktop, so a fixed gutter won't do) */
      /* the button now starts flush at the true left edge (CSS:
         .mdr-allbar-wrap padding-inline-start: 0) instead of lined up
         under the logo, so there's no JS alignment needed here any more */

      /* The diagonal used to be a separate 1px line rotated with a CSS
         transform, positioned via a JS-measured custom property. Rotating
         a hairline like that doesn't anti-alias cleanly -- it reads as a
         slightly fuzzy, uneven-width stroke next to the crisp horizontal/
         vertical borders, which is the "not uniform... overflow" look.
         Replaced entirely: the diagonal is now cut directly into the
         button's own shape with clip-path (see CSS), the same technique
         a solid vector tool uses for a ribbon/flag tail -- one clean
         outline, no separate rotated element, and no JS measurement
         needed at all since the cut is always relative to the button's
         own current box. */

      /* A body-position:fixed page-lock here was expensive (forces a full
         reflow the instant WEBRACK opens -- the mobile lag/freeze) and
         locked the WHOLE page, not just this bar. Dropped entirely: the
         touchzone's own `touch-action: pan-x` (see CSS) already keeps a
         drag on the titles from also scrolling the page, for free, scoped
         to just that gesture -- no page-wide lock needed or wanted. */
      /* "Zap" is the line+chevron's own open/close state -- a fast (see
