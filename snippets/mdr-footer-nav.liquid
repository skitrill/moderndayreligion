{%- doc -%}
  MDR custom nav (replaces the stock main-menu links in the footer, and also
  rendered standalone on the homepage landing section, sections/mdr-landing.liquid):
  WEBRACK -> the product grid, now at the "All" collection (templates/
  collection.json -- "/" is the landing page, not the grid, and this avoids
  needing a manually-created admin Page the way the other three links
  below do), LOOKBOOK -> /pages/lookbook, MAILING -> a slim drop-down box
  with a newsletter sign-up, THE MODERN TIMES -> its page, ACCOUNT ->
  routes.account_url (moved here from the header's own CART/USER drawer --
  that drawer was carrying two links stacked on each other with barely any
  room to breathe; account only needs to exist SOMEWHERE reachable, not
  specifically in the masthead, so it lives here now, next to the site's
  other secondary destinations, on both the footer and this same snippet's
  landing-page render).
  The stock .footer-content .menu is hidden in mdr-custom.css.

  @param {string} [variant] - optional modifier, added as `mdr-fnav--{{ variant }}`
    on the <nav> so a caller (e.g. the landing section) can lay it out
    differently from the footer's default row.
  @param {boolean} [hide_shop] - leave out WEBRACK and LOOKBOOK (the lock screen,
    layout/password.liquid, where the shop is closed).
  @param {string} [account_label] - the account link's text when nobody is signed in
    (default "User" -- MODERN DAY RELIGION says User, never Account).
  @param {boolean} [account_first] - put the account link at the top of the list
    instead of after THE MODERN TIMES (the lock screen).
  @param {boolean} [show_cart] - add CART right after the account link, with the
    masthead's "(n)" count when the cart has items (the lock screen).
  @param {string} [extra_items] - markup added as one more list item between ACCOUNT
    and MAILING (the lock screen's policy links).
  @param {boolean} [mailing_open] - MAILING is just its sign-up form, always showing:
    no "Mailing" label, nothing to open (the lock screen).
{%- enddoc -%}

{% assign mailing_drop_id = 'mdr-mailing-drop-' | append: section.id %}

{%- capture account_item -%}
  <li>
    <a href="{{ routes.account_url }}">
      {%- if customer -%}
        {{- customer.first_name -}}
      {%- else -%}
        {{- account_label | default: 'User' -}}
      {%- endif -%}
    </a>
  </li>
  {%- if show_cart -%}
    <li>
      <a href="{{ routes.cart_url }}">
        Cart
        {%- if cart.item_count > 0 %} ({{ cart.item_count }}){% endif -%}
      </a>
    </li>
  {%- endif -%}
{%- endcapture -%}

<nav class="mdr-fnav{% if variant %} mdr-fnav--{{ variant }}{% endif %}" aria-label="Footer">
  <ul>
    {%- if account_first -%}
      {{ account_item }}
    {%- endif -%}
    {%- unless hide_shop -%}
      <li><a href="{{ routes.all_products_collection_url }}">Webrack</a></li>
      <li><a href="/pages/lookbook">Lookbook</a></li>
    {%- endunless -%}
    <li><a href="{{ pages['the-modern-times'].url | default: '/pages/the-modern-times' }}">The Modern Times</a></li>
    {%- unless account_first -%}
      {{ account_item }}
    {%- endunless -%}
    {%- if extra_items != blank -%}
      <li class="mdr-fnav__extra">{{ extra_items }}</li>
    {%- endif -%}
    <li class="mdr-fnav__mailing">
      {%- unless mailing_open -%}
        <button
          type="button"
          class="mdr-fnav__toggle"
          aria-expanded="false"
          aria-controls="{{ mailing_drop_id }}"
        >
          Mailing
        </button>
      {%- endunless -%}
      <div id="{{ mailing_drop_id }}" class="mdr-fnav__drop"{% unless mailing_open %} hidden{% endunless %}>
        {%- form 'customer', class: 'mdr-fnav__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="mdr-fnav__msg">You're on the list.</p>
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input
              type="email"
              name="contact[email]"
              class="mdr-fnav__email"
              placeholder="EMAIL"
              autocomplete="email"
              aria-label="Email"
              required
            >
            <button type="submit" class="mdr-fnav__submit">Join</button>
          {%- endif -%}
        {%- endform -%}
      </div>
      {%- if form.errors -%}
        <p class="mdr-fnav__msg mdr-fnav__msg--err">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    </li>
  </ul>
</nav>

<script>
  (function () {
    /* This snippet can render more than once on a page now (footer nav +
       the homepage landing nav) -- each .mdr-fnav__mailing wires up its own
       toggle/dropdown pair via DOM traversal, not a global ID lookup, so
       two instances on the same page don't fight over each other. */
    document.querySelectorAll('.mdr-fnav__mailing').forEach(function (wrap) {
      if (wrap.__mdrWired) return;
      wrap.__mdrWired = true;
      var t = wrap.querySelector('.mdr-fnav__toggle');
      var d = wrap.querySelector('.mdr-fnav__drop');
      if (!t || !d) return;

      function set(open) {
        t.setAttribute('aria-expanded', String(open));
        d.hidden = !open;
      }

      t.addEventListener('click', function () {
        set(t.getAttribute('aria-expanded') !== 'true');
      });

      document.addEventListener('click', function (e) {
        if (!wrap.contains(e.target)) set(false);
      });

      /* re-open after a submit round-trip */
      if (location.search.indexOf('customer_posted') > -1 || wrap.querySelector('.mdr-fnav__msg')) {
        set(true);
      }
    });
  })();
</script>
