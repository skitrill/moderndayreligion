{%- doc -%}
  Styles for the password layout: main content, password dialog, and email-signup
  used in the dialog. Rendered from layout/password.liquid (layouts cannot use the
  stylesheet tag directly).
{%- enddoc -%}

{%- comment -%}
  Same custom typeface as the rest of the site (assets/mdr-custom.css) --
  that file isn't loaded on this layout at all (layout/password.liquid
  renders its own 'stylesheets' snippet, not theme.liquid's), so without
  this the lock screen was falling back to the theme's stock font instead
  of matching every other page.

  A plain <style> tag, NOT inside the {% stylesheet %} block below: that
  block compiles into the theme's shared compiled_assets/styles.css
  bundle, and { 'pgf-qualta-regular.otf' | asset_url } inside it was
  silently resolving to nothing there -- the @font-face rule still made
  it into the compiled CSS, but with no src: url(...) at all, so the font
  never actually loaded and every "PGF Qualta" reference was quietly
  falling back to Anonymous Pro instead (confirmed via document.fonts on
  the live page -- no PGF Qualta entry at all, just Anonymous Pro).
  Liquid in a plain <style> tag is just normal template rendering, so the
  asset_url filter resolves correctly here.
{%- endcomment -%}
<style>
  @font-face {
    font-family: 'PGF Qualta';
    src: url('{{ 'pgf-qualta-regular.otf' | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
</style>

{% stylesheet %}
  /* :root, not html -- color-palette.liquid sets these same variables on
     :root too, and :root (a pseudo-class, specificity 0,1,0) beats a plain
     html type selector (0,0,1) regardless of source order, which is why
     this didn't take effect against it the first time. */
  :root {
    --font-body--family: 'PGF Qualta', 'Anonymous Pro', monospace;
    --font-subheading--family: 'PGF Qualta', 'Anonymous Pro', monospace;
    --font-heading--family: 'PGF Qualta', 'Anonymous Pro', monospace;
    --font-accent--family: 'PGF Qualta', 'Anonymous Pro', monospace;
  }

  /* Same treatment as the unlocked homepage's landing screen
     (sections/mdr-landing.liquid): one static red screen, no scroll --
     this layout has no .page-wrapper (that's theme.liquid only), so it's
     set directly on html/body here instead. Red, not black, to match the
     homepage landing screen's own background (mdr-custom.css) and the
     header/footer red used everywhere else on the site.

     Scoped with :has(.password-main-content) -- NOT a bare "html, body"
     selector. This snippet's {% stylesheet %} block gets compiled into
     the theme's ONE shared compiled_assets/styles.css bundle along with
     every other section/snippet's styles, regardless of which layout
     actually renders it -- so an unscoped rule here was applying
     site-wide, on every ordinary page too (theme.liquid, not just
     layout/password.liquid), which is what broke scrolling everywhere.
     .password-main-content only exists in the password layout, so this
     reaches only that page. */
  html:has(.password-main-content),
  body:has(.password-main-content) {
    height: 100%;
    overflow: hidden;
    /* the site's one primary UI colour (mdr-custom.css's --mdr-primary) --
       this layout doesn't load that stylesheet at all (see the top of
       this file), so it can't reference the variable; kept as its own
       literal value in step with it instead. Color experiment: was
       #8B0000 (dark red), now #040061 (deep blue). */
    background-color: #040061;
    color-scheme: dark;
  }

  /* Top/bottom safe-area strips -- same colour as this page's own
     background above (--mdr-primary blue): this is a permanently blue,
     single-surface page (like the homepage), so its safe-area strips and
     rubber-band canvas should match it exactly, the same principle
     assets/mdr-custom.css applies per-template via --mdr-edge-top/
     --mdr-edge-bottom/--mdr-edge-color -- this layout doesn't load that
     stylesheet, so it can't reference those variables, duplicated here
     as the same literal value instead. Flat, fixed, not colour-adaptive. */
  body:has(.password-main-content)::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: env(safe-area-inset-top, 0px);
    background: #040061;
    z-index: 2147483001;
    pointer-events: none;
  }

  body:has(.password-main-content)::after {
    content: '';
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: env(safe-area-inset-bottom, 0px);
    background: #040061;
    z-index: 2147483001;
    pointer-events: none;
  }

  .password-main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* true full-viewport height so the centered logo (+ Mailing, directly
       under it, see .password-footer below) sits at the exact middle of
       the page on any device. */
    min-height: 100dvh;
  }

  /* Mailing, now a normal-flow second child of .password-main-content
     (layout/password.liquid), right under the logo -- was pinned to the
     bottom of the whole page, on its own, unrelated to the logo visually.
     A small margin-top is the only thing connecting them now instead of
     that distance; the actual policy-links footer (mdr-lock-footer,
     below) is what's still pinned to the true bottom of the screen. */
  .password-footer {
    margin-top: 20px;
  }

  /* .section-password (sections/password.liquid) has flex-grow: 1 --
     correct when it was .password-main-content's ONLY child (it needed
     to fill the whole flex column itself for the logo to land in the
     true centre), but now that Mailing is a second child of that same
     flex column, flex-grow: 1 on just the logo greedily claimed ALL the
     leftover space for itself, squeezing Mailing down into whatever was
     left over -- which put it hard against the very bottom of the
     screen, overlapping the policy-links footer, instead of sitting
     just under the logo. Neutralising it here lets both children size to
     their own natural content height, so .password-main-content's own
     justify-content: center centres the LOGO+MAILING GROUP together,
     which is the actual "connected" look being aimed for. */
  .section-password {
    flex-grow: 0;
  }

  /* Policy links -- takes over the true bottom-of-screen spot Mailing
     used to occupy, out of normal flow so it doesn't compete with (or
     get pushed around by) the centered logo + Mailing group above it. */
  .mdr-lock-footer {
    position: fixed;
    left: 0;
    right: 0;
    bottom: max(16px, env(safe-area-inset-bottom, 16px));
    padding-inline: 16px;
    z-index: 5;
  }

  .password-dialog {
    max-width: 100vw;
    max-height: 100svh;
    width: 100vw;
    height: 100svh;
    border: none;
    transition: opacity var(--animation-values), display var(--animation-speed) allow-discrete,
      overlay var(--animation-speed) allow-discrete;

    &::backdrop {
      display: none;
    }
  }

  .password-dialog[open] {
    opacity: 1;
    top: 0;
    left: 0;
  }

  @starting-style {
    .password-dialog[open] {
      opacity: 0;
    }
  }

  .password-dialog:not([open]) {
    opacity: 0;
  }

  @starting-style {
    .password-dialog:not([open]) {
      opacity: 1;
    }
  }

  .password-dialog__close-button {
    cursor: pointer;
  }

  .password-dialog__header {
    position: absolute;
    top: 0;
    right: 0;
    padding: var(--padding-lg);
    z-index: var(--layer-raised);
  }

  .password-dialog__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: var(--padding-lg);
    height: 100%;
    transition: transform var(--animation-values);
  }

  .password-dialog__content .email-signup__message {
    padding-block-start: var(--padding-xl);
  }

  .password-dialog[open] .password-dialog__content {
    transform: translateY(0);
  }

  @starting-style {
    .password-dialog[open] .password-dialog__content {
      transform: translateY(1em);
    }
  }

  .password-dialog:not([open]) .password-dialog__content {
    transform: translateY(1em);
  }

  @starting-style {
    .password-dialog:not([open]) .password-dialog__content {
      transform: translateY(0);
    }
  }

  .storefront-password-form {
    max-width: 400px;
    width: 100%;
  }

  .email-signup__input-group,
  .password-dialog__submit-button {
    width: 100%;

    @media screen and (min-width: 750px) {
      width: auto;
    }
  }
{% endstylesheet %}
