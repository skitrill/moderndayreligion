{%- doc -%}
  Styles for the password layout: main content, password dialog, and email-signup
  used in the dialog. Rendered from layout/password.liquid (layouts cannot use the
  stylesheet tag directly).
{%- enddoc -%}

{% stylesheet %}
  /* Same custom typeface as the rest of the site (assets/mdr-custom.css) --
     that file isn't loaded on this layout at all (layout/password.liquid
     renders its own 'stylesheets' snippet, not theme.liquid's), so without
     this the lock screen was falling back to the theme's stock font
     instead of matching every other page. */
  @font-face {
    font-family: 'PGF Qualta';
    src: url('{{ 'pgf-qualta-regular.otf' | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* :root, not html -- color-palette.liquid sets these same variables on
     :root too, and :root (a pseudo-class, specificity 0,1,0) beats a plain
     html type selector (0,0,1) regardless of source order, which is why
     this didn't take effect against it the first time. */
  :root {
    --font-body--family: 'PGF Qualta', 'Anonymous Pro', monospace;
    --font-subheading--family: 'PGF Qualta', 'Anonymous Pro', monospace;
    --font-heading--family: 'PGF Qualta', 'Anonymous Pro', monospace;
    --font-accent--family: 'PGF Qualta', 'Anonymous Pro', monospace;
  }

  /* Same treatment as the unlocked homepage's landing screen
     (sections/mdr-landing.liquid): one static black screen, no scroll --
     this layout has no .page-wrapper (that's theme.liquid only), so it's
     set directly on html/body here instead. */
  html,
  body {
    height: 100%;
    overflow: hidden;
    background-color: #000000;
  }

  .password-main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* true full-viewport height so the centered logo sits at the exact
       middle of the page on any device, instead of the middle of
       whatever space is left above the footer */
    min-height: 100dvh;
  }

  /* taken out of normal flow so it doesn't eat into that height --
     pinned to the bottom of the page instead */
  .password-footer {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
  }

  .password-dialog {
    max-width: 100vw;
    max-height: 100svh;
    width: 100vw;
    height: 100svh;
    border: none;
    transition: opacity var(--animation-values), display var(--animation-speed) allow-discrete,
      overlay var(--animation-speed) allow-discrete;

    &::backdrop {
      display: none;
    }
  }

  .password-dialog[open] {
    opacity: 1;
    top: 0;
    left: 0;
  }

  @starting-style {
    .password-dialog[open] {
      opacity: 0;
    }
  }

  .password-dialog:not([open]) {
    opacity: 0;
  }

  @starting-style {
    .password-dialog:not([open]) {
      opacity: 1;
    }
  }

  .password-dialog__close-button {
    cursor: pointer;
  }

  .password-dialog__header {
    position: absolute;
    top: 0;
    right: 0;
    padding: var(--padding-lg);
    z-index: var(--layer-raised);
  }

  .password-dialog__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: var(--padding-lg);
    height: 100%;
    transition: transform var(--animation-values);
  }

  .password-dialog__content .email-signup__message {
    padding-block-start: var(--padding-xl);
  }

  .password-dialog[open] .password-dialog__content {
    transform: translateY(0);
  }

  @starting-style {
    .password-dialog[open] .password-dialog__content {
      transform: translateY(1em);
    }
  }

  .password-dialog:not([open]) .password-dialog__content {
    transform: translateY(1em);
  }

  @starting-style {
    .password-dialog:not([open]) .password-dialog__content {
      transform: translateY(0);
    }
  }

  .storefront-password-form {
    max-width: 400px;
    width: 100%;
  }

  .email-signup__input-group,
  .password-dialog__submit-button {
    width: 100%;

    @media screen and (min-width: 750px) {
      width: auto;
    }
  }
{% endstylesheet %}
