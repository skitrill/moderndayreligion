{%- doc -%}
  Lock screen policy links, stacked vertically under the menu -- Privacy
  Policy, Terms of Service, Refund Policy, Shipping Policy, pulled from
  shop.policies (Shopify's own
  Settings > Policies), not hardcoded. shop.policies only ever contains
  the policies the store has actually published, so anything not set up
  in admin is simply absent here rather than a broken link.
{%- enddoc -%}

{% if shop.policies.size > 0 %}
  <ul class="mdr-lock-policies">
    {%- for policy in shop.policies -%}
      {%- if policy != blank -%}
        <li>
          <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{% endif %}

{% stylesheet %}
  /* Same size, tracking, gap and colour as the menu items around them
     (.mdr-fnav--landing in assets/mdr-custom.css). */
  .mdr-lock-policies {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .mdr-lock-policies a {
    font-family: var(--font-accent--family, inherit);
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(247, 240, 228, 0.75);
  }
{% endstylesheet %}
