{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
{%- comment -%}
  iOS zooms the page in when a text field smaller than 16px gets focus (the
  cart quantity, discount code, mailing, search) and leaves it zoomed --
  the page then looks cropped and slid sideways, and the in-page navigation
  carries the zoom to the next page. maximum-scale=1 stops that auto-zoom;
  iOS ignores it for the user's own pinch-zoom, so zooming stays available.
  iOS only: on Android maximum-scale would really block pinch-zoom.
{%- endcomment -%}
<script>
  (function () {
    var n = navigator;
    if (!/iP(hone|od|ad)/.test(n.platform) && !(n.platform === 'MacIntel' && n.maxTouchPoints > 1)) return;
    var m = document.querySelector('meta[name="viewport"]');
    if (m) m.setAttribute('content', m.getAttribute('content') + ',maximum-scale=1');
  })();
</script>
{%- liquid
  assign mdr_landing = false
  if request.page_type == 'index' or request.page_type == 'password'
    assign mdr_landing = true
  endif
-%}
{%- comment -%}
  THE colour source for the whole site -- assets/mdr-custom.css only
  derives from these (it defines none of them itself). In <head>, ahead of
  every stylesheet, so the very first frame of every page is already right.

  --mdr-surface         the canvas (Palace's #f5f5f5)
  --mdr-interface-*     the shell's material -- masthead, WEBRACK rail,
                        footer: a graphite-tinted glass (colour, alpha, blur)
  --mdr-interface-glass that material as the translucent fill the shell uses
  --mdr-interface-solid what that glass looks like over the canvas, for the
                        places that can only take a solid colour: the canvas
                        beyond the page (overscroll at the top and bottom,
                        under the browser's bars) and the browser's own top
                        strip (theme-color, set from it below) -- so the top
                        and bottom edges of the screen are always exactly the
                        masthead / footer colour, whatever that becomes.
  The landing / lock screen is graphite end to end.
{%- endcomment -%}
<style>
  :root {
    --mdr-surface: #f5f5f5;
    --mdr-surface-rgb: 245 245 245;
    --mdr-graphite: #858581;
    --mdr-landing-bg: #171717;
    --mdr-interface-color: color-mix(in srgb, var(--mdr-surface), var(--mdr-graphite) 22%);
    --mdr-interface-alpha: 55%;
    --mdr-interface-blur: blur(10px) saturate(1.2);
    --mdr-interface-glass: color-mix(in srgb, var(--mdr-interface-color) var(--mdr-interface-alpha), transparent);
    --mdr-interface-solid: color-mix(in srgb, var(--mdr-interface-color) var(--mdr-interface-alpha), var(--mdr-surface));
  }
  html { background-color: var(--mdr-interface-solid); color-scheme: light; }
  body { background-color: var(--mdr-surface); }
  {%- if mdr_landing %}
  html, body { background-color: var(--mdr-landing-bg); }
  html { color-scheme: dark; }
  {%- endif %}
</style>
<meta name="theme-color" content="{% if mdr_landing %}#171717{% endif %}">
<script>
  /* the browser's top strip takes a plain colour: give it the resolved
     shell colour (html's background above), so it is never a second value.
     window.__mdrSyncChrome() re-reads it if the shell colour ever changes. */
  (function () {
    function sync() {
      var meta = document.querySelector('meta[name="theme-color"]');
      var ctx = document.createElement('canvas').getContext('2d');
      if (!meta || !ctx) return;
      ctx.fillStyle = getComputedStyle(document.documentElement).backgroundColor;
      ctx.fillRect(0, 0, 1, 1);
      var d = ctx.getImageData(0, 0, 1, 1).data;
      meta.setAttribute('content', '#' + [d[0], d[1], d[2]].map(function (v) { return v.toString(16).padStart(2, '0'); }).join(''));
    }
    window.__mdrSyncChrome = sync;
    sync();
  })();
</script>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if page_description %}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{% endif %}
